---
import PageLayout from '../layouts/PageLayout.astro';
import DirectContact from '../components/DirectContact.astro';
import { loadCollectionsPageContent } from '../lib/collections-content';
import { loadDirectContact } from '../lib/direct-contact';
import { type Lang, localizePath } from '../lib/i18n';

type AnyRecord = Record<string, any>;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const directContact = await loadDirectContact(lang);
const data = await loadCollectionsPageContent(lang);
const fields = data.fields;

const pageTitle = data.title || fields.hero_title || 'Collections';
const pageSeoTitle = data.meta?.seo_title || pageTitle;
const pageDescription = data.meta?.search_description || 'Featured Policrafters collections';
const introText = fields.intro_text || '';
const emptyStateText = fields.empty_state_text || (lang === 'es' ? 'Próximamente' : 'Coming soon');

const categories = (Array.isArray(fields.categories) ? fields.categories : []).map((category: AnyRecord) => ({
  key: category.key,
  label: category.label ?? '',
  hasProducts: Boolean(category.has_products),
  types: (Array.isArray(category.types) ? category.types : []).map((type: AnyRecord) => ({
    key: type.key,
    label: type.label ?? '',
    products: (Array.isArray(type.products) ? type.products : []).map((product: AnyRecord) => ({
      typeKey: type.key,
      slug: product.slug ?? '#',
      title: product.title ?? '',
      image: { url: product.image?.url ?? '', alt: product.image?.alt ?? '' }
    }))
  }))
}));

const defaultCategoryKey = 'shower-doors';
const showerDoorsCategory = categories.find((category: AnyRecord) => category.key === defaultCategoryKey) ?? { types: [] };
const showerDoorTypes = Array.isArray(showerDoorsCategory.types) ? showerDoorsCategory.types : [];
const showerDoorProducts = showerDoorTypes.flatMap((type: AnyRecord) => type.products.map((product: AnyRecord) => product));

const productHref = (slug: string) => (slug && slug !== '#' ? localizePath(`/collections/${slug}`, lang) : '#');
---

<PageLayout lang={lang} title={pageSeoTitle} description={pageDescription} showHero={false}>
  <section class="collections-shell">
    <h1 id="collections-title">{pageTitle}</h1>
    <p id="collections-intro" class="collections-copy">{introText}</p>

    <div class="collections-layout">
      <aside class="filters" aria-label={lang === 'es' ? 'Filtros de colecciones' : 'Collection filters'}>
        {categories.map((category: AnyRecord) => {
          const isDefault = category.key === defaultCategoryKey;
          const panelId = `filter-panel-${category.key}`;
          return (
            <div class="filter-section" data-category={category.key}>
              <button
                type="button"
                class="filter-section__toggle"
                aria-expanded={isDefault ? 'true' : 'false'}
                aria-controls={panelId}
              >{category.label}</button>

              <div id={panelId} class="filter-section__panel" hidden={!isDefault}>
                {category.hasProducts ? (
                  <ul class="filter-types">
                    {(category.types ?? []).map((type: AnyRecord) => {
                      const inputId = `filter-type-${type.key}`;
                      return (
                        <li>
                          <label class="filter-type" for={inputId}>
                            <input type="checkbox" id={inputId} class="filter-type__checkbox" data-type={type.key} />
                            <span>{type.label}</span>
                          </label>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <ul class="filter-lorem">
                    {(category.types ?? []).map((sub: AnyRecord) => (
                      <li>{sub.label}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </aside>

      <div class="gallery" aria-live="polite">
        <div class="gallery-grid" id="shower-doors-grid">
          {showerDoorProducts.map((product: AnyRecord) => (
            <a href={productHref(product.slug)} class="gallery-card" data-product-type={product.typeKey}>
              <img src={product.image?.url || ''} alt={product.image?.alt || ''} loading="lazy" decoding="async" />
              <span class="gallery-card__title">{product.title}</span>
            </a>
          ))}
        </div>

        <p class="gallery-empty" id="gallery-empty" hidden>{emptyStateText}</p>
      </div>
    </div>

    <DirectContact lang={lang} data={directContact} />
  </section>
</PageLayout>

<script define:vars={{ lang }}>
  // @ts-nocheck
  // Category/type filtering is language-independent and stays; the Wagtail
  // preview listener stays too. There is no more language-switch handling —
  // the page is single-language (route-based i18n — see src/lib/i18n.ts).
  const shell = document.querySelector('.collections-shell');

  if (shell) {
    const filtersContainer = shell.querySelector('.filters');
    const galleryGrid = shell.querySelector('#shower-doors-grid');
    const galleryEmpty = shell.querySelector('#gallery-empty');
    let sections = [];
    let cards = [];
    let checkboxes = [];
    let previewCategoryMap = new Map();

    let isWagtailPreview = false;
    let activeCategory = 'shower-doors';

    // /collections/<slug> in English, /es/collections/<slug> in Spanish — mirrors
    // src/lib/i18n.ts localizePath for the one case this script needs it.
    const productHref = (slug) => (slug && slug !== '#' ? (lang === 'es' ? `/es/collections/${slug}` : `/collections/${slug}`) : '#');

    const refreshCollectionsReferences = () => {
      sections = Array.from(shell.querySelectorAll('.filter-section'));
      cards = galleryGrid ? Array.from(galleryGrid.querySelectorAll('.gallery-card')) : [];
      checkboxes = Array.from(shell.querySelectorAll('.filter-type__checkbox'));
    };

    const normalizePreviewAssetUrl = (value) => {
      if (!value || typeof value !== 'string') return '';
      if (
        window.location.hostname === 'localhost' &&
        value.startsWith('http://localhost/media/')
      ) {
        return value.replace('http://localhost/media/', 'http://localhost:8000/media/');
      }
      return value;
    };

    const getCategoryProducts = (category) => {
      const types = Array.isArray(category?.types) ? category.types : [];
      return types.flatMap((type) => {
        const products = Array.isArray(type?.products) ? type.products : [];
        return products.map((product) => ({
          ...product,
          typeKey: type?.key || ''
        }));
      });
    };

    const renderGalleryCards = (products = []) => {
      if (!galleryGrid) return;

      galleryGrid.replaceChildren();

      products.forEach((product) => {
        const card = document.createElement('a');
        card.href = productHref(product?.slug);
        card.className = 'gallery-card';
        card.dataset.productType = product.typeKey || '';

        const image = document.createElement('img');
        image.src = normalizePreviewAssetUrl(product?.image?.url || '');
        image.alt = product?.image?.alt || '';
        image.loading = 'lazy';
        image.decoding = 'async';

        const title = document.createElement('span');
        title.className = 'gallery-card__title';
        title.textContent = product?.title || '';

        card.append(image, title);
        galleryGrid.appendChild(card);
      });

      refreshCollectionsReferences();
    };

    // Re-applies visibility for whatever is currently active/checked. Never
    // rebuilds the DOM, so checkbox state and scroll position survive a
    // category switch.
    const applyGalleryState = () => {
      const activeSection = sections.find((section) => section.dataset.category === activeCategory);
      const sectionHasProducts = activeSection
        ? activeSection.dataset.hasProducts === 'true' || Boolean(activeSection.querySelector('.filter-types'))
        : false;

      if (galleryGrid) galleryGrid.hidden = !sectionHasProducts;
      if (galleryEmpty) galleryEmpty.hidden = sectionHasProducts;

      if (!sectionHasProducts) {
        return;
      }

      const checkedTypes = checkboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.dataset.type);
      cards.forEach((card) => {
        const matches = checkedTypes.length === 0 || checkedTypes.includes(card.dataset.productType);
        card.hidden = !matches;
      });

      if (galleryEmpty) {
        const hasVisibleCards = cards.some((card) => !card.hidden);
        galleryEmpty.hidden = hasVisibleCards;
      }
    };

    // Expanding a section IS selecting it: the mockup treats "Shower Doors" as both
    // the default expanded panel and the default visible gallery. Single-open
    // accordion — expanding one section collapses the rest.
    const setActiveCategory = (categoryKey) => {
      activeCategory = categoryKey;

      if (isWagtailPreview) {
        const previewCategory = previewCategoryMap.get(categoryKey);
        renderGalleryCards(getCategoryProducts(previewCategory));
      }

      sections.forEach((section) => {
        const toggle = section.querySelector('.filter-section__toggle');
        const panel = section.querySelector('.filter-section__panel');
        const isActive = section.dataset.category === categoryKey;
        toggle?.setAttribute('aria-expanded', String(isActive));
        if (panel) panel.hidden = !isActive;
      });
      applyGalleryState();
    };

    const bindFilterInteractions = () => {
      refreshCollectionsReferences();

      sections.forEach((section) => {
        const toggle = section.querySelector('.filter-section__toggle');
        toggle?.addEventListener('click', () => setActiveCategory(section.dataset.category));
      });

      checkboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', applyGalleryState);
      });
    };

    bindFilterInteractions();

    // A product page can link back with ?category=<key> to open that section
    // (see the back button in collections/product.astro). Keys are read off the
    // rendered sections rather than hard-coded, so adding a category to the mock
    // needs no change here. Falls through to the server-rendered default (shower-doors
    // expanded, no type checked, all 14 cards visible) when the param is absent or
    // unknown, so there is no flash of different content on load in that case.
    const requestedCategory = new URLSearchParams(window.location.search).get('category');
    const knownCategories = sections.map((section) => section.dataset.category);

    if (requestedCategory && knownCategories.includes(requestedCategory)) {
      setActiveCategory(requestedCategory);
    } else {
      applyGalleryState();
    }

    const setText = (el, value) => {
      if (el && typeof value === 'string' && value.trim()) el.textContent = value;
    };

    const applyCollectionsPreview = (previewData) => {
      const fields = previewData?.fields ?? {};

      setText(shell.querySelector('#collections-title'), fields.hero_title);
      setText(shell.querySelector('#collections-intro'), fields.intro_text);
      setText(shell.querySelector('#gallery-empty'), fields.empty_state_text);

      if (typeof previewData?.meta?.seo_title === 'string' && previewData.meta.seo_title.trim()) {
        document.title = previewData.meta.seo_title;
      }

      if (typeof previewData?.meta?.search_description === 'string') {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
          metaDescription.setAttribute('content', previewData.meta.search_description);
        }
      }

      const previewCategories = Array.isArray(fields.categories) ? fields.categories : [];
      previewCategoryMap = new Map(previewCategories.map((category) => [category?.key, category]));

      if (filtersContainer && previewCategories.length > 0) {
        filtersContainer.replaceChildren();

        previewCategories.forEach((category, categoryIndex) => {
          const categoryKey = category?.key || `category-${categoryIndex}`;
          const categoryLabel = category?.label || '';
          const hasProducts = Boolean(category?.has_products);
          const panelId = `filter-panel-${categoryKey}`;

          const section = document.createElement('div');
          section.className = 'filter-section';
          section.dataset.category = categoryKey;
          section.dataset.hasProducts = hasProducts ? 'true' : 'false';

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'filter-section__toggle';
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-controls', panelId);
          toggle.textContent = categoryLabel;

          const panel = document.createElement('div');
          panel.id = panelId;
          panel.className = 'filter-section__panel';
          panel.hidden = true;

          const categoryTypes = Array.isArray(category?.types) ? category.types : [];

          if (hasProducts) {
            const typesList = document.createElement('ul');
            typesList.className = 'filter-types';

            categoryTypes.forEach((typeItem, typeIndex) => {
              const typeKey = typeItem?.key || `type-${typeIndex}`;
              const typeLabel = typeItem?.label || '';
              const inputId = `filter-type-${categoryKey}-${typeKey}`;

              const li = document.createElement('li');
              const label = document.createElement('label');
              label.className = 'filter-type';
              label.setAttribute('for', inputId);

              const input = document.createElement('input');
              input.type = 'checkbox';
              input.id = inputId;
              input.className = 'filter-type__checkbox';
              input.dataset.type = typeKey;

              const span = document.createElement('span');
              span.textContent = typeLabel;

              label.append(input, span);
              li.appendChild(label);
              typesList.appendChild(li);
            });

            panel.appendChild(typesList);
          } else {
            const textList = document.createElement('ul');
            textList.className = 'filter-lorem';

            categoryTypes.forEach((typeItem) => {
              const item = document.createElement('li');
              item.textContent = typeItem?.label || '';
              textList.appendChild(item);
            });

            panel.appendChild(textList);
          }

          section.append(toggle, panel);
          filtersContainer.appendChild(section);
        });

        bindFilterInteractions();

        const defaultCategory = previewCategories.find((category) => category?.key === 'shower-doors') || previewCategories[0];
        if (defaultCategory?.key) {
          setActiveCategory(defaultCategory.key);
        }
      }
    };

    window.addEventListener('message', (event) => {
      if (event.data?.type !== 'policrafters-preview') return;

      const previewData = event.data?.payload;
      if (!previewData || typeof previewData !== 'object') return;
      if (previewData.type !== 'collections.CollectionIndexPage') return;

      isWagtailPreview = true;
      applyCollectionsPreview(previewData);
    });
  }
</script>

<style>
  .collections-shell {
    display: grid;
    gap: 1.5rem;
  }

  .collections-shell h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: 0.02em;
  }

  .collections-copy {
    margin: 0;
    max-width: 78ch;
    color: #2f2f2f;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  /* This page needs a wider stage than the ~1100px .page-shell every other interior
     page shares (see PageLayout.astro's :root --max). Rather than override that
     shared token — which would either leak to other pages or race PageLayout's own
     CSS on load order — break out of .page-shell with the same full-bleed technique
     PageLayout's own body { overflow-x: clip } comment anticipates, then re-cap the
     content at 1440px with padding. */
  .collections-layout,
  .collections-shell > :global(.direct-contact) {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-inline: max(1.5rem, calc((100vw - 1440px) / 2));
    box-sizing: border-box;
  }

  .collections-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .filters {
    display: grid;
    border-top: 1px solid #dcdcdc;
  }

  .filter-section {
    border-bottom: 1px solid #dcdcdc;
  }

  .filter-section__toggle {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 0;
    padding: 0.9rem 0;
    font-size: 0.92rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: left;
    color: #161616;
    cursor: pointer;
  }

  .filter-section__toggle::after {
    content: '+';
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .filter-section__toggle[aria-expanded="true"]::after {
    content: '\2212';
  }

  .filter-section__panel {
    padding: 0 0 1.1rem;
  }

  .filter-types,
  .filter-lorem {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .filter-type {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: #2f2f2f;
    cursor: pointer;
  }

  .filter-type__checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: #161616;
    cursor: pointer;
  }

  .filter-lorem li {
    font-size: 0.85rem;
    color: #777;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .gallery-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .gallery-card img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
    background: #f2f2f2;
  }

  .gallery-card__title {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .gallery-empty {
    margin: 0;
    padding: 4rem 0;
    text-align: center;
    font-size: 1.1rem;
    color: #777;
  }

  @media (max-width: 980px) {
    .collections-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .collections-layout,
    .collections-shell > :global(.direct-contact) {
      padding-inline: 1.25rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
