---
import PageLayout from '../layouts/PageLayout.astro';
import { loadTermsPageContent } from '../lib/terms-content';
import type { Lang } from '../lib/i18n';

type AnyRecord = Record<string, any>;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === 'es';

const data = await loadTermsPageContent(lang);
const fields = data.fields;

const seoTitle = data.meta?.seo_title || (isEs ? 'Términos y condiciones | Policrafters' : 'Terms & Conditions | Policrafters');
const searchDescription = data.meta?.search_description || '';

const introHeading = fields.intro_heading || '';
const introBody = fields.intro_body || '';

// The number shown before each title comes from this array position, not
// from the payload.
const terms = (Array.isArray(fields.terms) ? fields.terms : []).map((item: AnyRecord) => ({
  title: item.title ?? '',
  body: item.body ?? ''
}));
---

<PageLayout lang={lang} title={seoTitle} description={searchDescription} showHero={false}>
  <section class="terms-shell">
    <!-- 1. Intro — h1 + italic lead, set off by a left vertical rule spanning
         both, same border-left recipe as services.astro's .service-row__title
         (itself borrowed from the homepage's .team-card__meta). Sits inside
         .page-shell's width, not full-bleed. -->
    <div class="terms-intro">
      <h1 class="terms-intro__heading">{introHeading}</h1>
      <p class="terms-intro__body">{introBody}</p>
    </div>

    <!-- 2. Terms grid — two columns, items in source order 1→7 so row-wise
         grid flow puts the odd numbers (1,3,5,7) in the left column and the
         even numbers (2,4,6) in the right column, matching the mockup.
         Collapses to one column at <=900px. -->
    <div class="terms-grid">
      {terms.map((term: AnyRecord, index: number) => (
        <div class="terms-item">
          <h2 class="terms-item__title">
            {`${index + 1}. `}<span>{term.title}</span>{':'}
          </h2>
          <p class="terms-item__body">{term.body}</p>
        </div>
      ))}
    </div>
  </section>
</PageLayout>

<script>
  // @ts-nocheck
  // Wagtail preview only (postMessage from the CMS admin iframe). There is no
  // more language switching to subscribe to — the page is single-language
  // (route-based i18n — see src/lib/i18n.ts).
  const shell = document.querySelector('.terms-shell');

  if (shell) {
    const scopeAttr = Array.from(shell.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'))?.name;
    const applyScope = (el) => {
      if (scopeAttr) el.setAttribute(scopeAttr, '');
      return el;
    };

    const setText = (el, value) => {
      if (el && typeof value === 'string' && value.trim()) el.textContent = value;
    };

    const applyTermsPreview = (previewData) => {
      const fields = previewData?.fields ?? {};

      setText(shell.querySelector('.terms-intro__heading'), fields.intro_heading);
      setText(shell.querySelector('.terms-intro__body'), fields.intro_body);

      if (typeof previewData?.meta?.seo_title === 'string' && previewData.meta.seo_title.trim()) {
        document.title = previewData.meta.seo_title;
      }

      if (typeof previewData?.meta?.search_description === 'string') {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
          metaDescription.setAttribute('content', previewData.meta.search_description);
        }
      }

      const termsGrid = shell.querySelector('.terms-grid');
      if (!termsGrid) return;

      const previewTerms = Array.isArray(fields.terms) ? fields.terms : [];
      termsGrid.querySelectorAll('.terms-item').forEach((item) => item.remove());

      previewTerms.forEach((term, index) => {
        const item = applyScope(document.createElement('div'));
        item.className = 'terms-item';

        const title = applyScope(document.createElement('h2'));
        title.className = 'terms-item__title';
        title.append(`${index + 1}. `);

        const titleCopy = applyScope(document.createElement('span'));
        titleCopy.textContent = typeof term?.title === 'string' ? term.title : '';
        title.appendChild(titleCopy);
        title.append(':');

        const body = applyScope(document.createElement('p'));
        body.className = 'terms-item__body';
        body.textContent = typeof term?.body === 'string' ? term.body : '';

        item.append(title, body);
        termsGrid.appendChild(item);
      });
    };

    window.addEventListener('message', (event) => {
      if (event.data?.type !== 'policrafters-preview') return;

      const previewData = event.data?.payload;
      if (!previewData || typeof previewData !== 'object') return;
      if (typeof previewData.type !== 'string' || !previewData.type.endsWith('.TermsPage')) return;

      applyTermsPreview(previewData);
    });
  }
</script>

<style>
  .terms-shell {
    display: grid;
    gap: 0;
  }

  /* Section 1: intro heading + lead, left vertical rule spans both — same
     border-left recipe as services.astro's .service-row__title. */
  .terms-intro {
    margin-bottom: 3rem;
    border-left-style: solid;
    border-left-color: #2f3437;
    border-left-width: 1px;
    padding-left: 1rem;
  }

  .terms-intro__heading {
    margin: 0 0 .75rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #111;
  }

  .terms-intro__body {
    margin: 0;
    max-width: 70ch;
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.4;
    color: #333;
  }

  /* Section 2: two columns, source order 1..7 — row-wise grid flow puts odd
     numbers left, even numbers right, matching the mockup. */
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
    row-gap: 2.5rem;
  }

  .terms-item__title {
    margin: 0 0 .6rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #111;
  }

  .terms-item__body {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.5;
    color: #333;
  }

  @media (max-width: 900px) {
    .terms-grid {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
  }
</style>
