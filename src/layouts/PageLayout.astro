---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  showHero?: boolean;
  /* Optional per-language hero copy. When supplied, both languages ship in the
     markup as data-copy-es/-en so a page script can switch the hero client-side. */
  heroTitleEs?: string;
  heroTitleEn?: string;
  heroSubtitleEs?: string;
  heroSubtitleEn?: string;
}

const {
  title = 'Policrafters',
  description = 'Policrafters',
  heroTitle = 'Policrafters',
  heroSubtitle = '',
  showHero = true,
  heroTitleEs,
  heroTitleEn,
  heroSubtitleEs,
  heroSubtitleEn,
} = Astro.props;

const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const selectedLang = langParam === 'en' || langParam === 'es' ? langParam : 'en';
---
<!doctype html>
<html lang={selectedLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={selectedLang} />

    {showHero && (
      <section class="hero-page">
        <div class="hero-page__content">
          <p class="eyebrow">Policrafters</p>
          <h1 data-copy-es={heroTitleEs} data-copy-en={heroTitleEn}>{heroTitle}</h1>
          {heroSubtitle && <p data-copy-es={heroSubtitleEs} data-copy-en={heroSubtitleEn}>{heroSubtitle}</p>}
        </div>
      </section>
    )}

    <main class="page-shell">
      <slot />
    </main>

    <Footer lang={selectedLang} />
  </body>
</html>

<style>
  :root {
    --text: #111;
    --muted: #666;
    --max: 1100px;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Arimo", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--text);
    background: #fff;
  }

  .hero-page {
    min-height: 320px;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #111, #333);
    color: #fff;
    padding: 4rem 2rem;
  }

  .hero-page__content {
    width: min(var(--max), 92%);
    margin: 0 auto;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    opacity: 0.8;
    margin: 0 0 0.5rem;
  }

  .hero-page h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
  }

  .hero-page p {
    margin: 0;
    font-size: 1rem;
    max-width: 60ch;
  }

  .page-shell {
    width: min(var(--max), 92%);
    margin: 0 auto;
    padding: 3rem 0 4rem;
  }

</style>
