---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SeoHead from '../components/SeoHead.astro';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /* Which languages this page exists in (from meta.translations) — see
     SeoHead.astro. Defaults to both. */
  availableLangs?: Lang[];
  title?: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  showHero?: boolean;
  /* Passed straight through to SeoHead.astro. */
  image?: { url: string; alt: string };
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'product';
  /* Page-specific JSON-LD nodes, passed straight through to SeoHead.astro. */
  jsonLd?: object[];
}

const {
  lang,
  availableLangs,
  title,
  description,
  heroTitle = 'Policrafters',
  heroSubtitle = '',
  showHero = true,
  image,
  noindex = false,
  ogType,
  jsonLd,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} lang={lang} availableLangs={availableLangs} image={image} noindex={noindex} type={ogType} jsonLd={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} />

    {showHero && (
      <section class="hero-page">
        <div class="hero-page__content">
          <p class="eyebrow">Policrafters</p>
          <h1>{heroTitle}</h1>
          {heroSubtitle && <p>{heroSubtitle}</p>}
        </div>
      </section>
    )}

    <main class="page-shell">
      <slot />
    </main>

    <Footer lang={lang} />

    <ScrollToTop lang={lang} />
  </body>
</html>

<style>
  :root {
    --text: #111;
    --muted: #666;
    --max: 1100px;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Arimo", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--text);
    background: #fff;
    /* Full-bleed sections use `width: 100vw`, which counts the vertical scrollbar
       while the page's content box does not — leaving them a scrollbar-width too
       wide and producing a horizontal scrollbar. Clip that overhang.
       `clip`, not `hidden`: `hidden` would create a scroll container and break
       this layout's `position: sticky` header. `clip` does not. */
    overflow-x: clip;
  }

  .hero-page {
    min-height: 320px;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #111, #333);
    color: #fff;
    padding: 4rem 2rem;
  }

  .hero-page__content {
    width: min(var(--max), 92%);
    margin: 0 auto;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    opacity: 0.8;
    margin: 0 0 0.5rem;
  }

  .hero-page h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
  }

  .hero-page p {
    margin: 0;
    font-size: 1rem;
    max-width: 60ch;
  }

  .page-shell {
    width: min(var(--max), 92%);
    margin: 0 auto;
    padding: 3rem 0 4rem;
  }

</style>
