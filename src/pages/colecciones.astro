---
import PageLayout from '../layouts/PageLayout.astro';
import collectionsPage from '../mocks/collections-page.json';

type AnyRecord = Record<string, any>;

const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const requestedLang = langParam === 'en' || langParam === 'es' ? langParam : 'es';
const useApi = import.meta.env.PUBLIC_USE_API === 'true';
const apiUrl = import.meta.env.PUBLIC_COLLECTIONS_API_URL || 'http://localhost:8000/api/collections/';
const clientApiUrl = import.meta.env.DEV ? '/wagtail-api/api/collections/' : apiUrl;
const apiOrigin = apiUrl.startsWith('http') ? new URL(apiUrl).origin : '';
let isRemoteData = false;

const normalizeAssetUrl = (value: unknown): string => {
  if (!value) return '';
  if (typeof value !== 'string') return '';
  if (/^https?:\/\//i.test(value)) return value;
  if (value.startsWith('/') && isRemoteData) {
    return apiOrigin ? `${apiOrigin}${value}` : value;
  }
  return value;
};

let data = collectionsPage;

if (useApi) {
  try {
    let localizedApiUrl = apiUrl;

    if (apiUrl.startsWith('http')) {
      const url = new URL(apiUrl);
      url.searchParams.set('locale', requestedLang);
      localizedApiUrl = url.toString();
    }

    const response = await fetch(localizedApiUrl);
    if (response.ok) {
      const payload = await response.json();
      if (payload && typeof payload === 'object') {
        data = payload;
        isRemoteData = true;
      }
    }
  } catch (error) {
    console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
  }
}

const resolvedData = data ?? collectionsPage;
const resolvedFields = (resolvedData.fields ?? collectionsPage.fields ?? {}) as AnyRecord;
const resolvedMeta = resolvedData.meta ?? collectionsPage.meta ?? {};
const fallbackFields = (collectionsPage.fields ?? {}) as AnyRecord;

const normalizeRichText = (value: unknown): string =>
  String(value ?? '')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const dataSource = data === collectionsPage ? 'mock' : 'api';
const pageTitle = resolvedFields.hero_title || resolvedData.title || collectionsPage.title || 'Collections';
const pageSubtitle = normalizeRichText(resolvedFields.hero_subtitle || fallbackFields.hero_subtitle || '');
const introText = normalizeRichText(resolvedFields.intro_text || fallbackFields.intro_text || '');
const apiItems = Array.isArray(resolvedFields.items) ? resolvedFields.items : [];
const fallbackItems = Array.isArray(fallbackFields.collection_items) ? fallbackFields.collection_items : [];
const collectionItems = (apiItems.length ? apiItems : fallbackItems) as AnyRecord[];
---

<PageLayout
  title={resolvedMeta.seo_title || 'Collections | Policrafters'}
  description={resolvedMeta.search_description || 'Colecciones destacadas de Policrafters'}
  heroTitle={pageTitle}
  heroSubtitle={pageSubtitle}
>
  <section
    class="collections-section"
    data-collections-source={dataSource}
    data-api-url={apiUrl}
    data-client-api-url={clientApiUrl}
    data-api-origin={apiOrigin}
  >
    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
      <h2 id="collections-title" style="margin:0;">{pageTitle}</h2>
    </div>
    <p id="collections-intro" class="collections-copy">{introText}</p>

    <div class="carousel-shell">
      <div class="carousel-viewport">
        <div class="carousel-controls" aria-hidden="true">
          <button id="collections-prev" class="carousel-btn carousel-btn--icon" data-action="prev" aria-label="Ver colección anterior">&lt;</button>
          <button id="collections-next" class="carousel-btn carousel-btn--icon" data-action="next" aria-label="Ver siguiente colección">&gt;</button>
        </div>

        <div class="collection-carousel" id="collection-carousel" aria-label="Carrusel de colecciones">
          {collectionItems.map((item: AnyRecord, index: number) => (
            <article class="collection-card" data-collection-index={index}>
              <img src={normalizeAssetUrl(item.image?.url)} alt={item.image?.alt || item.type} loading="lazy" />
              <div class="collection-card__body">
                <h3 class="collection-type">{item.type}</h3>
                <p class="collection-description">{item.description}</p>
                <a href={item.cta_url || '/contacto'} class="discover-btn">{item.cta_text || 'Descubre más'}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // @ts-nocheck
  const carousel = document.getElementById('collection-carousel');
  const sourcePanel = document.querySelector('.collections-section');
  const sourceMode = sourcePanel?.dataset?.collectionsSource || 'mock';
  const apiUrl = sourcePanel?.dataset?.apiUrl || '';
  const clientApiUrl = sourcePanel?.dataset?.clientApiUrl || apiUrl;
  const apiOrigin = sourcePanel?.dataset?.apiOrigin || '';
  const buttons = document.querySelectorAll('.carousel-btn');
  const titleNode = document.getElementById('collections-title');
  const introNode = document.getElementById('collections-intro');
  const heroTitleNode = document.getElementById('page-hero-title');
  const heroSubtitleNode = document.getElementById('page-hero-subtitle');
  const prevButton = document.getElementById('collections-prev');
  const nextButton = document.getElementById('collections-next');
  const initialCards = carousel ? Array.from(carousel.querySelectorAll('.collection-card')) : [];
  const baseCount = initialCards.length;
  let virtualIndex = baseCount;
  let stepSize = 0;
  let loopReady = false;
  let isAnimating = false;

  const getUiCopy = (lang) => {
    const activeLang = lang === 'en' ? 'en' : 'es';
    if (activeLang === 'en') {
      return {
        prevAria: 'View previous collection',
        nextAria: 'View next collection',
        carouselAria: 'Collections carousel'
      };
    }
    return {
      prevAria: 'Ver colección anterior',
      nextAria: 'Ver siguiente colección',
      carouselAria: 'Carrusel de colecciones'
    };
  };

  const appendLang = (href, lang) => {
    const [path, query = ''] = href.split('?');
    const params = new URLSearchParams(query);
    params.set('lang', lang);
    const queryString = params.toString();
    return queryString ? `${path}?${queryString}` : path;
  };

  const getLangFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    const lang = params.get('lang');
    return lang === 'en' || lang === 'es' ? lang : null;
  };

  const getActiveLang = () => {
    const inUrl = getLangFromUrl();
    if (inUrl) return inUrl;
    const stored = localStorage.getItem('siteLang');
    if (stored === 'en' || stored === 'es') return stored;
    return 'es';
  };

  const localeFromValue = (value) => {
    const normalized = String(value || '').toLowerCase();
    if (normalized.startsWith('en')) return 'en';
    if (normalized.startsWith('es')) return 'es';
    return null;
  };

  const getLocaleCandidates = (lang) => {
    if (lang === 'en') return ['en', 'en-us', 'en-gb'];
    return ['es', 'es-es'];
  };

  const normalizeRichText = (value) =>
    String(value || '')
      .replace(/<[^>]*>/g, '')
      .replace(/&nbsp;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  const normalizeAssetUrl = (value) => {
    if (!value) return '';
    if (/^https?:\/\//i.test(value)) return value;
    if (value.startsWith('/')) {
      return apiOrigin ? `${apiOrigin}${value}` : value;
    }
    return value;
  };

  const fetchCollectionsPayload = async (lang) => {
    const endpointBase = clientApiUrl || apiUrl;
    if (!endpointBase) return null;
    const requestedLang = lang === 'en' ? 'en' : 'es';
    const candidates = getLocaleCandidates(requestedLang);

    for (const locale of candidates) {
      try {
        const url = new URL(endpointBase, window.location.origin);
        url.searchParams.set('locale', locale);
        url.searchParams.set('lang', requestedLang);

        const response = await fetch(url.toString(), { cache: 'no-store' });
        if (!response.ok) continue;

        const payload = await response.json();
        if (!payload || typeof payload !== 'object') continue;

        const apiLocaleLang = localeFromValue(payload.locale);
        if (apiLocaleLang && apiLocaleLang !== requestedLang) {
          continue;
        }

        return payload;
      } catch (error) {
        console.warn('No se pudo cargar colecciones desde API para locale:', locale, error);
      }
    }

    return null;
  };

  const applyApiPayload = (payload, lang) => {
    const fields = payload?.fields && typeof payload.fields === 'object' ? payload.fields : {};
    const nextTitle = fields.hero_title || payload?.title || (lang === 'en' ? 'Collections' : 'Colecciones');
    const nextSubtitle = normalizeRichText(fields.hero_subtitle || '');
    const nextIntro = normalizeRichText(fields.intro_text || '');

    if (heroTitleNode) heroTitleNode.textContent = nextTitle;
    if (heroSubtitleNode && nextSubtitle) heroSubtitleNode.textContent = nextSubtitle;
    if (titleNode) titleNode.textContent = nextTitle;
    if (introNode) introNode.textContent = nextIntro;

    const apiItems = Array.isArray(fields.items) ? fields.items : [];
    if (!apiItems.length) return;

    const allCards = carousel ? Array.from(carousel.querySelectorAll('.collection-card')) : [];
    allCards.forEach((card) => {
      const cardIndex = Number.parseInt(card.getAttribute('data-collection-index') || '0', 10);
      const item = apiItems[cardIndex % apiItems.length];
      if (!item) return;

      const img = card.querySelector('img');
      const typeNode = card.querySelector('.collection-type');
      const descriptionNode = card.querySelector('.collection-description');
      const ctaNode = card.querySelector('.discover-btn');

      if (img) {
        const imageUrl = normalizeAssetUrl(item.image?.url);
        if (imageUrl) {
          img.setAttribute('src', imageUrl);
        } else {
          img.removeAttribute('src');
        }
        img.setAttribute('alt', item.image?.alt || item.type || 'Collection item');
      }

      if (typeNode) typeNode.textContent = item.type || '';
      if (descriptionNode) descriptionNode.textContent = item.description || '';
      if (ctaNode) {
        ctaNode.textContent = item.cta_text || (lang === 'en' ? 'Discover more' : 'Descubre más');
        ctaNode.setAttribute('href', appendLang(item.cta_url || '/contacto', lang));
      }
    });

    const prevLabel = lang === 'en' ? 'View previous collection' : 'Ver colección anterior';
    const nextLabel = lang === 'en' ? 'View next collection' : 'Ver siguiente colección';
    const carouselLabel = lang === 'en' ? 'Collections carousel' : 'Carrusel de colecciones';
    if (prevButton) prevButton.setAttribute('aria-label', prevLabel);
    if (nextButton) nextButton.setAttribute('aria-label', nextLabel);
    if (carousel) carousel.setAttribute('aria-label', carouselLabel);
  };

  const applyCollectionsLanguage = (lang) => {
    const activeLang = lang === 'en' ? 'en' : 'es';
    const copy = getUiCopy(activeLang);

    if (prevButton) prevButton.setAttribute('aria-label', copy.prevAria);
    if (nextButton) nextButton.setAttribute('aria-label', copy.nextAria);
    if (carousel) carousel.setAttribute('aria-label', copy.carouselAria);

    const allCards = carousel ? Array.from(carousel.querySelectorAll('.collection-card')) : [];
    allCards.forEach((card) => {
      const ctaNode = card.querySelector('.discover-btn');
      if (ctaNode) {
        ctaNode.setAttribute('href', appendLang(ctaNode.getAttribute('href') || '/contacto', activeLang));
      }
    });
  };

  const setupInfiniteCarousel = () => {
    if (!carousel || !initialCards.length || loopReady) return;

    const prependClones = initialCards.map((card) => card.cloneNode(true));
    const appendClones = initialCards.map((card) => card.cloneNode(true));

    prependClones.forEach((clone) => {
      carousel.insertBefore(clone, carousel.firstChild);
    });

    appendClones.forEach((clone) => {
      carousel.appendChild(clone);
    });

    const getCardOffset = (index) => {
      const cards = carousel.querySelectorAll('.collection-card');
      const safeIndex = Math.max(0, Math.min(index, cards.length - 1));
      const target = cards[safeIndex];
      return target ? target.offsetLeft : 0;
    };

    const measureStep = () => {
      const cards = carousel.querySelectorAll('.collection-card');
      if (cards.length < 2) return;
      stepSize = cards[1].offsetLeft - cards[0].offsetLeft;
      if (stepSize <= 0) {
        stepSize = cards[0].getBoundingClientRect().width;
      }
    };

    const jumpToVirtualIndex = (index) => {
      const left = getCardOffset(index);
      carousel.scrollTo({ left, behavior: 'auto' });
    };

    const normalizeVirtualIndex = () => {
      if (virtualIndex >= baseCount * 2) {
        virtualIndex -= baseCount;
        jumpToVirtualIndex(virtualIndex);
      } else if (virtualIndex < baseCount) {
        virtualIndex += baseCount;
        jumpToVirtualIndex(virtualIndex);
      }
    };

    const animateToVirtualIndex = (nextIndex) => {
      if (isAnimating) return;
      isAnimating = true;
      virtualIndex = nextIndex;
      const targetLeft = getCardOffset(virtualIndex);
      carousel.scrollTo({ left: targetLeft, behavior: 'smooth' });

      window.setTimeout(() => {
        normalizeVirtualIndex();
        isAnimating = false;
      }, 360);
    };

    requestAnimationFrame(() => {
      measureStep();
      jumpToVirtualIndex(virtualIndex);
    });

    window.addEventListener('resize', () => {
      requestAnimationFrame(() => {
        measureStep();
        jumpToVirtualIndex(virtualIndex);
      });
    });

    carousel.addEventListener('scroll', () => {
      if (isAnimating || !stepSize) return;
      const estimated = Math.round(carousel.scrollLeft / stepSize);
      if (!Number.isNaN(estimated)) {
        virtualIndex = estimated;
      }
      normalizeVirtualIndex();
    });

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
        animateToVirtualIndex(virtualIndex + direction);
      });
    });

    loopReady = true;
  };

  document.querySelectorAll('.lang-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const targetLang = link.textContent?.trim().toLowerCase() === 'en' ? 'en' : 'es';
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set('lang', targetLang);
      localStorage.setItem('siteLang', targetLang);
      window.location.href = nextUrl.toString();
    });
  });

  const initializeCollectionsLanguage = async () => {
    const activeLang = getActiveLang();

    if (sourceMode === 'api') {
      const payload = await fetchCollectionsPayload(activeLang);
      if (payload) {
        applyApiPayload(payload, activeLang);
      } else {
        applyCollectionsLanguage(activeLang);
      }
    } else {
      applyCollectionsLanguage(activeLang);
    }

    setupInfiniteCarousel();
  };

  initializeCollectionsLanguage();
</script>

<style>
  .collections-section {
    display: grid;
    gap: 1.5rem;
  }

  .collections-section h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: 0.02em;
  }

  .collections-copy {
    margin: 0;
    max-width: 78ch;
    color: #2f2f2f;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .carousel-shell {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-left: 0;
  }

  .carousel-viewport {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .carousel-controls {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0.5rem;
    pointer-events: none;
    z-index: 2;
  }

  .carousel-btn {
    border: 1px solid #161616;
    background: #fff;
    color: #161616;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    pointer-events: auto;
  }

  .carousel-btn:hover {
    background: #111;
    color: #fff;
  }

  .collection-carousel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(320px, 48%);
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0;
    scrollbar-width: none;
  }

  .collection-carousel::-webkit-scrollbar {
    display: none;
  }

  .collection-card {
    scroll-snap-align: start;
    border: 0;
    border-right: 1px solid #ebebeb;
    border-radius: 0;
    overflow: hidden;
    background: #fff;
    box-shadow: none;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .collection-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .collection-card__body {
    padding: 1.1rem 1.1rem 1.2rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.6rem;
  }

  .collection-card__body h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.1em;
    line-height: 1.2;
    min-height: 2.4em;
    display: flex;
    align-items: flex-start;
  }

  .collection-card__body p {
    margin: 0;
    color: #444;
    line-height: 1.45;
    min-height: 4.35em;
  }

  .discover-btn {
    display: inline-block;
    text-decoration: none;
    border: 1px solid #161616;
    background: #fff;
    color: #161616;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    transition: background-color 0.2s ease, color 0.2s ease;
    justify-self: start;
    align-self: end;
  }

  .discover-btn:hover {
    background: #111;
    color: #fff;
  }

  .carousel-btn--icon {
    min-width: 2.45rem;
    padding-inline: 0;
    font-size: 1rem;
    line-height: 1;
    backdrop-filter: blur(3px);
    background: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 980px) {
    .collection-carousel {
      grid-auto-columns: minmax(340px, 72vw);
    }
  }

  @media (max-width: 680px) {
    .carousel-controls {
      padding: 0 0.5rem;
    }

    .collection-carousel {
      grid-auto-columns: minmax(280px, 90vw);
    }

    .collection-card__body p {
      min-height: 0;
    }
  }
</style>
