---
import PageLayout from '../layouts/PageLayout.astro';
import CatalogsCarousel from '../components/CatalogsCarousel.astro';
import { loadCatalogs } from '../lib/catalogs';
import { loadContactPageContent } from '../lib/contact-content';

// Same shared endpoint the homepage renders; both languages ship so the carousel
// can switch without a reload.
const { en: catalogsEn, es: catalogsEs } = await loadCatalogs();
const { en: contactEn, es: contactEs } = await loadContactPageContent();

// Where the form POSTs. Unset in local/mock mode, exactly like the CMS URLs:
// the form then tells the visitor to email us instead of failing silently.
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || '';

// Mirrors Header.astro's resolver: ?lang= wins, English is the default.
const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const selectedLang = langParam === 'en' || langParam === 'es' ? langParam : 'en';
const isEs = selectedLang === 'es';
const pick = (en: string, es: string) => (isEs ? es : en);

const activeContent = isEs ? contactEs : contactEn;
const pageTitle = activeContent.meta?.seo_title || pick('Contact Us | Policrafters', 'Contáctanos | Policrafters');
const pageDescription = activeContent.meta?.search_description || pick('Get in touch with Policrafters', 'Ponte en contacto con Policrafters');

// Contact details are editable from CMS with mock fallback; phone href still falls
// back to sanitized E.164 when only a display string exists.
const contactPhoneDisplay = activeContent.contact?.phone_display || contactEn.contact?.phone_display || '+1 (813) 812-0650';
const contactPhoneHref = activeContent.contact?.phone_href || `tel:${contactPhoneDisplay.replace(/[^\d+]/g, '')}`;
const contactEmail = activeContent.contact?.email || contactEn.contact?.email || 'info@policrafters.com';
const contactUrl = activeContent.contact?.url_contact || contactEn.contact?.url_contact || '';

// Both languages ship in the markup as data-copy-es/-en, data-placeholder-es/-en
// and data-aria-es/-en, so Header's language toggle can switch without a reload.
const contentCopy = {
  heading: { en: contactEn.copy?.heading || 'CONTACT US!', es: contactEs.copy?.heading || '¡CONTÁCTANOS!' },
  intro: {
    en: contactEn.copy?.intro || "If you have any questions, concerns, or comments regarding Policrafters, please fill out the contact form below. We'd be happy to help you.",
    es: contactEs.copy?.intro || 'Si tienes preguntas, inquietudes o comentarios sobre Policrafters, completa el formulario de contacto a continuación. Con gusto te ayudaremos.'
  },
  phoneLabel: { en: contactEn.copy?.phone_label || 'CALL CENTER PHONE', es: contactEs.copy?.phone_label || 'TELÉFONO DEL CENTRO DE ATENCIÓN' },
  emailLabel: { en: contactEn.copy?.email_label || 'EMAIL', es: contactEs.copy?.email_label || 'CORREO ELECTRÓNICO' },
  projectButtonLabel: { en: contactEn.copy?.project_button_label || 'My Project', es: contactEs.copy?.project_button_label || 'Mi Proyecto' },
  locationsHeading: { en: contactEn.copy?.locations_heading || 'OUR LOCATIONS', es: contactEs.copy?.locations_heading || 'NUESTRAS UBICACIONES' },
  locationsAria: { en: contactEn.copy?.locations_aria || 'Policrafters locations', es: contactEs.copy?.locations_aria || 'Ubicaciones de Policrafters' },
  learnMore: { en: contactEn.copy?.learn_more || 'Learn more', es: contactEs.copy?.learn_more || 'Conoce más' }
};

const formCopy = {
  name: { en: 'Name', es: 'Nombre' },
  phone: { en: 'Phone', es: 'Teléfono' },
  email: { en: 'Email', es: 'Correo electrónico' },
  company: { en: 'Company Name', es: 'Nombre de la empresa' },
  message: { en: 'Message', es: 'Mensaje' },
  submit: { en: 'Submit', es: 'Enviar' },
  countryAria: { en: 'Select country calling code', es: 'Seleccionar código de país' },
  formAria: { en: 'Contact form', es: 'Formulario de contacto' }
};

const enLocations = Array.isArray(contactEn.locations) ? contactEn.locations : [];
const esLocations = Array.isArray(contactEs.locations) ? contactEs.locations : [];
const baseLocations = enLocations.length ? enLocations : esLocations;
const locations = baseLocations.map((enLocation, index) => {
  const esLocation = esLocations[index] ?? enLocation;
  const enStreet = enLocation?.street || '';
  const esStreet = esLocation?.street || enStreet;
  const enCity = enLocation?.city || '';
  const esCity = esLocation?.city || enCity;
  const query = encodeURIComponent(`${enStreet} ${enCity}`.trim());
  return {
    name: {
      en: enLocation?.name || `LOCATION ${index + 1}`,
      es: esLocation?.name || enLocation?.name || `UBICACIÓN ${index + 1}`
    },
    label: {
      en: enLocation?.address_label || `ADDRESS ${index + 1}`,
      es: esLocation?.address_label || enLocation?.address_label || `DIRECCIÓN ${index + 1}`
    },
    street: {
      en: enStreet,
      es: esStreet
    },
    city: {
      en: enCity,
      es: esCity
    },
    url: enLocation?.url || esLocation?.url || (query ? `https://www.google.com/maps/search/?api=1&query=${query}` : '#'),
    imageUrl: enLocation?.image?.url || esLocation?.image?.url || '/images/pages/location.png',
    alt: {
      en: enLocation?.image?.alt || `Policrafters ${enLocation?.name || `LOCATION ${index + 1}`} building`,
      es: esLocation?.image?.alt || `Edificio de Policrafters ${esLocation?.name || enLocation?.name || `UBICACIÓN ${index + 1}`}`
    }
  };
});

const countries = [
  {
    iso: 'US',
    dial: '+1',
    name: { en: 'United States', es: 'Estados Unidos' },
    svg: '<svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#fff"/><g fill="#b22234"><rect width="20" height="2"/><rect y="4" width="20" height="2"/><rect y="8" width="20" height="2"/><rect y="12" width="20" height="2"/></g><rect width="9" height="8" fill="#3c3b6e"/></svg>'
  },
  {
    iso: 'CA',
    dial: '+1',
    name: { en: 'Canada', es: 'Canadá' },
    svg: '<svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#fff"/><rect width="5" height="14" fill="#d52b1e"/><rect x="15" width="5" height="14" fill="#d52b1e"/><path d="M10 3l.6 1.5 1.5-.4-.5 1.5 1.4.2-1.1.9.3.7-1.6-.2.2 1.8-.8-.8-.8.8.2-1.8-1.6.2.3-.7-1.1-.9 1.4-.2-.5-1.5 1.5.4z" fill="#d52b1e"/></svg>'
  },
  {
    iso: 'MX',
    dial: '+52',
    name: { en: 'Mexico', es: 'México' },
    svg: '<svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#fff"/><rect width="6.7" height="14" fill="#006847"/><rect x="13.3" width="6.7" height="14" fill="#ce1126"/><circle cx="10" cy="7" r="1.6" fill="#8c6239"/></svg>'
  },
  {
    iso: 'CO',
    dial: '+57',
    name: { en: 'Colombia', es: 'Colombia' },
    svg: '<svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="7" fill="#fcd116"/><rect y="7" width="20" height="3.5" fill="#003893"/><rect y="10.5" width="20" height="3.5" fill="#ce1126"/></svg>'
  },
  {
    iso: 'ES',
    dial: '+34',
    name: { en: 'Spain', es: 'España' },
    svg: '<svg viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#c60b1e"/><rect y="3.5" width="20" height="7" fill="#ffc400"/></svg>'
  }
];
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  showHero={false}
>
  <section class="contact-page">
    <header class="contact-intro">
      <h1 data-copy-en={contentCopy.heading.en} data-copy-es={contentCopy.heading.es}>
        {pick(contentCopy.heading.en, contentCopy.heading.es)}
      </h1>
      <p data-copy-en={contentCopy.intro.en} data-copy-es={contentCopy.intro.es}>
        {pick(contentCopy.intro.en, contentCopy.intro.es)}
      </p>
    </header>

    <div class="contact-highlight">
      <h2 class="contact-highlight__label" data-copy-en={contentCopy.phoneLabel.en} data-copy-es={contentCopy.phoneLabel.es}>
        {pick(contentCopy.phoneLabel.en, contentCopy.phoneLabel.es)}
      </h2>
      <a class="contact-highlight__value" href={contactPhoneHref}>{contactPhoneDisplay}</a>
    </div>

    <form
      class="contact-form"
      novalidate
      data-contact-api={contactApiUrl}
      data-contact-email={contactEmail}
      data-aria-en={formCopy.formAria.en}
      data-aria-es={formCopy.formAria.es}
      aria-label={pick(formCopy.formAria.en, formCopy.formAria.es)}
    >
      <div class="field">
        <label class="sr-only" for="contact-name" data-copy-en={formCopy.name.en} data-copy-es={formCopy.name.es}>
          {pick(formCopy.name.en, formCopy.name.es)}
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          aria-describedby="contact-name-error"
          placeholder={pick(formCopy.name.en, formCopy.name.es)}
          data-placeholder-en={formCopy.name.en}
          data-placeholder-es={formCopy.name.es}
        />
        <p class="field-error" id="contact-name-error" hidden></p>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="sr-only" for="contact-phone" data-copy-en={formCopy.phone.en} data-copy-es={formCopy.phone.es}>
            {pick(formCopy.phone.en, formCopy.phone.es)}
          </label>
          <div class="phone-group">
            <div class="country-picker">
              <button
                type="button"
                class="country-toggle"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={pick(formCopy.countryAria.en, formCopy.countryAria.es)}
                data-aria-en={formCopy.countryAria.en}
                data-aria-es={formCopy.countryAria.es}
              >
                <span class="flag" data-current-flag set:html={countries[0].svg} />
                <svg class="caret" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </button>
              <ul class="country-list" role="listbox" hidden>
                {countries.map((country, index) => (
                  <li
                    role="option"
                    tabindex="-1"
                    data-iso={country.iso}
                    data-dial={country.dial}
                    aria-selected={index === 0 ? 'true' : 'false'}
                  >
                    <span class="flag" set:html={country.svg} />
                    <span data-copy-en={country.name.en} data-copy-es={country.name.es}>
                      {pick(country.name.en, country.name.es)}
                    </span>
                    <span class="dial">{country.dial}</span>
                  </li>
                ))}
              </ul>
            </div>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              maxlength="25"
              placeholder={pick(formCopy.phone.en, formCopy.phone.es)}
              data-placeholder-en={formCopy.phone.en}
              data-placeholder-es={formCopy.phone.es}
            />
            <input type="hidden" name="phone_country" value={countries[0].iso} />
            <input type="hidden" name="phone_dial_code" value={countries[0].dial} />
          </div>
        </div>

        <div class="field">
          <label class="sr-only" for="contact-email" data-copy-en={formCopy.email.en} data-copy-es={formCopy.email.es}>
            {pick(formCopy.email.en, formCopy.email.es)}
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            aria-describedby="contact-email-error"
            placeholder={pick(formCopy.email.en, formCopy.email.es)}
            data-placeholder-en={formCopy.email.en}
            data-placeholder-es={formCopy.email.es}
          />
          <p class="field-error" id="contact-email-error" hidden></p>
        </div>
      </div>

      <div class="field">
        <label class="sr-only" for="contact-company" data-copy-en={formCopy.company.en} data-copy-es={formCopy.company.es}>
          {pick(formCopy.company.en, formCopy.company.es)}
        </label>
        <input
          id="contact-company"
          name="company"
          type="text"
          autocomplete="organization"
          maxlength="120"
          placeholder={pick(formCopy.company.en, formCopy.company.es)}
          data-placeholder-en={formCopy.company.en}
          data-placeholder-es={formCopy.company.es}
        />
      </div>

      <div class="field">
        <label class="sr-only" for="contact-message" data-copy-en={formCopy.message.en} data-copy-es={formCopy.message.es}>
          {pick(formCopy.message.en, formCopy.message.es)}
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          maxlength="2000"
          aria-describedby="contact-message-error"
          placeholder={pick(formCopy.message.en, formCopy.message.es)}
          data-placeholder-en={formCopy.message.en}
          data-placeholder-es={formCopy.message.es}
        ></textarea>
        <p class="field-error" id="contact-message-error" hidden></p>
      </div>

      {/* Honeypot. Off-screen rather than display:none, which crawlers skip; hidden
          from assistive tech and the tab order, so only a bot ever fills it. */}
      <div class="hp-field" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-actions">
        <button type="submit" class="submit-btn" data-copy-en={formCopy.submit.en} data-copy-es={formCopy.submit.es}>
          {pick(formCopy.submit.en, formCopy.submit.es)}
        </button>
      </div>

      <p class="form-status" role="status" aria-live="polite" hidden></p>
    </form>

    <div class="contact-highlight">
      <p class="contact-highlight__label" data-copy-en={contentCopy.emailLabel.en} data-copy-es={contentCopy.emailLabel.es}>
        {pick(contentCopy.emailLabel.en, contentCopy.emailLabel.es)}
      </p>
      <a class="contact-highlight__value" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      {contactUrl && (
        <div class="contact-highlight__action">
          <a class="submit-btn" href={contactUrl} data-copy-en={contentCopy.projectButtonLabel.en} data-copy-es={contentCopy.projectButtonLabel.es}>
            {pick(contentCopy.projectButtonLabel.en, contentCopy.projectButtonLabel.es)}
          </a>
        </div>
      )}
    </div>

    <section
      class="locations"
      data-aria-en={contentCopy.locationsAria.en}
      data-aria-es={contentCopy.locationsAria.es}
      aria-label={pick(contentCopy.locationsAria.en, contentCopy.locationsAria.es)}
    >
      <h2 class="locations__heading" data-copy-en={contentCopy.locationsHeading.en} data-copy-es={contentCopy.locationsHeading.es}>
        {pick(contentCopy.locationsHeading.en, contentCopy.locationsHeading.es)}
      </h2>

      <ul class="locations__grid">
        {locations.map((location) => (
          <li class="location-card">
            <img
              class="location-card__image"
              src={location.imageUrl}
              width="252"
              height="200"
              loading="lazy"
              decoding="async"
              alt={pick(location.alt.en, location.alt.es)}
              data-alt-en={location.alt.en}
              data-alt-es={location.alt.es}
            />
            <h3 class="location-card__name" data-copy-en={location.name.en} data-copy-es={location.name.es}>
              {pick(location.name.en, location.name.es)}
            </h3>
            <p class="location-card__address">
              <span data-copy-en={location.label.en} data-copy-es={location.label.es}>
                {pick(location.label.en, location.label.es)}
              </span>
              <span data-copy-en={location.street.en} data-copy-es={location.street.es}>{pick(location.street.en, location.street.es)}</span>
              <span data-copy-en={location.city.en} data-copy-es={location.city.es}>{pick(location.city.en, location.city.es)}</span>
            </p>
            <a
              class="location-card__cta"
              href={location.url}
              target="_blank"
              rel="noopener noreferrer"
              data-copy-en={contentCopy.learnMore.en}
              data-copy-es={contentCopy.learnMore.es}
            >{pick(contentCopy.learnMore.en, contentCopy.learnMore.es)}</a>
          </li>
        ))}
      </ul>
    </section>
  </section>

  {/* Outside .contact-page on purpose: the carousel owns its own language
      switching, so keeping it out of this page's subscriber leaves one owner. */}
  <hr class="section-rule" />

  <CatalogsCarousel lang={selectedLang} en={catalogsEn} es={catalogsEs} />
</PageLayout>

<script>
  // Language subscriber. Header.astro owns `siteLang` and is the sole dispatcher of
  // `sitelangchange` — this file only reads and listens, never re-dispatches.
  const MESSAGES = {
    en: {
      required: 'This field is required.',
      email: 'Enter a valid email address.',
      sending: 'Sending…',
      success: "Thanks for reaching out. We'll be in touch shortly.",
      error: 'Something went wrong. Please try again, or email us at ',
      unconfigured: 'The contact form is not connected yet. Please email us at '
    },
    es: {
      required: 'Este campo es obligatorio.',
      email: 'Introduce un correo electrónico válido.',
      sending: 'Enviando…',
      success: 'Gracias por escribirnos. Nos pondremos en contacto contigo muy pronto.',
      error: 'Algo salió mal. Inténtalo de nuevo o escríbenos a ',
      unconfigured: 'El formulario aún no está conectado. Escríbenos a ',
    }
  };

  const root = document.querySelector('.contact-page');
  const form = document.querySelector('.contact-form');
  if (root && form instanceof HTMLFormElement) {
    const apiUrl = form.dataset.contactApi || '';
    const fallbackEmail = form.dataset.contactEmail || '';
    const status = form.querySelector('.form-status');
    const submitBtn = form.querySelector('.submit-btn');

    const getLangFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const lang = params.get('lang');
      return lang === 'en' || lang === 'es' ? lang : null;
    };

    // Mirrors Header.astro's resolver: url -> localStorage -> 'en'.
    const resolveActiveLang = () => {
      const inUrl = getLangFromUrl();
      if (inUrl) return inUrl;
      const stored = localStorage.getItem('siteLang');
      if (stored === 'en' || stored === 'es') return stored;
      return 'en';
    };

    let activeLang = resolveActiveLang();

    // Nobody reads the form and types a real message in under two seconds.
    const MIN_FILL_MS = 2000;
    const renderedAt = Date.now();

    const applyContactLanguage = (lang) => {
      activeLang = lang === 'es' ? 'es' : 'en';
      const key = activeLang;

      // Scoped to this page: Header and Footer run their own resolvers.
      root.querySelectorAll('[data-copy-en]').forEach((el) => {
        const value = el.getAttribute('data-copy-' + key);
        if (value !== null) el.textContent = value;
      });

      root.querySelectorAll('[data-placeholder-en]').forEach((el) => {
        const value = el.getAttribute('data-placeholder-' + key);
        if (value !== null) el.setAttribute('placeholder', value);
      });

      root.querySelectorAll('[data-aria-en]').forEach((el) => {
        const value = el.getAttribute('data-aria-' + key);
        if (value !== null) el.setAttribute('aria-label', value);
      });

      root.querySelectorAll('[data-alt-en]').forEach((el) => {
        const value = el.getAttribute('data-alt-' + key);
        if (value !== null) el.setAttribute('alt', value);
      });

      // Re-render any error/status text that is already on screen.
      form.querySelectorAll('.field-error').forEach((el) => {
        if (el.hidden) return;
        const rule = el.dataset.rule;
        if (rule) el.textContent = MESSAGES[activeLang][rule];
      });
      if (status && !status.hidden && status.dataset.rule) {
        renderStatus(status.dataset.rule, status.dataset.tone || 'error');
      }
    };

    const renderStatus = (rule, tone) => {
      if (!status) return;
      status.dataset.rule = rule;
      status.dataset.tone = tone;
      status.classList.toggle('is-error', tone === 'error');
      status.classList.toggle('is-success', tone === 'success');
      const text = MESSAGES[activeLang][rule];
      status.replaceChildren(text);
      // The failure paths end in an email address, which should stay clickable.
      if ((rule === 'error' || rule === 'unconfigured') && fallbackEmail) {
        const link = document.createElement('a');
        link.href = `mailto:${fallbackEmail}`;
        link.textContent = fallbackEmail;
        status.append(link, '.');
      }
      status.hidden = false;
    };

    const setFieldError = (field, rule) => {
      const holder = field.closest('.field');
      const error = holder?.querySelector('.field-error');
      field.setAttribute('aria-invalid', 'true');
      field.classList.add('has-error');
      if (error) {
        error.dataset.rule = rule;
        error.textContent = MESSAGES[activeLang][rule];
        error.hidden = false;
      }
    };

    const clearFieldError = (field) => {
      const holder = field.closest('.field');
      const error = holder?.querySelector('.field-error');
      field.removeAttribute('aria-invalid');
      field.classList.remove('has-error');
      if (error) {
        error.hidden = true;
        delete error.dataset.rule;
      }
    };

    // Deliberately permissive: the server is the real validator. This only catches
    // the obvious typos so a visitor is not bounced by a round trip.
    const isEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    const validate = () => {
      let firstInvalid = null;
      ['contact-name', 'contact-email', 'contact-message'].forEach((id) => {
        const field = form.querySelector('#' + id);
        if (!field) return;
        const value = field.value.trim();
        clearFieldError(field);
        if (!value) {
          setFieldError(field, 'required');
          firstInvalid = firstInvalid || field;
        } else if (field.type === 'email' && !isEmail(value)) {
          setFieldError(field, 'email');
          firstInvalid = firstInvalid || field;
        }
      });
      return firstInvalid;
    };

    // Payload built field by field rather than from raw FormData, so the honeypot
    // never ships, values are trimmed, and the phone reaches the CRM in one shape.
    // This is data hygiene, not security: the server must re-validate all of it.
    const buildPayload = () => {
      const raw = Object.fromEntries(new FormData(form).entries());
      const trim = (value) => (typeof value === 'string' ? value.trim() : '');
      const rawPhone = trim(raw.phone);
      const digits = rawPhone.replace(/\D/g, '');
      // A visitor who typed their own "+" already carries a country code; otherwise
      // prepend the one the picker is set to.
      const phone = digits
        ? (rawPhone.startsWith('+') ? `+${digits}` : `${raw.phone_dial_code || ''}${digits}`)
        : '';

      return {
        name: trim(raw.name),
        email: trim(raw.email),
        company: trim(raw.company),
        message: trim(raw.message),
        phone,
        phone_country: trim(raw.phone_country),
        locale: activeLang
      };
    };

    form.querySelectorAll('input, textarea').forEach((field) => {
      field.addEventListener('input', () => {
        if (field.classList.contains('has-error')) clearFieldError(field);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      // Spam gates. Both report success rather than an error: telling a bot which
      // check caught it just helps whoever wrote it. Neither is a substitute for
      // server-side rate limiting — they only cut the drive-by volume.
      const honeypot = form.querySelector('input[name="website"]');
      const tooFast = Date.now() - renderedAt < MIN_FILL_MS;
      if ((honeypot && honeypot.value) || tooFast) {
        console.warn('Contact form submission rejected locally (honeypot or timing).');
        form.reset();
        renderStatus('success', 'success');
        return;
      }

      if (!apiUrl) {
        renderStatus('unconfigured', 'error');
        return;
      }

      const originalLabel = submitBtn?.textContent;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = MESSAGES[activeLang].sending;
      }
      if (status) status.hidden = true;

      try {
        const payload = buildPayload();
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!response.ok) throw new Error(`Request failed: ${response.status}`);
        form.reset();
        renderStatus('success', 'success');
      } catch (error) {
        console.warn(`No se pudo enviar el formulario a ${apiUrl}.`, error);
        renderStatus('error', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          // Re-read the label so a language switch mid-send is not overwritten.
          submitBtn.textContent = submitBtn.getAttribute('data-copy-' + activeLang) || originalLabel;
        }
      }
    });

    // Country picker: a listbox rather than a <select> because the options carry flags.
    const picker = form.querySelector('.country-picker');
    if (picker) {
      const toggle = picker.querySelector('.country-toggle');
      const list = picker.querySelector('.country-list');
      const options = Array.from(picker.querySelectorAll('[role="option"]'));
      const currentFlag = picker.querySelector('[data-current-flag]');
      const isoInput = form.querySelector('input[name="phone_country"]');
      const dialInput = form.querySelector('input[name="phone_dial_code"]');

      const closeList = ({ focusToggle = false } = {}) => {
        list.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        if (focusToggle) toggle.focus();
      };

      const openList = () => {
        list.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        const selected = options.find((option) => option.getAttribute('aria-selected') === 'true');
        (selected || options[0])?.focus();
      };

      const selectOption = (option) => {
        options.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
        const flag = option.querySelector('.flag');
        if (currentFlag && flag) currentFlag.replaceChildren(...Array.from(flag.childNodes).map((n) => n.cloneNode(true)));
        if (isoInput) isoInput.value = option.dataset.iso || '';
        if (dialInput) dialInput.value = option.dataset.dial || '';
      };

      toggle.addEventListener('click', () => {
        if (list.hidden) openList();
        else closeList();
      });

      options.forEach((option) => {
        option.addEventListener('click', () => {
          selectOption(option);
          closeList({ focusToggle: true });
        });
        option.addEventListener('keydown', (event) => {
          const index = options.indexOf(option);
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            selectOption(option);
            closeList({ focusToggle: true });
          } else if (event.key === 'ArrowDown') {
            event.preventDefault();
            options[(index + 1) % options.length].focus();
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            options[(index - 1 + options.length) % options.length].focus();
          }
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !list.hidden) closeList({ focusToggle: true });
      });

      document.addEventListener('click', (event) => {
        if (!list.hidden && !picker.contains(event.target)) closeList();
      });
    }

    applyContactLanguage(activeLang);
    document.addEventListener('sitelangchange', (event) => applyContactLanguage(event.detail));
  }
</script>

