---
import PageLayout from '../layouts/PageLayout.astro';
import CatalogsCarousel from '../components/CatalogsCarousel.astro';
import { loadCatalogs } from '../lib/catalogs';
import { loadContactPageContent } from '../lib/contact-content';
import { toDevApiUrl } from '../lib/dev-proxy';

// Same shared endpoint the homepage renders; both languages ship so the carousel
// can switch without a reload.
const { en: catalogsEn, es: catalogsEs } = await loadCatalogs();
const { en: contactEn, es: contactEs } = await loadContactPageContent();

// Where the form POSTs. Unset in local/mock mode, exactly like the CMS URLs:
// the form then tells the visitor to email us instead of failing silently.
const contactApiUrl = toDevApiUrl(import.meta.env.PUBLIC_CONTACT_API_URL || '', 'browser');

// Mirrors Header.astro's resolver: ?lang= wins, English is the default.
const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const selectedLang = langParam === 'en' || langParam === 'es' ? langParam : 'en';
const isEs = selectedLang === 'es';
const pick = (en: string, es: string) => (isEs ? es : en);

const activeContent = isEs ? contactEs : contactEn;
const pageTitle = activeContent.meta?.seo_title || pick('Contact Us | Policrafters', 'Contáctanos | Policrafters');
const pageDescription = activeContent.meta?.search_description || pick('Get in touch with Policrafters', 'Ponte en contacto con Policrafters');

// Contact details are editable from CMS with mock fallback; phone href still falls
// back to sanitized E.164 when only a display string exists.
const contactPhoneDisplay = activeContent.contact?.phone_display || contactEn.contact?.phone_display || '+1 (813) 812-0650';
const contactPhoneHref = activeContent.contact?.phone_href || `tel:${contactPhoneDisplay.replace(/[^\d+]/g, '')}`;
const contactEmail = activeContent.contact?.email || contactEn.contact?.email || 'info@policrafters.com';
const contactUrl = activeContent.contact?.url_contact || contactEn.contact?.url_contact || '';

// Banner image: language-independent URL (same photo either way), alt text is
// localized. Same per-key-fallback-to-EN pattern as warranty.astro/finance.astro.
const bannerImageUrl = contactEn.banner_image?.url || contactEs.banner_image?.url || '/images/pages/values_1.webp';
const enBannerAlt = contactEn.banner_image?.alt || '';
const esBannerAlt = contactEs.banner_image?.alt || enBannerAlt;

// Both languages ship in the markup as data-copy-es/-en, data-placeholder-es/-en
// and data-aria-es/-en, so Header's language toggle can switch without a reload.
const contentCopy = {
  heading: { en: contactEn.copy?.heading || 'CONTACT US!', es: contactEs.copy?.heading || '¡CONTÁCTANOS!' },
  intro: {
    en: contactEn.copy?.intro || "If you have any questions, concerns, or comments regarding Policrafters, please contact our Call Center, where our team will be happy to assist you.",
    es: contactEs.copy?.intro || 'Si tienes preguntas, inquietudes o comentarios sobre Policrafters, comunícate con nuestro Call Center, donde nuestro equipo estará encantado de ayudarte.'
  },
  phoneLabel: { en: contactEn.copy?.phone_label || 'CALL CENTER PHONE', es: contactEs.copy?.phone_label || 'TELÉFONO DEL CENTRO DE ATENCIÓN' },
  emailLabel: { en: contactEn.copy?.email_label || 'EMAIL', es: contactEs.copy?.email_label || 'CORREO ELECTRÓNICO' },
  bannerEyebrow: { en: contactEn.copy?.banner_eyebrow || 'GET IN TOUCH', es: contactEs.copy?.banner_eyebrow || 'CONTÁCTANOS' },
  bannerHeading: { en: contactEn.copy?.banner_heading || 'Start Your Next Project with Policrafters', es: contactEs.copy?.banner_heading || 'Comienza tu próximo proyecto con Policrafters' },
  projectButtonLabel: { en: contactEn.copy?.project_button_label || "LET'S TALK!", es: contactEs.copy?.project_button_label || '¡HABLEMOS!' },
  locationsHeading: { en: contactEn.copy?.locations_heading || 'OUR LOCATIONS', es: contactEs.copy?.locations_heading || 'NUESTRAS UBICACIONES' },
  locationsAria: { en: contactEn.copy?.locations_aria || 'Policrafters locations', es: contactEs.copy?.locations_aria || 'Ubicaciones de Policrafters' },
  learnMore: { en: contactEn.copy?.learn_more || 'Learn more', es: contactEs.copy?.learn_more || 'Conoce más' }
};

const enLocations = Array.isArray(contactEn.locations) ? contactEn.locations : [];
const esLocations = Array.isArray(contactEs.locations) ? contactEs.locations : [];
const baseLocations = enLocations.length ? enLocations : esLocations;
const locations = baseLocations.map((enLocation, index) => {
  const esLocation = esLocations[index] ?? enLocation;
  const enStreet = enLocation?.street || '';
  const esStreet = esLocation?.street || enStreet;
  const enCity = enLocation?.city || '';
  const esCity = esLocation?.city || enCity;
  const query = encodeURIComponent(`${enStreet} ${enCity}`.trim());
  return {
    name: {
      en: enLocation?.name || `LOCATION ${index + 1}`,
      es: esLocation?.name || enLocation?.name || `UBICACIÓN ${index + 1}`
    },
    label: {
      en: enLocation?.address_label || `ADDRESS ${index + 1}`,
      es: esLocation?.address_label || enLocation?.address_label || `DIRECCIÓN ${index + 1}`
    },
    street: {
      en: enStreet,
      es: esStreet
    },
    city: {
      en: enCity,
      es: esCity
    },
    url: enLocation?.url || esLocation?.url || (query ? `https://www.google.com/maps/search/?api=1&query=${query}` : '#'),
    imageUrl: enLocation?.image?.url || esLocation?.image?.url || '/images/pages/location.png',
    alt: {
      en: enLocation?.image?.alt || `Policrafters ${enLocation?.name || `LOCATION ${index + 1}`} building`,
      es: esLocation?.image?.alt || `Edificio de Policrafters ${esLocation?.name || enLocation?.name || `UBICACIÓN ${index + 1}`}`
    }
  };
});

---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  showHero={false}
  image={{ url: bannerImageUrl, alt: pick(enBannerAlt, esBannerAlt) }}
>
  <section class="contact-page">
    <header class="contact-intro">
      <h1 data-copy-en={contentCopy.heading.en} data-copy-es={contentCopy.heading.es}>
        {pick(contentCopy.heading.en, contentCopy.heading.es)}
      </h1>
      <p data-copy-en={contentCopy.intro.en} data-copy-es={contentCopy.intro.es}>
        {pick(contentCopy.intro.en, contentCopy.intro.es)}
      </p>
    </header>

    <!-- Banner: full-bleed photo under a dark overlay, the Policrafters mark
         (decorative — a static site asset, not CMS content) in the top-right
         turned white via CSS, and a centered eyebrow/heading/CTA. The CTA
         opens the external lead form (contact.url_contact) in a new tab;
         this replaces the "My Project" button that used to sit in the email
         block below. Full-bleed technique copied from finance.astro's
         .finance-bleed: breaks out of PageLayout's ~1100px .page-shell,
         safe because its body has overflow-x: clip. -->
    <div class="contact-banner-bleed">
      <div class="contact-banner">
        <img
          class="contact-banner__image"
          data-contact-field="banner-image"
          src={bannerImageUrl}
          alt=""
          data-alt-en={enBannerAlt}
          data-alt-es={esBannerAlt}
          width="1600"
          height="896"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="contact-banner__overlay"></div>
        <img
          class="contact-banner__logo"
          src="/favicon-512.png"
          alt=""
          aria-hidden="true"
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
        />
        <div class="contact-banner__content">
          <p
            class="contact-banner__eyebrow"
            data-contact-field="banner-eyebrow"
            data-copy-en={contentCopy.bannerEyebrow.en}
            data-copy-es={contentCopy.bannerEyebrow.es}
          >{pick(contentCopy.bannerEyebrow.en, contentCopy.bannerEyebrow.es)}</p>
          <h2
            class="contact-banner__heading"
            data-contact-field="banner-heading"
            data-copy-en={contentCopy.bannerHeading.en}
            data-copy-es={contentCopy.bannerHeading.es}
          >{pick(contentCopy.bannerHeading.en, contentCopy.bannerHeading.es)}</h2>
          {contactUrl && (
            <a
              class="contact-banner__cta"
              data-contact-field="banner-cta"
              href={contactUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-copy-en={contentCopy.projectButtonLabel.en}
              data-copy-es={contentCopy.projectButtonLabel.es}
            >{pick(contentCopy.projectButtonLabel.en, contentCopy.projectButtonLabel.es)}</a>
          )}
        </div>
      </div>
    </div>

    <div class="contact-highlight">
      <h2 class="contact-highlight__label" data-contact-field="phone-label" data-copy-en={contentCopy.phoneLabel.en} data-copy-es={contentCopy.phoneLabel.es}>
        {pick(contentCopy.phoneLabel.en, contentCopy.phoneLabel.es)}
      </h2>
      <a class="contact-highlight__value" data-contact-field="phone-value" href={contactPhoneHref}>{contactPhoneDisplay}</a>
    </div>

    <div class="contact-highlight">
      <p class="contact-highlight__label" data-contact-field="email-label" data-copy-en={contentCopy.emailLabel.en} data-copy-es={contentCopy.emailLabel.es}>
        {pick(contentCopy.emailLabel.en, contentCopy.emailLabel.es)}
      </p>
      <a class="contact-highlight__value" data-contact-field="email-value" href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </div>

    <section
      class="locations"
      data-aria-en={contentCopy.locationsAria.en}
      data-aria-es={contentCopy.locationsAria.es}
      aria-label={pick(contentCopy.locationsAria.en, contentCopy.locationsAria.es)}
    >
      <h2 class="locations__heading" data-copy-en={contentCopy.locationsHeading.en} data-copy-es={contentCopy.locationsHeading.es}>
        {pick(contentCopy.locationsHeading.en, contentCopy.locationsHeading.es)}
      </h2>

      <ul class="locations__grid">
        {locations.map((location) => (
          <li class="location-card">
            <img
              class="location-card__image"
              src={location.imageUrl}
              width="252"
              height="200"
              loading="lazy"
              decoding="async"
              alt={pick(location.alt.en, location.alt.es)}
              data-alt-en={location.alt.en}
              data-alt-es={location.alt.es}
            />
            <h3 class="location-card__name" data-copy-en={location.name.en} data-copy-es={location.name.es}>
              {pick(location.name.en, location.name.es)}
            </h3>
            <p class="location-card__address">
              <span data-copy-en={location.label.en} data-copy-es={location.label.es}>
                {pick(location.label.en, location.label.es)}
              </span>
              <span data-copy-en={location.street.en} data-copy-es={location.street.es}>{pick(location.street.en, location.street.es)}</span>
              <span data-copy-en={location.city.en} data-copy-es={location.city.es}>{pick(location.city.en, location.city.es)}</span>
            </p>
            <a
              class="location-card__cta"
              href={location.url}
              target="_blank"
              rel="noopener noreferrer"
              data-copy-en={contentCopy.learnMore.en}
              data-copy-es={contentCopy.learnMore.es}
            >{pick(contentCopy.learnMore.en, contentCopy.learnMore.es)}</a>
          </li>
        ))}
      </ul>
    </section>
  </section>

  {/* Outside .contact-page on purpose: the carousel owns its own language
      switching, so keeping it out of this page's subscriber leaves one owner. */}
  <hr class="section-rule" />

  <CatalogsCarousel lang={selectedLang} en={catalogsEn} es={catalogsEs} />
</PageLayout>

<script>
  // Language subscriber. Header.astro owns `siteLang` and is the sole dispatcher of
  // `sitelangchange` — this file only reads and listens, never re-dispatches.
  let isWagtailPreview = false;

  const root = document.querySelector('.contact-page');
  if (root) {
    const getLangFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const lang = params.get('lang');
      return lang === 'en' || lang === 'es' ? lang : null;
    };

    // Mirrors Header.astro's resolver: url -> localStorage -> 'en'.
    const resolveActiveLang = () => {
      const inUrl = getLangFromUrl();
      if (inUrl) return inUrl;
      const stored = localStorage.getItem('siteLang');
      if (stored === 'en' || stored === 'es') return stored;
      return 'en';
    };

    let activeLang = resolveActiveLang();

    const applyContactLanguage = (lang) => {
      if (isWagtailPreview) {
        return;
      }

      activeLang = lang === 'es' ? 'es' : 'en';
      const key = activeLang;

      // Scoped to this page: Header and Footer run their own resolvers.
      root.querySelectorAll('[data-copy-en]').forEach((el) => {
        const value = el.getAttribute('data-copy-' + key);
        if (value !== null) el.textContent = value;
      });

      root.querySelectorAll('[data-aria-en]').forEach((el) => {
        const value = el.getAttribute('data-aria-' + key);
        if (value !== null) el.setAttribute('aria-label', value);
      });

      root.querySelectorAll('[data-alt-en]').forEach((el) => {
        const value = el.getAttribute('data-alt-' + key);
        if (value !== null) el.setAttribute('alt', value);
      });
    };

    const normalizePreviewAssetUrl = (value) => {
      if (typeof value !== 'string' || !value) return '';
      if (
        window.location.hostname === 'localhost' &&
        value.startsWith('http://localhost/media/')
      ) {
        return value.replace(
          'http://localhost/media/',
          'http://localhost:8000/media/'
        );
      }
      return value;
    };

    const setCopyPair = (element, value) => {
      if (!element || typeof value !== 'string') return;
      element.textContent = value;
      element.setAttribute('data-copy-en', value);
      element.setAttribute('data-copy-es', value);
    };

    const setAltPair = (element, value) => {
      if (!element || typeof value !== 'string') return;
      element.setAttribute('alt', value);
      element.setAttribute('data-alt-en', value);
      element.setAttribute('data-alt-es', value);
    };

    const updateLocationsPreview = (locations = [], learnMoreLabel = '') => {
      const grid = document.querySelector('.locations__grid');
      const template = grid?.querySelector('.location-card');
      if (!grid || !template) return;

      grid.replaceChildren();
      locations.forEach((location, index) => {
        const card = template.cloneNode(true);
        const image = card.querySelector('.location-card__image');
        if (image) {
          image.setAttribute('src', normalizePreviewAssetUrl(location?.image?.url || ''));
          setAltPair(image, location?.image?.alt || `LOCATION ${index + 1}`);
        }

        setCopyPair(card.querySelector('.location-card__name'), location?.name || '');

        const address = card.querySelector('.location-card__address');
        if (address) {
          const parts = address.querySelectorAll('[data-copy-en]');
          if (parts[0]) setCopyPair(parts[0], location?.address_label || '');
          if (parts[1]) setCopyPair(parts[1], location?.street || '');
          if (parts[2]) setCopyPair(parts[2], location?.city || '');
        }

        const link = card.querySelector('.location-card__cta');
        if (link) {
          link.setAttribute('href', location?.url || '#');
          setCopyPair(link, learnMoreLabel || link.textContent || '');
        }

        grid.appendChild(card);
      });
    };

    // Field lookups below use [data-contact-field] rather than relying on DOM
    // order — the page now has two ".contact-highlight" blocks (phone, email)
    // whose labels/values would otherwise collide under the same class names.
    const updateContactPreview = (previewData) => {
      const fields = previewData?.fields ?? {};

      if (typeof previewData?.meta?.seo_title === 'string' && previewData.meta.seo_title.trim()) {
        document.title = previewData.meta.seo_title;
      }

      if (typeof previewData?.meta?.search_description === 'string') {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
          metaDescription.setAttribute('content', previewData.meta.search_description);
        }
      }

      setCopyPair(document.querySelector('.contact-intro h1'), fields.copy?.heading || '');
      setCopyPair(document.querySelector('.contact-intro p'), fields.copy?.intro || '');

      const bannerImage = document.querySelector('[data-contact-field="banner-image"]');
      if (bannerImage && fields.banner_image && typeof fields.banner_image === 'object') {
        const bannerUrl = normalizePreviewAssetUrl(fields.banner_image.url || '');
        if (bannerUrl) bannerImage.setAttribute('src', bannerUrl);
        setAltPair(bannerImage, fields.banner_image.alt || '');
      }

      setCopyPair(document.querySelector('[data-contact-field="banner-eyebrow"]'), fields.copy?.banner_eyebrow || '');
      setCopyPair(document.querySelector('[data-contact-field="banner-heading"]'), fields.copy?.banner_heading || '');

      const bannerCta = document.querySelector('[data-contact-field="banner-cta"]');
      if (bannerCta) {
        setCopyPair(bannerCta, fields.copy?.project_button_label || '');
        if (typeof fields.contact?.url_contact === 'string') {
          bannerCta.setAttribute('href', fields.contact.url_contact);
        }
      }

      setCopyPair(document.querySelector('[data-contact-field="phone-label"]'), fields.copy?.phone_label || '');
      const phoneValue = fields.contact?.phone_display || '';
      const phoneHref = fields.contact?.phone_href || `tel:${phoneValue.replace(/[^\d+]/g, '')}`;
      const phoneLink = document.querySelector('[data-contact-field="phone-value"]');
      if (phoneLink && phoneValue) {
        phoneLink.textContent = phoneValue;
        phoneLink.setAttribute('href', phoneHref);
      }

      setCopyPair(document.querySelector('[data-contact-field="email-label"]'), fields.copy?.email_label || '');
      const emailLink = document.querySelector('[data-contact-field="email-value"]');
      if (emailLink && typeof fields.contact?.email === 'string') {
        emailLink.textContent = fields.contact.email;
        emailLink.setAttribute('href', `mailto:${fields.contact.email}`);
      }

      setCopyPair(document.querySelector('.locations__heading'), fields.copy?.locations_heading || '');
      const locationsSection = document.querySelector('.locations');
      if (locationsSection && typeof fields.copy?.locations_aria === 'string') {
        locationsSection.setAttribute('aria-label', fields.copy.locations_aria);
      }

      updateLocationsPreview(Array.isArray(fields.locations) ? fields.locations : [], fields.copy?.learn_more || '');

      const previewLang = previewData?.locale === 'es' ? 'es' : 'en';
      isWagtailPreview = true;
      document.documentElement.lang = previewLang;
    };

    applyContactLanguage(activeLang);
    document.addEventListener('sitelangchange', (event) => applyContactLanguage(event.detail));

    window.addEventListener('message', (event) => {
      if (event.data?.type !== 'policrafters-preview') {
        return;
      }

      const previewData = event.data?.payload;
      if (!previewData || typeof previewData !== 'object') {
        return;
      }

      if (typeof previewData.type !== 'string' || !previewData.type.endsWith('.ContactPage')) {
        return;
      }

      updateContactPreview(previewData);
    });
  }
</script>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* The rule down the left edge of the heading block, as in the design. */
  .contact-intro {
    border-left: 3px solid #2f3437;
    padding-left: 1.15rem;
  }

  .contact-intro h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #111;
  }

  .contact-intro p {
    margin: 0;
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #3f4447;
    max-width: 68ch;
  }

  .contact-highlight {
    text-align: center;
  }

  .contact-highlight__label {
    margin: 0 0 0.35rem;
    color: #b6ae99;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-highlight__value {
    color: #2f3437;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    text-decoration: none;
  }

  .contact-highlight__value:hover,
  .contact-highlight__value:focus-visible {
    text-decoration: underline;
  }

  /* Banner: full-bleed photo under a dark overlay, with the logo, eyebrow,
     heading and CTA stacked on top. Full-bleed technique copied from
     finance.astro's .finance-bleed: width:100vw plus negative side margins
     to break out of PageLayout's ~1100px .page-shell, safe because its body
     has overflow-x: clip. */
  .contact-banner-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .contact-banner {
    position: relative;
    height: clamp(340px, 35vw, 600px);
    overflow: hidden;
  }

  .contact-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .contact-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  /* Decorative mark, not CMS content — see the <img alt=""> above. Dark on
     transparent in the source file, turned white here to sit on the photo. */
  .contact-banner__logo {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2.5rem);
    right: clamp(1rem, 2.5vw, 2.5rem);
    width: clamp(56px, 6vw, 104px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .contact-banner__content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.5rem;
    text-align: center;
    color: #fff;
  }

  .contact-banner__eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-banner__heading {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.8rem, 4.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .contact-banner__cta {
    margin-top: 0.6rem;
    padding: 0.85rem 3.5rem;
    border: 1px solid #fff;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact-banner__cta:hover,
  .contact-banner__cta:focus-visible {
    background: #fff;
    color: #2f3437;
  }

  .contact-banner__cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .contact-banner {
      height: clamp(340px, 55vw, 440px);
    }

    .contact-banner__cta {
      padding: 0.75rem 2.4rem;
    }
  }

  .locations {
    margin-top: 0.75rem;
  }

  /* Matches index.astro's divider; .contact-page's flex gap does not reach here,
     so the spacing around the rule is set explicitly. */
  .section-rule {
    margin: 3.5rem 0 3rem;
    border: none;
    border-top: 1px solid #2f3437;
  }

  .locations__heading {
    margin: 0 0 1.75rem;
    text-align: center;
    color: #b6ae99;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .locations__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .location-card__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* The short rule under the name, as in the design: narrower than the card. */
  .location-card__name {
