---
import PageLayout from '../layouts/PageLayout.astro';
import DirectContact from '../components/DirectContact.astro';
import { buildDirectContact } from '../lib/direct-contact';
import collectionsPage from '../mocks/collections-page.json';

type AnyRecord = Record<string, any>;

const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const requestedLang = langParam === 'en' || langParam === 'es' ? langParam : 'es';
const useApi = import.meta.env.PUBLIC_USE_API === 'true';
const apiUrl = import.meta.env.PUBLIC_COLLECTIONS_API_URL || '';
const apiOrigin = apiUrl && apiUrl.startsWith('http') ? new URL(apiUrl).origin : '';
let isRemoteData = false;

const normalizeAssetUrl = (value: unknown): string => {
  if (!value) return '';
  if (typeof value !== 'string') return '';
  if (/^https?:\/\//i.test(value)) return value;
  if (value.startsWith('/') && isRemoteData) {
    return apiOrigin ? `${apiOrigin}${value}` : value;
  }
  return value;
};

let data = collectionsPage;

if (useApi && apiUrl) {
  try {
    let localizedApiUrl = apiUrl;

    if (apiUrl.startsWith('http')) {
      const url = new URL(apiUrl);
      url.searchParams.set('locale', requestedLang);
      localizedApiUrl = url.toString();
    }

    const response = await fetch(localizedApiUrl);
    if (response.ok) {
      const payload = await response.json();
      if (payload && typeof payload === 'object') {
        data = payload;
        isRemoteData = true;
      }
    }
  } catch (error) {
    console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
  }
}

const resolvedData = data ?? collectionsPage;
const resolvedFields = (resolvedData.fields ?? collectionsPage.fields ?? {}) as AnyRecord;
const resolvedMeta = resolvedData.meta ?? collectionsPage.meta ?? {};
const fallbackFields = (collectionsPage.fields ?? {}) as AnyRecord;

// Mirrors index.astro: ?lang= wins, otherwise the payload's locale decides.
const normalizedLocale = typeof resolvedData.locale === 'string' ? resolvedData.locale.toLowerCase() : '';
const isEsLocale = normalizedLocale.includes('es');
const selectedLang = langParam === 'en' || langParam === 'es'
  ? langParam
  : (isEsLocale ? 'es' : 'en');
const isEs = selectedLang === 'es';
const pick = (es: string, en?: string) => (isEs ? es : (en ?? es));

const esTitle = resolvedFields.hero_title || resolvedData.title || collectionsPage.title || 'Colecciones';
const enTitle = resolvedFields.hero_title_en || fallbackFields.hero_title_en || esTitle;
const esSubtitle = resolvedFields.hero_subtitle || fallbackFields.hero_subtitle || '';
const enSubtitle = resolvedFields.hero_subtitle_en || fallbackFields.hero_subtitle_en || esSubtitle;
const esIntro = resolvedFields.intro_text || fallbackFields.intro_text || '';
const enIntro = resolvedFields.intro_text_en || fallbackFields.intro_text_en || esIntro;
const esEmptyState = resolvedFields.empty_state_text || fallbackFields.empty_state_text || 'Próximamente';
const enEmptyState = resolvedFields.empty_state_text_en || fallbackFields.empty_state_text_en || esEmptyState;

const pageTitle = pick(esTitle, enTitle);
const pageSubtitle = pick(esSubtitle, enSubtitle);
const introText = pick(esIntro, enIntro);

// The taxonomy lives under fields.categories: Spanish base key + `_en` sibling, the
// same convention this file's mock already used for collection_items. NOTE: this
// diverges from Docs/API_CONTRACT.md, which specifies one already-localized language
// per API response with no `_en` sibling keys — flagged here rather than fixed, since
// the mock this page has always shipped with already relies on it.
const categories = Array.isArray(resolvedFields.categories)
  ? resolvedFields.categories
  : (fallbackFields.categories ?? []);

const showerDoorsCategory = categories.find((category: AnyRecord) => category.key === 'shower-doors') ?? { types: [] };
const showerDoorTypes = Array.isArray(showerDoorsCategory.types) ? showerDoorsCategory.types : [];

// Flatten every type's products into one list for the gallery, tagging each with its
// type key so the client script can filter by checked type without touching the DOM.
const showerDoorProducts = showerDoorTypes.flatMap((type: AnyRecord) =>
  (Array.isArray(type.products) ? type.products : []).map((product: AnyRecord) => ({
    ...product,
    typeKey: type.key
  }))
);

const defaultCategoryKey = 'shower-doors';

// This page has no home payload, so both languages fall back to the home mocks —
// buildDirectContact is null-safe for exactly this case.
const { en: directContactEn, es: directContactEs } = buildDirectContact(null, selectedLang);
---

<PageLayout
  title={resolvedMeta.seo_title || 'Collections | Policrafters'}
  description={pick(resolvedMeta.search_description, resolvedMeta.search_description_en) || 'Featured Policrafters collections'}
  heroTitle={pageTitle}
  heroSubtitle={pageSubtitle}
  heroTitleEs={esTitle}
  heroTitleEn={enTitle}
  heroSubtitleEs={esSubtitle}
  heroSubtitleEn={enSubtitle}
>
  <section class="collections-shell">
    <h2 id="collections-title" data-copy-es={esTitle} data-copy-en={enTitle}>{pageTitle}</h2>
    <p id="collections-intro" class="collections-copy" data-copy-es={esIntro} data-copy-en={enIntro}>{introText}</p>

    <div class="collections-layout">
      <aside
        class="filters"
        aria-label={pick('Filtros de colecciones', 'Collection filters')}
        data-aria-es="Filtros de colecciones"
        data-aria-en="Collection filters"
      >
        {categories.map((category: AnyRecord) => {
          const isDefault = category.key === defaultCategoryKey;
          const panelId = `filter-panel-${category.key}`;
          return (
            <div class="filter-section" data-category={category.key}>
              <button
                type="button"
                class="filter-section__toggle"
                aria-expanded={isDefault ? 'true' : 'false'}
                aria-controls={panelId}
                data-copy-es={category.label}
                data-copy-en={category.label_en}
              >{pick(category.label, category.label_en)}</button>

              <div id={panelId} class="filter-section__panel" hidden={!isDefault}>
                {category.has_products ? (
                  <ul class="filter-types">
                    {(category.types ?? []).map((type: AnyRecord) => {
                      const inputId = `filter-type-${type.key}`;
                      return (
                        <li>
                          <label class="filter-type" for={inputId}>
                            <input
                              type="checkbox"
                              id={inputId}
                              class="filter-type__checkbox"
                              data-type={type.key}
                            />
                            <span data-copy-es={type.label} data-copy-en={type.label_en}>
                              {pick(type.label, type.label_en)}
                            </span>
                          </label>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <ul class="filter-lorem">
                    {(category.types ?? []).map((sub: AnyRecord) => (
                      <li data-copy-es={sub.label} data-copy-en={sub.label_en}>
                        {pick(sub.label, sub.label_en)}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </aside>

      <div class="gallery" aria-live="polite">
        <div class="gallery-grid" id="shower-doors-grid">
          {showerDoorProducts.map((product: AnyRecord) => (
            <a href="#" class="gallery-card" data-product-type={product.typeKey}>
              <img
                src={normalizeAssetUrl(product.image?.url)}
                alt={pick(product.image?.alt, product.image?.alt_en) || ''}
                data-alt-es={product.image?.alt || ''}
                data-alt-en={product.image?.alt_en || product.image?.alt || ''}
                loading="lazy"
                decoding="async"
              />
              <span
                class="gallery-card__title"
                data-copy-es={product.title}
                data-copy-en={product.title_en || product.title}
              >{pick(product.title, product.title_en)}</span>
            </a>
          ))}
        </div>

        <p
          class="gallery-empty"
          id="gallery-empty"
          hidden
          data-copy-es={esEmptyState}
          data-copy-en={enEmptyState}
        >{pick(esEmptyState, enEmptyState)}</p>
      </div>
    </div>

    <DirectContact lang={selectedLang} en={directContactEn} es={directContactEs} />
  </section>
</PageLayout>

<script>
  // @ts-nocheck
  const shell = document.querySelector('.collections-shell');

  if (shell) {
    const sections = Array.from(shell.querySelectorAll('.filter-section'));
    const galleryGrid = shell.querySelector('#shower-doors-grid');
    const galleryEmpty = shell.querySelector('#gallery-empty');
    const cards = galleryGrid ? Array.from(galleryGrid.querySelectorAll('.gallery-card')) : [];
    const checkboxes = Array.from(shell.querySelectorAll('.filter-type__checkbox'));

    let activeCategory = 'shower-doors';

    // Re-applies visibility for whatever is currently active/checked. Never rebuilds
    // the DOM, so checkbox state and scroll position survive both a category switch
    // and a language switch.
    const applyGalleryState = () => {
      const showShowerDoors = activeCategory === 'shower-doors';
      if (galleryGrid) galleryGrid.hidden = !showShowerDoors;
      if (galleryEmpty) galleryEmpty.hidden = showShowerDoors;

      if (showShowerDoors) {
        const checkedTypes = checkboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.dataset.type);
        cards.forEach((card) => {
          const matches = checkedTypes.length === 0 || checkedTypes.includes(card.dataset.productType);
          card.hidden = !matches;
        });
      }
    };

    // Expanding a section IS selecting it: the mockup treats "Shower Doors" as both
    // the default expanded panel and the default visible gallery. Single-open
    // accordion — expanding one section collapses the rest.
    const setActiveCategory = (categoryKey) => {
      activeCategory = categoryKey;
      sections.forEach((section) => {
        const toggle = section.querySelector('.filter-section__toggle');
        const panel = section.querySelector('.filter-section__panel');
        const isActive = section.dataset.category === categoryKey;
        toggle?.setAttribute('aria-expanded', String(isActive));
        if (panel) panel.hidden = !isActive;
      });
      applyGalleryState();
    };

    sections.forEach((section) => {
      const toggle = section.querySelector('.filter-section__toggle');
      toggle?.addEventListener('click', () => setActiveCategory(section.dataset.category));
    });

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', applyGalleryState);
    });

    // Matches the server-rendered default (shower-doors expanded, no type checked,
    // all 14 cards visible) so there is no flash of different content on load.
    applyGalleryState();

    const getLangFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const lang = params.get('lang');
      return lang === 'en' || lang === 'es' ? lang : null;
    };

    // Mirrors Header.astro's resolver: url -> localStorage -> 'en'.
    // Header owns writing `siteLang`; this is a subscriber, so it only reads.
    const getActiveLang = () => {
      const inUrl = getLangFromUrl();
      if (inUrl) return inUrl;
      const stored = localStorage.getItem('siteLang');
      if (stored === 'en' || stored === 'es') return stored;
      return 'en';
    };

    // All copy ships in the markup as data-copy-es/-en, data-alt-es/-en (images), and
    // data-aria-es/-en (aria-label), so switching never touches filter/accordion
    // state above.
    const applyCollectionsLanguage = (lang) => {
      const key = lang === 'en' ? 'en' : 'es';

      shell.querySelectorAll('[data-copy-es]').forEach((el) => {
        const value = el.getAttribute('data-copy-' + key);
        if (value !== null) el.textContent = value;
      });

      shell.querySelectorAll('[data-alt-es]').forEach((el) => {
        const value = el.getAttribute('data-alt-' + key);
        if (value !== null) el.setAttribute('alt', value);
      });

      shell.querySelectorAll('[data-aria-es]').forEach((el) => {
        const value = el.getAttribute('data-aria-' + key);
        if (value !== null) el.setAttribute('aria-label', value);
      });
    };

    // Subscriber only. Header.astro owns lang state, the .lang-link handlers, and the
    // sitelangchange dispatch. Self-boot first, since Header's boot dispatch fires
    // before this page script runs (see Footer.astro for the same pattern).
    applyCollectionsLanguage(getActiveLang());
    document.addEventListener('sitelangchange', (event) => applyCollectionsLanguage(event.detail));
  }
</script>

<style>
  .collections-shell {
    display: grid;
    gap: 1.5rem;
  }

  .collections-shell h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: 0.02em;
  }

  .collections-copy {
    margin: 0;
    max-width: 78ch;
    color: #2f2f2f;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  /* This page needs a wider stage than the ~1100px .page-shell every other interior
     page shares (see PageLayout.astro's :root --max). Rather than override that
     shared token — which would either leak to other pages or race PageLayout's own
     CSS on load order — break out of .page-shell with the same full-bleed technique
     PageLayout's own body { overflow-x: clip } comment anticipates, then re-cap the
     content at 1440px with padding. */
  .collections-layout,
  .collections-shell > :global(.direct-contact) {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-inline: max(1.5rem, calc((100vw - 1440px) / 2));
    box-sizing: border-box;
  }

  .collections-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .filters {
    display: grid;
    border-top: 1px solid #dcdcdc;
  }

  .filter-section {
    border-bottom: 1px solid #dcdcdc;
  }

  .filter-section__toggle {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 0;
    padding: 0.9rem 0;
    font-size: 0.92rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: left;
    color: #161616;
    cursor: pointer;
  }

  .filter-section__toggle::after {
    content: '+';
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .filter-section__toggle[aria-expanded="true"]::after {
    content: '\2212';
  }

  .filter-section__panel {
    padding: 0 0 1.1rem;
  }

  .filter-types,
  .filter-lorem {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .filter-type {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: #2f2f2f;
    cursor: pointer;
  }

  .filter-type__checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: #161616;
    cursor: pointer;
  }

  .filter-lorem li {
    font-size: 0.85rem;
    color: #777;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .gallery-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .gallery-card img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
    background: #f2f2f2;
  }

  .gallery-card__title {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .gallery-empty {
    margin: 0;
    padding: 4rem 0;
    text-align: center;
    font-size: 1.1rem;
    color: #777;
  }

  @media (max-width: 980px) {
    .collections-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .collections-layout,
    .collections-shell > :global(.direct-contact) {
      padding-inline: 1.25rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
