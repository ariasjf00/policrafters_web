---
import PageLayout from '../layouts/PageLayout.astro';
import { loadTermsPageContent } from '../lib/terms-content';

type AnyRecord = Record<string, any>;

// Both languages fetched at build time, same as services.astro / brands.astro: this
// page ships every string twice (data-copy-es/-en) so Header's toggle can switch it
// without a reload, which means one localized response isn't enough.
const { en: termsEn, es: termsEs } = await loadTermsPageContent();

// Mirrors Header.astro's resolver: ?lang= wins, English is the default (see
// CLAUDE.md — there is no route-based i18n).
const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const selectedLang = langParam === 'en' || langParam === 'es' ? langParam : 'en';
const isEs = selectedLang === 'es';
const pick = (es: string, en?: string) => (isEs ? es : (en ?? es));

const activeContent = isEs ? termsEs : termsEn;
const enFields = termsEn.fields;
const esFields = termsEs.fields;

const esSeoTitle = termsEs.meta?.seo_title || 'Términos y condiciones | Policrafters';
const enSeoTitle = termsEn.meta?.seo_title || 'Terms & Conditions | Policrafters';
const esSearchDescription = termsEs.meta?.search_description || '';
const enSearchDescription = termsEn.meta?.search_description || esSearchDescription;

const resolvedMeta = {
  seo_title: activeContent.meta?.seo_title || (isEs ? esSeoTitle : enSeoTitle),
  search_description: activeContent.meta?.search_description || (isEs ? esSearchDescription : enSearchDescription)
};

const esIntroHeading = esFields.intro_heading || '';
const enIntroHeading = enFields.intro_heading || esIntroHeading;
const esIntroBody = esFields.intro_body || '';
const enIntroBody = enFields.intro_body || esIntroBody;

// Terms are paired by index (same shared-URL convention as services.astro's
// `services` array); English drives the length. The number shown before each
// title comes from this array position, not from the payload.
const enTerms = Array.isArray(enFields.terms) ? enFields.terms : [];
const esTerms = Array.isArray(esFields.terms) ? esFields.terms : [];
const terms = enTerms.map((enItem: AnyRecord, index: number) => {
  const esItem = esTerms[index] ?? enItem;
  return {
    key: enItem.key ?? esItem.key ?? String(index),
    title: { es: esItem.title ?? enItem.title ?? '', en: enItem.title ?? esItem.title ?? '' },
    body: { es: esItem.body ?? enItem.body ?? '', en: enItem.body ?? esItem.body ?? '' }
  };
});
---

<PageLayout
  title={resolvedMeta.seo_title}
  description={resolvedMeta.search_description}
  showHero={false}
>
  <section
    class="terms-shell"
    data-seo-title-es={esSeoTitle}
    data-seo-title-en={enSeoTitle}
    data-seo-description-es={esSearchDescription}
    data-seo-description-en={enSearchDescription}
  >
    <!-- 1. Intro — h1 + italic lead, set off by a left vertical rule spanning
         both, same border-left recipe as services.astro's .service-row__title
         (itself borrowed from the homepage's .team-card__meta). Sits inside
         .page-shell's width, not full-bleed. -->
    <div class="terms-intro">
      <h1
        class="terms-intro__heading"
        data-copy-es={esIntroHeading}
        data-copy-en={enIntroHeading}
      >{pick(esIntroHeading, enIntroHeading)}</h1>
      <p
        class="terms-intro__body"
        data-copy-es={esIntroBody}
        data-copy-en={enIntroBody}
      >{pick(esIntroBody, enIntroBody)}</p>
    </div>

    <!-- 2. Terms grid — two columns, items in source order 1→7 so row-wise
         grid flow puts the odd numbers (1,3,5,7) in the left column and the
         even numbers (2,4,6) in the right column, matching the mockup.
         Collapses to one column at <=900px. -->
    <div class="terms-grid">
      {terms.map((term: AnyRecord, index: number) => (
        <div class="terms-item">
          <h2 class="terms-item__title">
            {`${index + 1}. `}<span
              data-copy-es={term.title.es}
              data-copy-en={term.title.en}
            >{pick(term.title.es, term.title.en)}</span>{':'}
          </h2>
          <p
            class="terms-item__body"
            data-copy-es={term.body.es}
            data-copy-en={term.body.en}
          >{pick(term.body.es, term.body.en)}</p>
        </div>
      ))}
    </div>
  </section>
</PageLayout>

<script>
  // @ts-nocheck
  const shell = document.querySelector('.terms-shell');

  if (shell) {
    let isWagtailPreview = false;
    const scopeAttr = Array.from(shell.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'))?.name;
    const applyScope = (el) => {
      if (scopeAttr) el.setAttribute(scopeAttr, '');
      return el;
    };

    const getLangFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const lang = params.get('lang');
      return lang === 'en' || lang === 'es' ? lang : null;
    };

    // Mirrors Header.astro's resolver: url -> localStorage -> 'en'.
    // Header owns writing `siteLang`; this is a subscriber, so it only reads.
    const getActiveLang = () => {
      const inUrl = getLangFromUrl();
      if (inUrl) return inUrl;
      const stored = localStorage.getItem('siteLang');
      if (stored === 'en' || stored === 'es') return stored;
      return 'en';
    };

    // All copy ships in the markup as data-copy-es/-en. document.title and the
    // meta description are swapped too, from data attributes on the shell.
    const applyTermsLanguage = (lang) => {
      if (isWagtailPreview) {
        return;
      }

      const key = lang === 'en' ? 'en' : 'es';

      shell.querySelectorAll('[data-copy-es]').forEach((el) => {
        const value = el.getAttribute('data-copy-' + key);
        if (value !== null) el.textContent = value;
      });

      const title = shell.getAttribute('data-seo-title-' + key);
      if (title) document.title = title;

      const description = shell.getAttribute('data-seo-description-' + key);
      if (description !== null) {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) metaDescription.setAttribute('content', description);
      }

      document.documentElement.lang = key;
    };

    const setLocalizedCopy = (el, value) => {
      el.textContent = value;
      el.setAttribute('data-copy-es', value);
      el.setAttribute('data-copy-en', value);
    };

    const applyTermsPreview = (previewData) => {
      const fields = previewData?.fields ?? {};

      const headingEl = shell.querySelector('.terms-intro__heading');
      if (headingEl && typeof fields.intro_heading === 'string') {
        setLocalizedCopy(headingEl, fields.intro_heading);
      }

      const introBodyEl = shell.querySelector('.terms-intro__body');
      if (introBodyEl && typeof fields.intro_body === 'string') {
        setLocalizedCopy(introBodyEl, fields.intro_body);
      }

      if (typeof previewData?.meta?.seo_title === 'string' && previewData.meta.seo_title.trim()) {
        document.title = previewData.meta.seo_title;
      }

      if (typeof previewData?.meta?.search_description === 'string') {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
          metaDescription.setAttribute('content', previewData.meta.search_description);
        }
      }

      const termsGrid = shell.querySelector('.terms-grid');
      if (!termsGrid) {
        document.documentElement.lang = previewData?.locale === 'es' ? 'es' : 'en';
        return;
      }

      const previewTerms = Array.isArray(fields.terms) ? fields.terms : [];
      termsGrid.querySelectorAll('.terms-item').forEach((item) => item.remove());

      previewTerms.forEach((term, index) => {
        const item = applyScope(document.createElement('div'));
        item.className = 'terms-item';

        const title = applyScope(document.createElement('h2'));
        title.className = 'terms-item__title';
        title.append(`${index + 1}. `);

        const titleCopy = applyScope(document.createElement('span'));
        setLocalizedCopy(titleCopy, typeof term?.title === 'string' ? term.title : '');
        title.appendChild(titleCopy);
        title.append(':');

        const body = applyScope(document.createElement('p'));
        body.className = 'terms-item__body';
        setLocalizedCopy(body, typeof term?.body === 'string' ? term.body : '');

        item.append(title, body);
        termsGrid.appendChild(item);
      });

      document.documentElement.lang = previewData?.locale === 'es' ? 'es' : 'en';
    };

    window.addEventListener('message', (event) => {
      if (event.data?.type !== 'policrafters-preview') {
        return;
      }

      const previewData = event.data?.payload;
      if (!previewData || typeof previewData !== 'object') {
        return;
      }

      if (typeof previewData.type !== 'string' || !previewData.type.endsWith('.TermsPage')) {
        return;
      }

      isWagtailPreview = true;
      applyTermsPreview(previewData);
    });

    // Subscriber only. Header.astro owns lang state, the .lang-link handlers, and the
    // sitelangchange dispatch. This script never dispatches sitelangchange and never
    // writes localStorage.siteLang — re-dispatching would turn Header's boot into a
    // feedback loop. Self-boot first, since Header's boot dispatch fires before this
    // page script runs (see services.astro for the same pattern).
    applyTermsLanguage(getActiveLang());
    document.addEventListener('sitelangchange', (event) => applyTermsLanguage(event.detail));
  }
</script>

<style>
  .terms-shell {
    display: grid;
    gap: 0;
  }

  /* Section 1: intro heading + lead, left vertical rule spans both — same
     border-left recipe as services.astro's .service-row__title. */
  .terms-intro {
    margin-bottom: 3rem;
    border-left-style: solid;
    border-left-color: #2f3437;
    border-left-width: 1px;
    padding-left: 1rem;
  }

  .terms-intro__heading {
    margin: 0 0 .75rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #111;
  }

  .terms-intro__body {
    margin: 0;
    max-width: 70ch;
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.4;
    color: #333;
  }

  /* Section 2: two columns, source order 1..7 — row-wise grid flow puts odd
     numbers left, even numbers right, matching the mockup. */
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
    row-gap: 2.5rem;
  }

  .terms-item__title {
    margin: 0 0 .6rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #111;
  }

  .terms-item__body {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.5;
    color: #333;
  }

  @media (max-width: 900px) {
    .terms-grid {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
  }
</style>
