---
import PageLayout from '../layouts/PageLayout.astro';
import HeadedTextBlock from '../components/HeadedTextBlock.astro';
import { loadWhyPolicraftersPageContent } from '../lib/why-policrafters-content';

type AnyRecord = Record<string, any>;

// Both languages fetched at build time, same as services.astro / warranty.astro:
// this page ships every string twice (data-copy-es/-en) so Header's toggle can
// switch it without a reload, which means one localized response isn't enough.
const { en: whyEn, es: whyEs } = await loadWhyPolicraftersPageContent();

// Mirrors Header.astro's resolver: ?lang= wins, English is the default (see
// CLAUDE.md — there is no route-based i18n).
const langParam = Astro.url.searchParams.get('lang')?.toLowerCase();
const selectedLang = langParam === 'en' || langParam === 'es' ? langParam : 'en';
const isEs = selectedLang === 'es';
const pick = (es: string, en?: string) => (isEs ? es : (en ?? es));

const activeContent = isEs ? whyEs : whyEn;
const enFields = whyEn.fields;
const esFields = whyEs.fields;

const esSeoTitle = whyEs.meta?.seo_title || 'Por Qué Policrafters | Policrafters';
const enSeoTitle = whyEn.meta?.seo_title || 'Why Policrafters | Policrafters';
const esSearchDescription = whyEs.meta?.search_description || '';
const enSearchDescription = whyEn.meta?.search_description || esSearchDescription;

const resolvedMeta = {
  seo_title: activeContent.meta?.seo_title || (isEs ? esSeoTitle : enSeoTitle),
  search_description: activeContent.meta?.search_description || (isEs ? esSearchDescription : enSearchDescription)
};

// Section 1: banner + intro. Image URL is language-independent (same file
// either way); only the alt text differs per language — same convention
// services.astro/product.astro use for their hero.
const esHeroAlt = esFields.hero_image?.alt || '';
const enHeroAlt = enFields.hero_image?.alt || esHeroAlt;
const heroImageUrl = enFields.hero_image?.url || esFields.hero_image?.url || '';

const esIntroEyebrow = esFields.intro_eyebrow || '';
const enIntroEyebrow = enFields.intro_eyebrow || esIntroEyebrow;
const esIntroHeading = esFields.intro_heading || '';
const enIntroHeading = enFields.intro_heading || esIntroHeading;

const enIntroBody = Array.isArray(enFields.intro_body) ? enFields.intro_body : [];
const esIntroBody = Array.isArray(esFields.intro_body) ? esFields.intro_body : [];
const introBody = enIntroBody.map((enPara: string, index: number) => ({
  es: esIntroBody[index] ?? enPara,
  en: enPara
}));

// Section 2: "Why choose us" — three HeadedTextBlock items, paired by index
// (same shared-URL convention as services.astro's `services` array).
const esWhyEyebrow = esFields.why_eyebrow || '';
const enWhyEyebrow = enFields.why_eyebrow || esWhyEyebrow;
const esWhyHeading = esFields.why_heading || '';
const enWhyHeading = enFields.why_heading || esWhyHeading;

const enWhyItems = Array.isArray(enFields.why_items) ? enFields.why_items : [];
const esWhyItems = Array.isArray(esFields.why_items) ? esFields.why_items : [];
const whyItems = enWhyItems.map((enItem: AnyRecord, index: number) => {
  const esItem = esWhyItems[index] ?? enItem;
  const enBody = Array.isArray(enItem.body) ? enItem.body : [];
  const esBody = Array.isArray(esItem.body) ? esItem.body : [];
  return {
    key: enItem.key ?? esItem.key ?? String(index),
    headingEs: esItem.heading ?? enItem.heading ?? '',
    headingEn: enItem.heading ?? esItem.heading ?? '',
    body: enBody.map((enPara: string, paraIndex: number) => ({
      es: esBody[paraIndex] ?? enPara,
      en: enPara
    }))
  };
});

// Section 3: Certifications. Image is language-independent like the hero.
const esCertImageAlt = esFields.certifications_image?.alt || '';
const enCertImageAlt = enFields.certifications_image?.alt || esCertImageAlt;
const certImageUrl = enFields.certifications_image?.url || esFields.certifications_image?.url || '';

const esCertEyebrow = esFields.certifications_eyebrow || '';
const enCertEyebrow = enFields.certifications_eyebrow || esCertEyebrow;
const esCertHeading = esFields.certifications_heading || '';
const enCertHeading = enFields.certifications_heading || esCertHeading;

const enCertBody = Array.isArray(enFields.certifications_body) ? enFields.certifications_body : [];
const esCertBody = Array.isArray(esFields.certifications_body) ? esFields.certifications_body : [];
const certBody = enCertBody.map((enPara: string, index: number) => ({
  es: esCertBody[index] ?? enPara,
  en: enPara
}));

// issuers: each issuer's logo spans its own license count (DBPR's logo spans
// 2 columns because it owns 2 licenses — see Docs/API_CONTRACT.md §
// WhyPolicraftersPage). `licenses[].number` is language-independent (read
// from EN, like `column`/`key` in WarrantyPage); `label`/`caption` localize.
const enIssuers = Array.isArray(enFields.issuers) ? enFields.issuers : [];
const esIssuers = Array.isArray(esFields.issuers) ? esFields.issuers : [];
const issuers = enIssuers.map((enIssuer: AnyRecord, index: number) => {
  const esIssuer = esIssuers[index] ?? enIssuer;
  const enLicenses = Array.isArray(enIssuer.licenses) ? enIssuer.licenses : [];
  const esLicenses = Array.isArray(esIssuer.licenses) ? esIssuer.licenses : [];
  const licenses = enLicenses.map((enLicense: AnyRecord, licenseIndex: number) => {
    const esLicense = esLicenses[licenseIndex] ?? enLicense;
    return {
      labelEs: esLicense.label ?? enLicense.label ?? '',
      labelEn: enLicense.label ?? esLicense.label ?? '',
      number: enLicense.number ?? esLicense.number ?? '',
      captionEs: esLicense.caption ?? enLicense.caption ?? '',
      captionEn: enLicense.caption ?? esLicense.caption ?? ''
    };
  });
  return {
    key: enIssuer.key ?? esIssuer.key ?? String(index),
    logoUrl: enIssuer.logo?.url || esIssuer.logo?.url || '',
    logoAltEs: esIssuer.logo?.alt || '',
    logoAltEn: enIssuer.logo?.alt || esIssuer.logo?.alt || '',
    span: licenses.length || 1,
    licenses
  };
});

// Section 4: Corporate identity — same HeadedTextBlock shape as section 2.
const esIdentityEyebrow = esFields.identity_eyebrow || '';
const enIdentityEyebrow = enFields.identity_eyebrow || esIdentityEyebrow;
const esIdentityHeading = esFields.identity_heading || '';
const enIdentityHeading = enFields.identity_heading || esIdentityHeading;

const enIdentityItems = Array.isArray(enFields.identity_items) ? enFields.identity_items : [];
const esIdentityItems = Array.isArray(esFields.identity_items) ? esFields.identity_items : [];
const identityItems = enIdentityItems.map((enItem: AnyRecord, index: number) => {
  const esItem = esIdentityItems[index] ?? enItem;
  const enBody = Array.isArray(enItem.body) ? enItem.body : [];
  const esBody = Array.isArray(esItem.body) ? esItem.body : [];
  return {
    key: enItem.key ?? esItem.key ?? String(index),
    headingEs: esItem.heading ?? enItem.heading ?? '',
    headingEn: enItem.heading ?? esItem.heading ?? '',
    body: enBody.map((enPara: string, paraIndex: number) => ({
      es: esBody[paraIndex] ?? enPara,
      en: enPara
    }))
  };
});

// Section 5: Partners — same alternating-row shape as services.astro's
// `services` array, with a logo substituting for the heading/subtitle.
const esPartnersEyebrow = esFields.partners_eyebrow || '';
const enPartnersEyebrow = enFields.partners_eyebrow || esPartnersEyebrow;
const esPartnersHeading = esFields.partners_heading || '';
const enPartnersHeading = enFields.partners_heading || esPartnersHeading;
const esPartnersIntro = esFields.partners_intro || '';
const enPartnersIntro = enFields.partners_intro || esPartnersIntro;

const enPartners = Array.isArray(enFields.partners) ? enFields.partners : [];
const esPartners = Array.isArray(esFields.partners) ? esFields.partners : [];
const partners = enPartners.map((enPartner: AnyRecord, index: number) => {
  const esPartner = esPartners[index] ?? enPartner;
  const enBody = Array.isArray(enPartner.body) ? enPartner.body : [];
  const esBody = Array.isArray(esPartner.body) ? esPartner.body : [];
  return {
    key: enPartner.key ?? esPartner.key ?? String(index),
    logo: {
      url: enPartner.logo?.url || esPartner.logo?.url || '',
      alt: { es: esPartner.logo?.alt ?? '', en: enPartner.logo?.alt ?? esPartner.logo?.alt ?? '' }
    },
    image: {
      url: enPartner.image?.url || esPartner.image?.url || '',
      alt: { es: esPartner.image?.alt ?? '', en: enPartner.image?.alt ?? esPartner.image?.alt ?? '' }
    },
    body: enBody.map((enPara: string, paraIndex: number) => ({
      es: esBody[paraIndex] ?? enPara,
      en: enPara
    }))
  };
});
---

<PageLayout
  title={resolvedMeta.seo_title}
  description={resolvedMeta.search_description}
  showHero={false}
>
  <section
    class="why-shell"
    data-seo-title-es={esSeoTitle}
    data-seo-title-en={enSeoTitle}
    data-seo-description-es={esSearchDescription}
    data-seo-description-en={enSearchDescription}
  >
    <!-- Section 1: banner + intro. Full-bleed hero exactly like
         services.astro's .services-bleed/.services-hero. -->
    <div class="why-bleed why-hero">
      <img
        src={heroImageUrl}
        alt={pick(esHeroAlt, enHeroAlt)}
        data-alt-es={esHeroAlt}
        data-alt-en={enHeroAlt}
        width="1440"
        height="960"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="why-intro">
      <p
        class="section-eyebrow"
        data-copy-es={esIntroEyebrow}
        data-copy-en={enIntroEyebrow}
      >{pick(esIntroEyebrow, enIntroEyebrow)}</p>
      <h1
        class="section-heading"
        data-copy-es={esIntroHeading}
        data-copy-en={enIntroHeading}
      >{pick(esIntroHeading, enIntroHeading)}</h1>
      {introBody.map((para: AnyRecord) => (
        <p
          class="why-intro__body"
          data-copy-es={para.es}
          data-copy-en={para.en}
        >{pick(para.es, para.en)}</p>
      ))}
    </div>

    <hr class="section-rule" />

    <!-- Section 2: "Why choose us" — three HeadedTextBlock items. -->
    <div class="why-section">
      <div class="why-section__intro">
        <p
          class="section-eyebrow"
          data-copy-es={esWhyEyebrow}
          data-copy-en={enWhyEyebrow}
        >{pick(esWhyEyebrow, enWhyEyebrow)}</p>
        <h2
          class="section-heading"
          data-copy-es={esWhyHeading}
          data-copy-en={enWhyHeading}
        >{pick(esWhyHeading, enWhyHeading)}</h2>
      </div>
      {whyItems.map((item: AnyRecord) => (
        <HeadedTextBlock
          lang={selectedLang}
          headingEs={item.headingEs}
          headingEn={item.headingEn}
          body={item.body}
        />
      ))}
    </div>

    <hr class="section-rule" />

    <!-- Section 3: Certifications. Container-width image (not full-bleed),
         then eyebrow/heading/body, then the credentials grid. -->
    <div class="why-section">
      <div class="why-cert-image-wrap">
        <img
          class="why-cert-image"
          src={certImageUrl}
          alt={pick(esCertImageAlt, enCertImageAlt)}
          data-alt-es={esCertImageAlt}
          data-alt-en={enCertImageAlt}
          width="1440"
          height="500"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="why-section__intro">
        <p
          class="section-eyebrow why-cert-eyebrow"
          data-copy-es={esCertEyebrow}
          data-copy-en={enCertEyebrow}
        >{pick(esCertEyebrow, enCertEyebrow)}</p>
        <h2
          class="section-heading"
          data-copy-es={esCertHeading}
          data-copy-en={enCertHeading}
        >{pick(esCertHeading, enCertHeading)}</h2>
      </div>

      {certBody.map((para: AnyRecord) => (
        <p
          class="why-cert-body"
          data-copy-es={para.es}
          data-copy-en={para.en}
        >{pick(para.es, para.en)}</p>
      ))}

      <!-- Credentials grid: total columns = sum of each issuer's license
           count. Each issuer renders as a `display: contents` group on
           desktop so its logo (spanning its own license count) and license
           blocks fall into the right grid cells; on narrow screens
           `contents` is dropped so the group stacks as a normal block. -->
      <div
        class="why-credentials"
        style={`--credential-columns: ${issuers.reduce((sum: number, issuer: AnyRecord) => sum + issuer.span, 0) || 1}`}
      >
        {issuers.map((issuer: AnyRecord) => (
          <div class="why-credentials__issuer" style={`--issuer-span: ${issuer.span}`}>
            <div class="why-credentials__logo-cell">
              <img
                class="why-credentials__logo"
                src={issuer.logoUrl}
                alt={pick(issuer.logoAltEs, issuer.logoAltEn)}
                data-alt-es={issuer.logoAltEs}
                data-alt-en={issuer.logoAltEn}
                loading="lazy"
                decoding="async"
              />
            </div>
            {issuer.licenses.map((license: AnyRecord) => (
              <div class="why-credentials__license">
                <p
                  class="why-credentials__label"
                  data-copy-es={license.labelEs}
                  data-copy-en={license.labelEn}
                >{pick(license.labelEs, license.labelEn)}</p>
                <p class="why-credentials__number">{license.number}</p>
                <p
                  class="why-credentials__caption"
                  data-copy-es={license.captionEs}
                  data-copy-en={license.captionEn}
                >{pick(license.captionEs, license.captionEn)}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <hr class="section-rule" />

    <!-- Section 4: Corporate identity — same HeadedTextBlock items as
         section 2 (Our Mission / Our Vision / Our Values). -->
    <div class="why-section">
      <div class="why-section__intro">
        <p
          class="section-eyebrow"
          data-copy-es={esIdentityEyebrow}
          data-copy-en={enIdentityEyebrow}
        >{pick(esIdentityEyebrow, enIdentityEyebrow)}</p>
        <h2
          class="section-heading"
          data-copy-es={esIdentityHeading}
          data-copy-en={enIdentityHeading}
        >{pick(esIdentityHeading, enIdentityHeading)}</h2>
      </div>
      {identityItems.map((item: AnyRecord) => (
        <HeadedTextBlock
          lang={selectedLang}
          headingEs={item.headingEs}
          headingEn={item.headingEn}
          body={item.body}
        />
      ))}
    </div>

    <hr class="section-rule" />

    <!-- Section 5: Partners. No <hr> after this one — the page goes
         straight to the footer. Rows reuse services.astro's .service-row
         alternating image/copy layout, with a logo substituting for the
         heading/subtitle. -->
    <div class="why-section">
      <div class="why-section__intro">
        <p
          class="section-eyebrow"
          data-copy-es={esPartnersEyebrow}
          data-copy-en={enPartnersEyebrow}
        >{pick(esPartnersEyebrow, enPartnersEyebrow)}</p>
        <h2
          class="section-heading"
          data-copy-es={esPartnersHeading}
          data-copy-en={enPartnersHeading}
        >{pick(esPartnersHeading, enPartnersHeading)}</h2>
        <p
          class="why-partners-intro"
          data-copy-es={esPartnersIntro}
          data-copy-en={enPartnersIntro}
        >{pick(esPartnersIntro, enPartnersIntro)}</p>
      </div>

      {partners.map((partner: AnyRecord, index: number) => (
        <div class={`service-row${index % 2 === 1 ? ' service-row--reversed' : ''}`}>
          <div class="service-row__image-wrap">
            <img
              class="service-row__image"
              src={partner.image.url}
              alt={pick(partner.image.alt.es, partner.image.alt.en)}
              data-alt-es={partner.image.alt.es}
              data-alt-en={partner.image.alt.en}
              width="1440"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="service-row__copy">
            <div class="service-row__title why-partner-logo-title">
              <img
                class="why-partner-logo"
                src={partner.logo.url}
                alt={pick(partner.logo.alt.es, partner.logo.alt.en)}
                data-alt-es={partner.logo.alt.es}
                data-alt-en={partner.logo.alt.en}
                loading="lazy"
                decoding="async"
              />
            </div>
            {partner.body.map((para: AnyRecord) => (
              <p
                class="service-row__body"
                data-copy-es={para.es}
                data-copy-en={para.en}
              >{pick(para.es, para.en)}</p>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</PageLayout>

<script>
  // @ts-nocheck
  const shell = document.querySelector('.why-shell');

  if (shell) {
    const getLangFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const lang = params.get('lang');
      return lang === 'en' || lang === 'es' ? lang : null;
    };

    // Mirrors Header.astro's resolver: url -> localStorage -> 'en'.
    // Header owns writing `siteLang`; this is a subscriber, so it only reads.
    const getActiveLang = () => {
      const inUrl = getLangFromUrl();
      if (inUrl) return inUrl;
      const stored = localStorage.getItem('siteLang');
      if (stored === 'en' || stored === 'es') return stored;
      return 'en';
    };

    // All copy ships in the markup as data-copy-es/-en and data-alt-es/-en
    // (images), including inside HeadedTextBlock.astro — its markup lands
    // inside this shell, so this one subscriber covers it too (see
    // WarrantySection.astro for the same rationale). document.title and the
    // meta description are swapped too, from data attributes on the shell.
    const applyWhyPolicraftersLanguage = (lang) => {
      const key = lang === 'en' ? 'en' : 'es';

      shell.querySelectorAll('[data-copy-es]').forEach((el) => {
        const value = el.getAttribute('data-copy-' + key);
        if (value !== null) el.textContent = value;
      });

      shell.querySelectorAll('[data-alt-es]').forEach((el) => {
        const value = el.getAttribute('data-alt-' + key);
        if (value !== null) el.setAttribute('alt', value);
      });

      const title = shell.getAttribute('data-seo-title-' + key);
      if (title) document.title = title;

      const description = shell.getAttribute('data-seo-description-' + key);
      if (description !== null) {
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) metaDescription.setAttribute('content', description);
      }

      document.documentElement.lang = key;
    };

    // Subscriber only. Header.astro owns lang state, the .lang-link handlers, and the
    // sitelangchange dispatch. This script never dispatches sitelangchange and never
    // writes localStorage.siteLang — re-dispatching would turn Header's boot into a
    // feedback loop. Self-boot first, since Header's boot dispatch fires before this
    // page script runs (see warranty.astro/services.astro for the same pattern).
    applyWhyPolicraftersLanguage(getActiveLang());
    document.addEventListener('sitelangchange', (event) => applyWhyPolicraftersLanguage(event.detail));
  }
</script>

<style>
  .why-shell {
    display: grid;
    gap: 0;
  }

  /* Full-bleed technique reused from services.astro/collections.astro: breaks
     out of the ~1100px .page-shell (see PageLayout.astro's :root --max) to
     span the full viewport. Safe because PageLayout's body has
     `overflow-x: clip`. */
  .why-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .why-bleed img {
    width: 100%;
    height: clamp(320px, 45vw, 720px);
    object-fit: cover;
    display: block;
  }

  /* Cancels PageLayout.astro's `.page-shell { padding: 3rem 0 4rem }` top
     padding so the hero image sits flush under Header instead of leaving a
     3rem gap above it. */
  .why-hero {
    margin-top: -3rem;
  }

  .why-intro {
    padding: 3rem 0 1rem;
    text-align: center;
  }

  /* Intro body is left-aligned and full container width, unlike
     services.astro's narrow centered intro text — matches the reference
     design for this section. */
  .why-intro__body {
    margin: 0 0 1.25rem;
    text-align: left;
    line-height: 1.6;
    color: #333;
    font-size: .95rem;
  }

  .why-intro__body:last-child {
    margin-bottom: 0;
  }

  /* Reused verbatim from services.astro's eyebrow + heading recipe, which
     itself copies index.astro. Neither rule sets font-family: both inherit
     Arimo from PageLayout.astro. */
  .section-eyebrow {
    margin: 0 0 .4rem;
    font-style: italic;
    font-size: .95rem;
    color: #555;
  }

  .section-heading {
    margin: 0 0 2.5rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #B6AE99;
  }

  .why-section {
    padding: 3.5rem 0;
  }

  .why-section__intro {
    text-align: center;
  }

  /* Matches index.astro's divider; .why-shell's spacing does not reach
     outside it, so the spacing around the rule is set explicitly here —
     same values as services.astro's .section-rule. */
  .section-rule {
    width: min(var(--max), 92%);
    margin: 0 auto;
    border: none;
    border-top: 1px solid #2f3437;
  }

  /* --- Section 3: Certifications --- */

  .why-cert-image-wrap {
    margin-bottom: 2.5rem;
  }

  .why-cert-image {
    width: 100%;
    height: clamp(220px, 28vw, 380px);
    object-fit: cover;
    display: block;
  }

  .why-cert-eyebrow {
    font-variant: small-caps;
  }

  .why-cert-body {
    max-width: none;
    margin: 0 0 1.25rem;
    text-align: left;
    line-height: 1.6;
    color: #333;
    font-size: .95rem;
  }

  .why-cert-body:last-of-type {
    margin-bottom: 2.5rem;
  }

  /* Credentials grid: one column per license across all issuers. Each
     issuer's logo cell spans its own license count (--issuer-span), so
     DBPR's logo (2 licenses) sits centered over its two columns while AIA
     and NGA (1 license each) sit over a single column — see
     Docs/API_CONTRACT.md § WhyPolicraftersPage. */
  .why-credentials {
    display: grid;
    grid-template-columns: repeat(var(--credential-columns), minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .why-credentials__issuer {
    display: contents;
  }

  .why-credentials__logo-cell {
    grid-column: span var(--issuer-span);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-credentials__logo {
    max-width: 100%;
    max-height: 90px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .why-credentials__license {
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
    text-align: center;
  }

  .why-credentials__label {
    margin: 0;
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #2f3437;
    font-size: 1.1rem;
  }

  .why-credentials__number {
    margin: 0;
    width: 100%;
    max-width: 180px;
    padding: .25rem .75rem;
    background: #B6AE99;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    text-align: center;
  }

  .why-credentials__caption {
    margin: 0;
    font-weight: 700;
    color: #333;
    font-size: .9rem;
  }

  @media (max-width: 900px) {
    .why-credentials {
      grid-template-columns: repeat(min(var(--credential-columns), 2), minmax(0, 1fr));
    }

    .why-credentials__logo-cell {
