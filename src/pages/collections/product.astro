---
// Legacy redirect only: /collections/product?slug=<slug> used to be the one
// static product page for every model. Real products now live at
// /collections/<category>/<type>/<model> (see [...slug].astro /
// src/views/ProductPage.astro), so this just forwards old links/bookmarks to
// the right one — noindex, excluded from the sitemap (astro.config.mjs).
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout lang="en" title="Policrafters" showHero={false} noindex>
  <p>Redirecting…</p>
</PageLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug') || '';
  if (slug) {
    const canonicalSlug = slug.split('/').filter(Boolean).map((segment) => encodeURIComponent(segment)).join('/');
    window.location.replace(`/collections/${canonicalSlug}`);
  } else {
    window.location.replace('/collections');
  }
</script>
