---
// English product routes: /collections/<category>/<type>/<model>. The Spanish
// twin is src/pages/es/collections/[...slug].astro, built from the es listing —
// see src/views/ProductPage.astro for the shared rendering.
import collectionsEnMock from '../../mocks/collections-page.en.json';
import { toDevApiUrl } from '../../lib/dev-proxy';
import { withLocaleParam } from '../../lib/i18n';
import ProductPage from '../../views/ProductPage.astro';

export async function getStaticPaths() {
  const getSlugsFromPayload = (payload: any): string[] => {
    const seen = new Set<string>();
    const categories = Array.isArray(payload?.fields?.categories) ? payload.fields.categories : [];

    return categories.flatMap((category: any) => {
      const types = Array.isArray(category?.types) ? category.types : [];
      return types.flatMap((type: any) => {
        const products = Array.isArray(type?.products) ? type.products : [];
        return products
          .map((product: any) => String(product?.slug || '').trim())
          .filter((slug) => slug && !seen.has(slug) && seen.add(slug));
      });
    });
  };

  const useApi = import.meta.env.PUBLIC_USE_API === 'true';
  const collectionsApiUrl = toDevApiUrl(import.meta.env.PUBLIC_COLLECTIONS_API_URL || '', 'server');

  if (useApi && collectionsApiUrl) {
    try {
      const response = await fetch(withLocaleParam(collectionsApiUrl, 'en'));
      if (response.ok) {
        const payload = await response.json();
        const slugs = getSlugsFromPayload(payload);
        if (slugs.length) {
          return slugs.map((slug) => ({ params: { slug } }));
        }
      }
    } catch (error) {
      console.warn('No se pudo generar static paths desde la API de colecciones. Usando fallback local.', error);
    }
  }

  const slugs = getSlugsFromPayload(collectionsEnMock);
  return slugs.map((slug) => ({ params: { slug } }));
}

const requestedSlug = Astro.params.slug || '';
---

<ProductPage lang="en" slug={requestedSlug} />
