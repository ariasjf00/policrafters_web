---
import home from "../mocks/home.json";

const useApi = import.meta.env.PUBLIC_USE_API === "true";
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/home/";
const apiOrigin = apiUrl.startsWith("http") ? new URL(apiUrl).origin : "";
const normalizeAssetUrl = (value) => {
	if (!value) return "";
	if (/^https?:\/\//i.test(value)) return value;
	if (value.startsWith("/")) {
		return apiOrigin ? `${apiOrigin}${value}` : value;
	}
	return value;
};
let data = home;

if (useApi) {
	try {
		const response = await fetch(apiUrl);
		if (response.ok) {
			const payload = await response.json();
			if (payload && typeof payload === "object") {
				data = payload;
			}
		}
	} catch (error) {
		console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
	}
}

const resolvedData = data ?? home;
const resolvedFields = resolvedData.fields ?? home.fields ?? {};
const resolvedMeta = resolvedData.meta ?? home.meta ?? {};
const fallbackFields = home.fields ?? {};
const featuredProjects = Array.isArray(resolvedFields.featured_projects) ? resolvedFields.featured_projects : [];
const featuredBrands = Array.isArray(resolvedFields.featured_brands) ? resolvedFields.featured_brands : [];
const testimonials = Array.isArray(resolvedFields.testimonials) ? resolvedFields.testimonials : [];
const heroHeading = resolvedFields.hero_heading || resolvedData.title || fallbackFields.hero_heading || "Home";
const heroSubheading = resolvedFields.hero_subheading || fallbackFields.hero_subheading || "";
const introText = (resolvedFields.intro_text || fallbackFields.intro_text || "")
	.replace(/<[^>]*>/g, "")
	.replace(/&nbsp;/g, " ")
	.trim();
const heroVideoUrl = resolvedFields.hero_video_url || fallbackFields.hero_video_url || "https://www.w3schools.com/html/mov_bbb.mp4";
const heroImageUrl = resolvedFields.hero_image_fallback?.url || fallbackFields.hero_image_fallback?.url || "/images/hero-fallback.svg";
const heroImageAlt = resolvedFields.hero_image_fallback?.alt || fallbackFields.hero_image_fallback?.alt || "Policrafters";
const siteLogoCandidate = resolvedFields.site_logo ?? resolvedFields.logo ?? resolvedFields.header_logo ?? fallbackFields.site_logo ?? fallbackFields.logo ?? fallbackFields.header_logo;
const siteLogo = typeof siteLogoCandidate === "string"
	? { url: normalizeAssetUrl(siteLogoCandidate), alt: "Policrafters logo" }
	: siteLogoCandidate?.url
		? { url: normalizeAssetUrl(siteLogoCandidate.url), alt: siteLogoCandidate.alt || "Policrafters logo" }
		: { url: "/logo_black.png", alt: "Policrafters logo" };
const ctaHeading = resolvedFields.cta_heading || fallbackFields.cta_heading || "";
const ctaButtonText = resolvedFields.cta_button_text || fallbackFields.cta_button_text || "Contáctanos";
const ctaButtonUrl = resolvedFields.cta_button_url || fallbackFields.cta_button_url || "/contacto";
const normalizedLocale = typeof resolvedData.locale === "string" ? resolvedData.locale.toLowerCase() : "";
const isEs = normalizedLocale.includes("es") || normalizedLocale.includes("español");
const menu = isEs
	? [
			{ label: "Inicio", href: "/" },
			{ label: "Proyectos", href: "/proyectos" },
			{ label: "Colecciones", href: "/colecciones" },
			{ label: "Marcas", href: "/marcas" },
			{ label: "Contacto", href: "/contacto" }
		]
	: [
			{ label: "Home", href: "/" },
			{ label: "Projects", href: "/projects" },
			{ label: "Collections", href: "/collections" },
			{ label: "Brands", href: "/brands" },
			{ label: "Contact", href: "/contact" }
		];
---

<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{resolvedMeta.seo_title || resolvedData.title || home.title}</title>
		<meta name="description" content={resolvedMeta.search_description || ""} />
	</head>
	<body data-api-url={apiUrl}>
		<header class="site-header">
			<a class="logo" href="/">
				<img id="site-logo" src={siteLogo.url} alt={siteLogo.alt} />
			</a>
			<nav aria-label="Main navigation">
				<ul>
					{menu.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>
		</header>

		<section class="hero">
			{heroVideoUrl ? (
				<video
					class="hero-media"
					autoplay
					muted
					loop
					playsinline
					poster={heroImageUrl}
				>
					<source src={heroVideoUrl} type="video/mp4" />
				</video>
			) : (
				<img
					class="hero-media"
					src={heroImageUrl}
					alt={heroImageAlt}
					loading="eager"
				/>
			)}
			<div class="hero-overlay" />
			<div class="hero-content">
				<p class="eyebrow">Policrafters</p>
				<h1 id="hero-heading">{heroHeading}</h1>
				<p id="hero-subheading">{heroSubheading}</p>
			</div>
		</section>

		<main>
			<section class="container intro">
				<p id="intro-text">{introText}</p>
			</section>

			<section class="container">
				<h2>{isEs ? "Proyectos destacados" : "Featured projects"}</h2>
				<div class="grid projects">
					{featuredProjects.map((p) => (
						<article class="card">
							<img src={p.thumbnail.url} alt={p.thumbnail.alt} loading="lazy" />
							<div class="card-body">
								<h3>{p.title}</h3>
								<p>{p.location}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="container brands">
				<h2>{isEs ? "Marcas" : "Brands"}</h2>
				<div class="brand-row">
					{featuredBrands.map((b) => (
						<img src={b.logo.url} alt={b.logo.alt} loading="lazy" />
					))}
				</div>
			</section>

			<section class="container testimonials">
				<h2>{isEs ? "Testimonios" : "Testimonials"}</h2>
				{testimonials.map((t) => (
					<blockquote>
						“{t.quote}”
						<cite>{t.author}</cite>
					</blockquote>
				))}
			</section>

			<section class="cta">
				<div class="container cta-inner">
					<h2>{ctaHeading}</h2>
					<a class="btn" href={ctaButtonUrl}>{ctaButtonText}</a>
				</div>
			</section>
		</main>
		<script type="module">
			const body = document.body;
			const apiUrl = body?.dataset?.apiUrl;
			const setText = (selector, value) => {
				const element = document.querySelector(selector);
				if (element && value != null) {
					element.textContent = value;
				}
			};

			const setAttributeIfPresent = (selector, attribute, value) => {
				const element = document.querySelector(selector);
				if (element && value) {
					element.setAttribute(attribute, value);
				}
			};

			const applyApiData = (data) => {
				const fields = data?.fields ?? {};
				const meta = data?.meta ?? {};
				if (data?.title) {
					document.title = meta.seo_title || data.title;
				}
				if (meta.search_description) {
					document.querySelector('meta[name="description"]')?.setAttribute('content', meta.search_description);
				}
				setText('#hero-heading', fields.hero_heading);
				setText('#hero-subheading', fields.hero_subheading);
				setText('#intro-text', fields.intro_text);
				const siteLogoFromApi = fields.site_logo ?? fields.logo ?? fields.header_logo;
				if (siteLogoFromApi) {
					const logoUrl = typeof siteLogoFromApi === 'string' ? normalizeAssetUrl(siteLogoFromApi) : normalizeAssetUrl(siteLogoFromApi?.url);
					const logoAlt = typeof siteLogoFromApi === 'string' ? 'Policrafters logo' : siteLogoFromApi?.alt || 'Policrafters logo';
					const logoElement = document.querySelector('#site-logo');
					if (logoElement) {
						logoElement.setAttribute('src', logoUrl);
						logoElement.setAttribute('alt', logoAlt);
					}
				}
				setAttributeIfPresent('#hero-image', 'src', fields.hero_image_fallback?.url);
				setAttributeIfPresent('#hero-image', 'alt', fields.hero_image_fallback?.alt);
				const heroMedia = document.querySelector('#hero-media');
				if (heroMedia && fields.hero_video_url) {
					heroMedia.setAttribute('src', fields.hero_video_url);
				}
			};

			if (apiUrl) {
				fetch(apiUrl, { cache: 'no-store' })
					.then((response) => {
						if (!response.ok) throw new Error(`HTTP ${response.status}`);
						return response.json();
					})
					.then(applyApiData)
					.catch((error) => {
						console.warn('No se pudo cargar la API de Wagtail:', error);
					});
			}
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0f0f10;
		--text: #111;
		--muted: #666;
		--max: 1200px;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		color: var(--text);
		background: #fff;
	}

	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		width: 100%;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,0));
	}

	.logo img { height: 34px; width: auto; display: block; }

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.2rem;
	}
	nav a {
		color: #fff;
		text-decoration: none;
		font-weight: 500;
		letter-spacing: .02em;
	}

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
		background: #000;
	}
	.hero-media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.15));
	}
	.hero-content {
		position: absolute;
		left: 8%;
		bottom: 12%;
		color: #fff;
		max-width: 760px;
	}
	.hero-content .eyebrow {
		margin: 0 0 .5rem;
		text-transform: uppercase;
		letter-spacing: .12em;
		font-size: .82rem;
		opacity: .9;
	}
	.hero-content h1 {
		margin: 0 0 .8rem;
		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 1.05;
	}
	.hero-content p {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.3rem);
		max-width: 65ch;
	}

	.container {
		width: min(var(--max), 92%);
		margin-inline: auto;
		padding: 4rem 0;
	}

	.intro p {
		font-size: 1.2rem;
		color: #333;
		max-width: 70ch;
	}

	.grid.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}
	.card {
		border: 1px solid #ececec;
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
	}
	.card img {
		width: 100%;
		aspect-ratio: 16/10;
		object-fit: cover;
		display: block;
	}
	.card-body { padding: 1rem; }
	.card-body h3 { margin: 0 0 .35rem; }
	.card-body p { margin: 0; color: var(--muted); }

	.brand-row {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		align-items: center;
	}
	.brand-row img {
		height: 30px;
		width: auto;
		opacity: .9;
	}

	.testimonials blockquote {
		margin: 0;
		padding: 1.25rem;
		border-left: 3px solid #111;
		background: #f8f8f8;
	}
	.testimonials cite {
		display: block;
		margin-top: .7rem;
		color: var(--muted);
		font-style: normal;
	}

	.cta {
		background: var(--bg);
		color: #fff;
	}
	.cta-inner {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
	}
	.btn {
		display: inline-block;
		padding: .8rem 1.2rem;
		background: #fff;
		color: #111;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.site-header { padding: .9rem 1rem; }
		nav ul { gap: .8rem; font-size: .92rem; }
		.cta-inner { flex-direction: column; align-items: flex-start; }
	}
</style>
