---
import home from "../mocks/home.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from 'astro-icon/components';
import "../styles/links.css";

const useApi = import.meta.env.PUBLIC_USE_API === "true";
const apiUrl = import.meta.env.PUBLIC_API_URL || "";
const apiOrigin = apiUrl && apiUrl.startsWith("http") ? new URL(apiUrl).origin : "";
const langParam = Astro.url.searchParams.get("lang")?.toLowerCase();
const requestedLang = langParam === "es" ? "es" : "en";
const apiRequestUrl = (() => {
	if (!apiUrl) return "";
	try {
		const url = new URL(apiUrl);
		url.searchParams.set("lang", requestedLang);
		return url.toString();
	} catch {
		return apiUrl;
	}
})();
const normalizeAssetUrl = (value) => {
	if (!value) return "";
	if (/^https?:\/\//i.test(value)) return value;
	if (value.startsWith("/")) {
		return apiOrigin ? `${apiOrigin}${value}` : value;
	}
	return value;
};
let data = home;

if (useApi && apiUrl) {
	try {
		const response = await fetch(apiRequestUrl || apiUrl);
		if (response.ok) {
			const payload = await response.json();
			if (payload && typeof payload === "object") {
				data = payload;
			}
		}
	} catch (error) {
		console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
	}
}

const resolvedData = data ?? home;
const resolvedFields = resolvedData.fields ?? home.fields ?? {};
const resolvedMeta = resolvedData.meta ?? home.meta ?? {};
const fallbackFields = home.fields ?? {};
const featuredProjects = Array.isArray(resolvedFields.featured_projects) ? resolvedFields.featured_projects : [];
const heroHeading = resolvedFields.hero_heading || resolvedData.title || fallbackFields.hero_heading || "Home";
// Only CMS-provided paths need the API origin; local /public assets are served as-is.
const heroAsset = (apiValue, localValue) => (useApi && apiValue ? normalizeAssetUrl(apiValue) : localValue);
const teamMembersRaw = Array.isArray(resolvedFields.team_members) && resolvedFields.team_members.length
	? resolvedFields.team_members
	: (fallbackFields.team_members ?? []);
const teamMembers = teamMembersRaw.map((member) => ({
	...member,
	photo: {
		url: heroAsset(member.photo?.url, member.photo?.url),
		alt: member.photo?.alt || ""
	}
}));
const valuesSlidesRaw = Array.isArray(resolvedFields.values_slides) && resolvedFields.values_slides.length
	? resolvedFields.values_slides
	: (fallbackFields.values_slides ?? []);
const valuesSlides = valuesSlidesRaw.map((slide) => ({
	...slide,
	image: {
		url: heroAsset(slide.image?.url, slide.image?.url),
		alt: slide.image?.alt || ""
	}
}));
const catalogsRaw = Array.isArray(resolvedFields.catalogs) && resolvedFields.catalogs.length
	? resolvedFields.catalogs
	: (fallbackFields.catalogs ?? []);
const catalogs = catalogsRaw.map((item) => ({
	...item,
	image: {
		url: heroAsset(item.image?.url, item.image?.url),
		alt: item.image?.alt || ""
	}
}));
const contactLinks = Array.isArray(resolvedFields.contact_links) && resolvedFields.contact_links.length
	? resolvedFields.contact_links
	: (fallbackFields.contact_links ?? []);
const heroVideoHorizontal = heroAsset(
	resolvedFields.hero_video_horizontal,
	fallbackFields.hero_video_horizontal || "/videos/horizontal_video_placeholder.mp4"
);
const heroVideoVertical = heroAsset(
	resolvedFields.hero_video_vertical,
	fallbackFields.hero_video_vertical || "/videos/vertical_video_placeholder.mp4"
);
const heroImageHorizontal = heroAsset(
	resolvedFields.hero_image_horizontal?.url,
	fallbackFields.hero_image_horizontal?.url || "/images/pages/horizontal_video_static_image.png"
);
const heroImageVertical = heroAsset(
	resolvedFields.hero_image_vertical?.url,
	fallbackFields.hero_image_vertical?.url || "/images/pages/vertical_video_static_image.png"
);
const heroImageAlt = resolvedFields.hero_image_horizontal?.alt || fallbackFields.hero_image_horizontal?.alt || "Policrafters";
const siteLogoCandidate = resolvedFields.site_logo ?? resolvedFields.logo ?? resolvedFields.header_logo ?? fallbackFields.site_logo ?? fallbackFields.logo ?? fallbackFields.header_logo;
const siteLogo = typeof siteLogoCandidate === "string"
	? { url: normalizeAssetUrl(siteLogoCandidate), alt: "Policrafters logo" }
	: siteLogoCandidate?.url
		? { url: normalizeAssetUrl(siteLogoCandidate.url), alt: siteLogoCandidate.alt || "Policrafters logo" }
		: { url: "/logo_black.png", alt: "Policrafters logo" };
const selectedLang = requestedLang;
const isEs = selectedLang === "es";

const localCopyByKey = home.fields?.copy ?? {};
const copyByKey = resolvedFields.copy ?? {};
const getStructuredText = (value, lang, fallback = "") => {
	if (!value || typeof value !== "object") return fallback;
	const candidate = value[lang] ?? value.es ?? value.en ?? fallback;
	if (typeof candidate === "string" && candidate.trim()) return candidate;
	return fallback;
};
const getCopyText = (key, fallback = "") => {
	const localCopyValue = localCopyByKey[key];
	const copyValue = copyByKey[key];
	const localText = getStructuredText(localCopyValue, selectedLang, fallback);
	if (copyValue && typeof copyValue === "object") {
		const apiText = getStructuredText(copyValue, selectedLang, localText);
		const apiEs = typeof copyValue.es === "string" ? copyValue.es.trim() : "";
		const apiEn = typeof copyValue.en === "string" ? copyValue.en.trim() : "";
		if (apiEs && apiEn && apiEs !== apiEn) return apiText;
		return localText;
	}
	const directValue = resolvedFields[key];
	if (typeof directValue === "string") return directValue || localText;
	if (directValue && typeof directValue === "object") {
		return getStructuredText(directValue, selectedLang, localText);
	}
	return localText;
};
const localizedHeroHeading = getCopyText("hero_heading", heroHeading || "Home");
const localizedHeroEyebrow = getCopyText("hero_eyebrow", "");
const localizedHeroCta = getCopyText("hero_cta", "");
const localizedProjectsEyebrow = getCopyText("projects_eyebrow", "");
const localizedProjectsHeading = getCopyText("projects_heading", "");
const localizedProjectsCta = getCopyText("projects_cta", "");
const localizedAboutEyebrow = getCopyText("about_eyebrow", "");
const localizedAboutHeading = getCopyText("about_heading", "");
const localizedAboutCta = getCopyText("about_cta", "");
const localizedTeamEyebrow = getCopyText("team_eyebrow", "");
const localizedTeamHeading = getCopyText("team_heading", "");
const localizedValuesEyebrow = getCopyText("values_eyebrow", "");
const localizedValuesHeading = getCopyText("values_heading", "");
const localizedCatalogsEyebrow = getCopyText("catalogs_eyebrow", "");
const localizedCatalogsHeading = getCopyText("catalogs_heading", "");
const localizedContactHeading = getCopyText("contact_heading", "");
const localizedContactCta = getCopyText("contact_cta", "");
const localizedAboutBody1 = getCopyText("about_body_1", "");
const localizedAboutBody2 = getCopyText("about_body_2", "");
const localizedAboutBrandsLabel = getCopyText("about_brands_label", "");
const localizedAboutAlt = isEs ? 'Equipo de Policrafters' : 'The Policrafters team';
const localizedProjectsPrevAria = getCopyText("projects_prev_aria", "");
const localizedProjectsNextAria = getCopyText("projects_next_aria", "");
const localizedProjectsCarouselAria = getCopyText("projects_carousel_aria", "");
const localizedProjectsDotAria = getCopyText("projects_dot_aria", "");
const localizedValuesPrevAria = getCopyText("values_prev_aria", "");
const localizedValuesNextAria = getCopyText("values_next_aria", "");
const localizedValuesCarouselAria = getCopyText("values_carousel_aria", "");
const localizedValuesDotAria = getCopyText("values_dot_aria", "");
const localizedCatalogsPrevAria = getCopyText("catalogs_prev_aria", "");
const localizedCatalogsNextAria = getCopyText("catalogs_next_aria", "");
const localizedCatalogsDotAria = getCopyText("catalogs_dot_aria", "");
const heroCtaUrl = '/contacto';
---

<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script is:inline>
			(() => {
				const params = new URLSearchParams(window.location.search);
				const urlLang = params.get('lang');
				const lang = urlLang === 'es' ? 'es' : 'en';
				window.__SITE_LANG__ = lang;
				localStorage.setItem('siteLang', lang);
				document.documentElement.lang = lang;
			})();
		</script>
		<title>{resolvedMeta.seo_title || resolvedData.title || home.title}</title>
		<meta name="description" content={resolvedMeta.search_description || ""} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body data-api-url={apiUrl} data-api-url-lang={apiRequestUrl || apiUrl}>
		<Header lang={selectedLang} logo={siteLogo} position="fixed" scrollShadow />

		<section class="hero">
			<picture class="hero-poster">
				<source media="(max-width: 900px)" srcset={heroImageVertical} />
				<img src={heroImageHorizontal} alt={heroImageAlt} loading="eager" fetchpriority="high" />
			</picture>
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				preload="none"
				aria-hidden="true"
				data-src-horizontal={heroVideoHorizontal}
				data-src-vertical={heroVideoVertical}
			></video>
			<div class="hero-overlay" />
			<div class="hero-content">
				<p id="hero-eyebrow" class="eyebrow" data-i18n data-es={resolvedFields.copy?.hero_eyebrow?.es || localizedHeroEyebrow} data-en={resolvedFields.copy?.hero_eyebrow?.en || localizedHeroEyebrow}>{localizedHeroEyebrow}</p>
				<h1 id="hero-heading" data-i18n data-es={resolvedFields.copy?.hero_heading?.es || localizedHeroHeading} data-en={resolvedFields.copy?.hero_heading?.en || localizedHeroHeading}>{localizedHeroHeading}</h1>
				<a id="hero-cta" class="hero-cta-btn" href={heroCtaUrl} data-i18n data-es={resolvedFields.copy?.hero_cta?.es || localizedHeroCta} data-en={resolvedFields.copy?.hero_cta?.en || localizedHeroCta}>{localizedHeroCta}</a>
			</div>
		</section>

		<main>
			<section class="projects-section">
				<p id="projects-eyebrow" class="section-eyebrow" data-i18n data-es={resolvedFields.copy?.projects_eyebrow?.es || localizedProjectsEyebrow} data-en={resolvedFields.copy?.projects_eyebrow?.en || localizedProjectsEyebrow}>{localizedProjectsEyebrow}</p>
				<h2 id="projects-heading" class="section-heading" data-i18n data-es={resolvedFields.copy?.projects_heading?.es || localizedProjectsHeading} data-en={resolvedFields.copy?.projects_heading?.en || localizedProjectsHeading}>{localizedProjectsHeading}</h2>

				<div class="projects-carousel-shell">
					<div class="projects-carousel-viewport">
						<div class="projects-carousel-controls" aria-hidden="true">
							<button id="projects-prev" class="projects-arrow-btn" data-action="prev" disabled aria-label={localizedProjectsPrevAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_prev_aria?.es || localizedProjectsPrevAria} data-aria-en={resolvedFields.copy?.projects_prev_aria?.en || localizedProjectsPrevAria}>
								<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#fff" /></svg>
							</button>
							<button id="projects-next" class="projects-arrow-btn" data-action="next" aria-label={localizedProjectsNextAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_next_aria?.es || localizedProjectsNextAria} data-aria-en={resolvedFields.copy?.projects_next_aria?.en || localizedProjectsNextAria}>
								<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#fff" /></svg>
							</button>
						</div>

						<div class="projects-carousel" id="projects-carousel" aria-label={localizedProjectsCarouselAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_carousel_aria?.es || localizedProjectsCarouselAria} data-aria-en={resolvedFields.copy?.projects_carousel_aria?.en || localizedProjectsCarouselAria}>
							{featuredProjects.map((p, index) => (
								<a href="#" class="projects-card" data-project-index={index}>
									<img src={p.thumbnail.url} alt={p.thumbnail.alt} loading="lazy" />
									<div class="projects-card__body">
										<h3 class="projects-card__title" data-i18n data-es={p.title_es || p.title} data-en={p.title_en || p.title}>{isEs ? (p.title_es || p.title) : (p.title_en || p.title)}</h3>
										<p class="projects-card__description" data-i18n data-es={p.description_es || p.description} data-en={p.description_en || p.description}>{isEs ? (p.description_es || p.description) : (p.description_en || p.description)}</p>
									</div>
								</a>
							))}
						</div>
					</div>

					<div class="projects-indicator" id="projects-indicator" role="tablist" aria-label={localizedProjectsCarouselAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_carousel_aria?.es || localizedProjectsCarouselAria} data-aria-en={resolvedFields.copy?.projects_carousel_aria?.en || localizedProjectsCarouselAria}>
						<button type="button" class="projects-indicator-arrow" data-action="prev" disabled aria-label={localizedProjectsPrevAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_prev_aria?.es || localizedProjectsPrevAria} data-aria-en={resolvedFields.copy?.projects_prev_aria?.en || localizedProjectsPrevAria}>
							<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
						</button>
						<div class="projects-dots" id="projects-dots" data-dot-aria-es={resolvedFields.copy?.projects_dot_aria?.es || localizedProjectsDotAria} data-dot-aria-en={resolvedFields.copy?.projects_dot_aria?.en || localizedProjectsDotAria}>
							{featuredProjects.map((_, index) => (
								<button
									type="button"
									class:list={["projects-dot", index === 0 && "is-active"]}
									data-dot-index={index}
									aria-label={localizedProjectsDotAria + ' ' + (index + 1)}
									data-aria-i18n
									data-aria-es={(resolvedFields.copy?.projects_dot_aria?.es || localizedProjectsDotAria) + ' ' + (index + 1)}
									data-aria-en={(resolvedFields.copy?.projects_dot_aria?.en || localizedProjectsDotAria) + ' ' + (index + 1)}
								></button>
							))}
						</div>
						<button type="button" class="projects-indicator-arrow" data-action="next" aria-label={localizedProjectsNextAria} data-aria-i18n data-aria-es={resolvedFields.copy?.projects_next_aria?.es || localizedProjectsNextAria} data-aria-en={resolvedFields.copy?.projects_next_aria?.en || localizedProjectsNextAria}>
							<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
						</button>
					</div>
				</div>

				<a id="projects-cta" href="#" class="projects-cta-btn" data-i18n data-es={resolvedFields.copy?.projects_cta?.es || localizedProjectsCta} data-en={resolvedFields.copy?.projects_cta?.en || localizedProjectsCta}>{localizedProjectsCta}</a>
			</section>

			<hr class="section-rule" />

			<section class="container about-section">
				<div class="about-grid">
					<img
						class="about-image"
						src="/images/pages/about_us.png"
						alt={localizedAboutAlt}
						loading="lazy"
					/>
					<div class="about-copy">
						<p id="about-eyebrow" class="section-eyebrow" data-i18n data-es={resolvedFields.copy?.about_eyebrow?.es || localizedAboutEyebrow} data-en={resolvedFields.copy?.about_eyebrow?.en || localizedAboutEyebrow}>{localizedAboutEyebrow}</p>
						<h2 id="about-heading" class="section-heading" data-i18n data-es={resolvedFields.copy?.about_heading?.es || localizedAboutHeading} data-en={resolvedFields.copy?.about_heading?.en || localizedAboutHeading}>{localizedAboutHeading}</h2>
						<p id="about-body-1" data-i18n data-es={resolvedFields.copy?.about_body_1?.es || localizedAboutBody1} data-en={resolvedFields.copy?.about_body_1?.en || localizedAboutBody1}>{localizedAboutBody1}</p>
						<p id="about-body-2" data-i18n data-es={resolvedFields.copy?.about_body_2?.es || localizedAboutBody2} data-en={resolvedFields.copy?.about_body_2?.en || localizedAboutBody2}>{localizedAboutBody2}</p>
						<p id="about-brands-label" class="about-brands-label" data-i18n data-es={resolvedFields.copy?.about_brands_label?.es || localizedAboutBrandsLabel} data-en={resolvedFields.copy?.about_brands_label?.en || localizedAboutBrandsLabel}>{localizedAboutBrandsLabel}</p>
						<ul class="about-brands-list">
							<li><a href="https://glasstech-usa.com" target="_blank" rel="noopener" class="link-body">glasstech-usa.com</a></li>
							<li><a href="https://alutech-usa.com" target="_blank" rel="noopener" class="link-body">alutech-usa.com</a></li>
						</ul>
						<a id="about-cta" href="#" class="about-cta-btn" data-i18n data-es={resolvedFields.copy?.about_cta?.es || localizedAboutCta} data-en={resolvedFields.copy?.about_cta?.en || localizedAboutCta}>{localizedAboutCta}</a>
					</div>
				</div>
			</section>

			<hr class="section-rule" />

			<section class="container team-section">
				<p id="team-eyebrow" class="section-eyebrow" data-i18n data-es={resolvedFields.copy?.team_eyebrow?.es || localizedTeamEyebrow} data-en={resolvedFields.copy?.team_eyebrow?.en || localizedTeamEyebrow}>{localizedTeamEyebrow}</p>
				<h2 id="team-heading" class="section-heading" data-i18n data-es={resolvedFields.copy?.team_heading?.es || localizedTeamHeading} data-en={resolvedFields.copy?.team_heading?.en || localizedTeamHeading}>{localizedTeamHeading}</h2>

				<div class="team-grid">
					{teamMembers.map((member) => (
						<div class="team-card">
							<img
								class="team-card__photo"
								src={member.photo.url}
								alt={member.photo.alt || (isEs ? "Integrante del equipo Policrafters" : "Policrafters team member")}
								loading="lazy"
							/>
							<div class="team-card__meta">
								<p
									class="team-card__role"
									data-i18n
									data-es={member.role_es || member.role}
									data-en={member.role_en || member.role}
								>
									{isEs ? (member.role_es || member.role) : (member.role_en || member.role)}
								</p>
								<p class="team-card__name">{member.name}</p>
							</div>
							<p
								class="team-card__bio"
								data-i18n
								data-es={member.bio_es || member.bio}
								data-en={member.bio_en || member.bio}
							>
								{isEs ? (member.bio_es || member.bio) : (member.bio_en || member.bio)}
							</p>
						</div>
					))}
				</div>
			</section>

			<hr class="section-rule" />

			<section class="values-section">
				<div class="values-header">
					<p id="values-eyebrow" class="section-eyebrow" data-i18n data-es={resolvedFields.copy?.values_eyebrow?.es || localizedValuesEyebrow} data-en={resolvedFields.copy?.values_eyebrow?.en || localizedValuesEyebrow}>{localizedValuesEyebrow}</p>
					<h2 id="values-heading" class="section-heading" data-i18n data-es={resolvedFields.copy?.values_heading?.es || localizedValuesHeading} data-en={resolvedFields.copy?.values_heading?.en || localizedValuesHeading}>{localizedValuesHeading}</h2>
				</div>

				<div class="values-slider" id="values-slider" aria-roledescription="carousel" aria-label={localizedValuesCarouselAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_carousel_aria?.es || localizedValuesCarouselAria} data-aria-en={resolvedFields.copy?.values_carousel_aria?.en || localizedValuesCarouselAria}>
					{valuesSlides.map((slide, index) => (
						<div class:list={["values-slide", index === 0 && "is-active"]} data-slide-index={index} aria-hidden={index === 0 ? "false" : "true"}>
							<img
								class="values-slide__image"
								src={slide.image.url}
								alt={slide.image.alt}
								loading={index === 0 ? "eager" : "lazy"}
							/>
							<div class="values-slide__caption">
								<h3
									class="values-slide__title"
									data-i18n
									data-es={slide.title_es || slide.title}
									data-en={slide.title_en || slide.title}
								>
									{isEs ? (slide.title_es || slide.title) : (slide.title_en || slide.title)}
								</h3>
								<p
									class="values-slide__description"
									data-i18n
									data-es={slide.description_es || slide.description}
									data-en={slide.description_en || slide.description}
								>
									{isEs ? (slide.description_es || slide.description) : (slide.description_en || slide.description)}
								</p>
							</div>
						</div>
					))}

					<div class="values-slider-controls" aria-hidden="true">
						<button id="values-prev" class="values-arrow-btn" data-action="prev" aria-label={localizedValuesPrevAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_prev_aria?.es || localizedValuesPrevAria} data-aria-en={resolvedFields.copy?.values_prev_aria?.en || localizedValuesPrevAria}>
							<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#fff" /></svg>
						</button>
						<button id="values-next" class="values-arrow-btn" data-action="next" aria-label={localizedValuesNextAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_next_aria?.es || localizedValuesNextAria} data-aria-en={resolvedFields.copy?.values_next_aria?.en || localizedValuesNextAria}>
							<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#fff" /></svg>
						</button>
					</div>
				</div>

				<div class="values-indicator" id="values-indicator" role="tablist" aria-label={localizedValuesCarouselAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_carousel_aria?.es || localizedValuesCarouselAria} data-aria-en={resolvedFields.copy?.values_carousel_aria?.en || localizedValuesCarouselAria}>
					<button type="button" class="values-indicator-arrow" data-action="prev" aria-label={localizedValuesPrevAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_prev_aria?.es || localizedValuesPrevAria} data-aria-en={resolvedFields.copy?.values_prev_aria?.en || localizedValuesPrevAria}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
					</button>
					<div class="values-dots" id="values-dots">
						{valuesSlides.map((_, index) => (
							<button
								type="button"
								class:list={["values-dot", index === 0 && "is-active"]}
								data-dot-index={index}
								aria-label={localizedValuesDotAria + ' ' + (index + 1)}
								data-aria-i18n
								data-aria-es={(resolvedFields.copy?.values_dot_aria?.es || localizedValuesDotAria) + ' ' + (index + 1)}
								data-aria-en={(resolvedFields.copy?.values_dot_aria?.en || localizedValuesDotAria) + ' ' + (index + 1)}
							></button>
						))}
					</div>
					<button type="button" class="values-indicator-arrow" data-action="next" aria-label={localizedValuesNextAria} data-aria-i18n data-aria-es={resolvedFields.copy?.values_next_aria?.es || localizedValuesNextAria} data-aria-en={resolvedFields.copy?.values_next_aria?.en || localizedValuesNextAria}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
					</button>
				</div>
			</section>

			<hr class="section-rule" />

			<section class="container catalogs-section">
				<p id="catalogs-eyebrow" class="section-eyebrow" data-i18n data-es={resolvedFields.copy?.catalogs_eyebrow?.es || localizedCatalogsEyebrow} data-en={resolvedFields.copy?.catalogs_eyebrow?.en || localizedCatalogsEyebrow}>{localizedCatalogsEyebrow}</p>
				<h2 id="catalogs-heading" class="section-heading" data-i18n data-es={resolvedFields.copy?.catalogs_heading?.es || localizedCatalogsHeading} data-en={resolvedFields.copy?.catalogs_heading?.en || localizedCatalogsHeading}>{localizedCatalogsHeading}</h2>

				<div class="catalogs-track" id="catalogs-track">
					{catalogs.map((item, index) => (
						<a class="catalog-card" href={item.file_url || "#"} data-catalog-index={index}>
							<img class="catalog-card__image" src={item.image.url} alt={item.image.alt} loading="lazy" />
							<span class="catalog-card__label">
								<span
									class="catalog-card__title"
									data-i18n
									data-es={item.title_es || item.title}
									data-en={item.title_en || item.title}
								>
									{isEs ? (item.title_es || item.title) : (item.title_en || item.title)}
								</span>
								<Icon name="mdi:download" class="catalog-card__icon" />
							</span>
						</a>
					))}
				</div>

				<div class="catalogs-indicator" id="catalogs-indicator" role="tablist" aria-label={localizedCatalogsEyebrow} data-aria-i18n data-aria-es={resolvedFields.copy?.catalogs_eyebrow?.es || localizedCatalogsEyebrow} data-aria-en={resolvedFields.copy?.catalogs_eyebrow?.en || localizedCatalogsEyebrow}>
					<button type="button" id="catalogs-prev" class="catalogs-indicator-arrow" data-action="prev" disabled aria-label={localizedCatalogsPrevAria} data-aria-i18n data-aria-es={resolvedFields.copy?.catalogs_prev_aria?.es || localizedCatalogsPrevAria} data-aria-en={resolvedFields.copy?.catalogs_prev_aria?.en || localizedCatalogsPrevAria}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
					</button>
					<div class="catalogs-dots" id="catalogs-dots">
						{Array.from({ length: Math.ceil(catalogs.length / 4) }, (_, index) => (
							<button
								type="button"
								class:list={["catalogs-dot", index === 0 && "is-active"]}
								data-dot-index={index}
								aria-label={localizedCatalogsDotAria + ' ' + (index + 1)}
								data-aria-i18n
								data-aria-es={(resolvedFields.copy?.catalogs_dot_aria?.es || localizedCatalogsDotAria) + ' ' + (index + 1)}
								data-aria-en={(resolvedFields.copy?.catalogs_dot_aria?.en || localizedCatalogsDotAria) + ' ' + (index + 1)}
							></button>
						))}
					</div>
					<button type="button" id="catalogs-next" class="catalogs-indicator-arrow" data-action="next" aria-label={localizedCatalogsNextAria} data-aria-i18n data-aria-es={resolvedFields.copy?.catalogs_next_aria?.es || localizedCatalogsNextAria} data-aria-en={resolvedFields.copy?.catalogs_next_aria?.en || localizedCatalogsNextAria}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
					</button>
				</div>

				<h2 id="contact-heading" class="contact-heading" data-i18n data-es={resolvedFields.copy?.contact_heading?.es || localizedContactHeading} data-en={resolvedFields.copy?.contact_heading?.en || localizedContactHeading}>{localizedContactHeading}</h2>

				<div class="contact-grid">
					{contactLinks.map((link) => (
						<div class="contact-col">
							<h3
								class="contact-col__title"
								data-i18n
								data-es={link.title_es || link.title}
								data-en={link.title_en || link.title}
							>
								{isEs ? (link.title_es || link.title) : (link.title_en || link.title)}
							</h3>
							<p
								class="contact-col__description"
								data-i18n
								data-es={link.description_es || link.description}
								data-en={link.description_en || link.description}
							>
								{isEs ? (link.description_es || link.description) : (link.description_en || link.description)}
							</p>
							<a class="contact-col__btn" href={link.url || "#"} data-lnbtn="1" data-i18n data-es={resolvedFields.copy?.contact_cta?.es || localizedContactCta} data-en={resolvedFields.copy?.contact_cta?.en || localizedContactCta}>{localizedContactCta}</a>
						</div>
					))}
				</div>
			</section>
		</main>

		<Footer lang={selectedLang} />

		<script type="module">
			const body = document.body;
			const apiUrl = body?.dataset?.apiUrl;
			const shouldUseCms = import.meta.env.PUBLIC_USE_API === 'true' && Boolean(apiUrl);
			const apiOrigin = (() => {
				try {
					return apiUrl && apiUrl.startsWith('http') ? new URL(apiUrl).origin : '';
				} catch {
					return '';
				}
			})();

			const normalizeAssetUrl = (value) => {
				if (!value) return '';
				if (/^https?:\/\//i.test(value)) return value;
				if (value.startsWith('/')) {
					return apiOrigin ? `${apiOrigin}${value}` : value;
				}
				return value;
			};

			const getLangFromUrl = () => {
				const params = new URLSearchParams(window.location.search);
				const lang = params.get('lang');
				return lang === 'en' || lang === 'es' ? lang : null;
			};

			const getActiveLang = () => {
				if (window.__SITE_LANG__ === 'en' || window.__SITE_LANG__ === 'es') {
					return window.__SITE_LANG__;
				}
				const urlLang = getLangFromUrl();
				if (urlLang) return urlLang;
				const storedLang = localStorage.getItem('siteLang');
				if (storedLang === 'en' || storedLang === 'es') return storedLang;
				localStorage.setItem('siteLang', 'en');
				return 'en';
			};

			const buildApiUrlForLang = (lang) => {
				if (!apiUrl) return '';
				const safeLang = lang === 'es' ? 'es' : 'en';
				try {
					const url = new URL(apiUrl);
					url.searchParams.set('lang', safeLang);
					return url.toString();
				} catch {
					return apiUrl;
				}
			};

			const resolveLocalizedText = (value, lang, fallback = '') => {
				if (typeof value === 'string') return value || fallback;
				if (value && typeof value === 'object') {
					const text = value[lang] ?? value.es ?? value.en ?? fallback;
					if (typeof text === 'string' && text.trim()) return text;
					return fallback;
				}
				return fallback;
			};

			const getSafeCopyValue = (copy, key, lang) => {
				const value = copy?.[key];
				if (!value || typeof value !== 'object') return null;
				const esText = typeof value.es === 'string' ? value.es.trim() : '';
				const enText = typeof value.en === 'string' ? value.en.trim() : '';
				if (esText && enText && esText !== enText) {
					return value[lang] ?? value.es ?? value.en ?? null;
				}
				return null;
			};

			// Subscriber only. Header.astro owns lang state and is the sole dispatcher
			// of `sitelangchange` — never dispatch it from here (feedback loop).
			const applyHomeLanguage = (lang) => {
				const activeLang = lang === 'en' ? 'en' : 'es';
				document.querySelectorAll('[data-i18n]').forEach((el) => {
					const value = el.dataset[activeLang];
					if (value !== undefined) {
						el.textContent = value;
					}
				});
				document.querySelectorAll('[data-aria-i18n]').forEach((el) => {
					const value = el.dataset[activeLang === 'en' ? 'ariaEn' : 'ariaEs'];
					if (value !== undefined) {
						el.setAttribute('aria-label', value);
					}
				});
			};

			const setText = (selector, value) => {
				const element = document.querySelector(selector);
				if (element && value != null) {
					element.textContent = value;
				}
			};

			const setI18nText = (selector, value, lang) => {
				const element = document.querySelector(selector);
				if (!element || value == null || value === '') return;
				element.dataset[lang] = value;
				element.textContent = value;
			};

			const setAttributeIfPresent = (selector, attribute, value) => {
				const element = document.querySelector(selector);
				if (element && value) {
					element.setAttribute(attribute, value);
				}
			};

			const applyApiData = (data, lang) => {
				const activeLang = lang === 'es' ? 'es' : 'en';
				const fields = data?.fields ?? {};
				const copy = fields.copy ?? {};
				const meta = data?.meta ?? {};
				if (data?.title) {
					document.title = meta.seo_title || data.title;
				}
				if (meta.search_description) {
					document.querySelector('meta[name="description"]')?.setAttribute('content', meta.search_description);
				}
				const safeHeroEyebrow = getSafeCopyValue(copy, 'hero_eyebrow', activeLang) ?? resolveLocalizedText(home?.fields?.copy?.hero_eyebrow ?? {}, activeLang, 'Home');
				const safeHeroHeading = getSafeCopyValue(copy, 'hero_heading', activeLang) ?? resolveLocalizedText(home?.fields?.copy?.hero_heading ?? {}, activeLang, 'Home');
				const safeHeroCta = getSafeCopyValue(copy, 'hero_cta', activeLang) ?? resolveLocalizedText(home?.fields?.copy?.hero_cta ?? {}, activeLang, 'Contact');
				setI18nText('#hero-eyebrow', safeHeroEyebrow, activeLang);
				setI18nText('#hero-heading', safeHeroHeading, activeLang);
				setI18nText('#hero-cta', safeHeroCta, activeLang);
				const siteLogoFromApi = fields.site_logo ?? fields.logo ?? fields.header_logo;
				if (siteLogoFromApi) {
					const logoUrl = typeof siteLogoFromApi === 'string' ? normalizeAssetUrl(siteLogoFromApi) : normalizeAssetUrl(siteLogoFromApi?.url);
					const logoAlt = typeof siteLogoFromApi === 'string' ? 'Policrafters logo' : siteLogoFromApi?.alt || 'Policrafters logo';
					const logoElement = document.querySelector('#site-logo');
					if (logoElement) {
						logoElement.setAttribute('src', logoUrl);
						logoElement.setAttribute('alt', logoAlt);
					}
				}
				setAttributeIfPresent('#hero-image', 'src', fields.hero_image_fallback?.url);
				setAttributeIfPresent('#hero-image', 'alt', fields.hero_image_fallback?.alt);
				const heroMedia = document.querySelector('#hero-media');
				if (heroMedia && fields.hero_video_url) {
					heroMedia.setAttribute('src', fields.hero_video_url);
				}
				setText('#hero-heading', resolveLocalizedText(copy.hero_heading ?? fields.hero_heading, activeLang, fields.hero_heading));
				applyHomeLanguage(activeLang);
			};

			const loadCmsLanguage = (lang) => {
				const activeLang = lang === 'es' ? 'es' : 'en';
				const requestUrl = buildApiUrlForLang(activeLang);
				if (!requestUrl) return Promise.resolve();
				return fetch(requestUrl, { cache: 'no-store' })
					.then((response) => {
						if (!response.ok) throw new Error(`HTTP ${response.status}`);
						return response.json();
					})
					.then((data) => applyApiData(data, activeLang))
					.catch((error) => {
						console.warn('No se pudo cargar la API de Wagtail:', error);
					});
			};

			if (shouldUseCms) {
				loadCmsLanguage(getActiveLang());
			}

			// Self-boot, then subscribe: component scripts run before this page script,
			// so Header's boot dispatch would otherwise be missed (see Footer.astro).
			applyHomeLanguage(getActiveLang());
			document.addEventListener('sitelangchange', (event) => {
				const nextLang = event?.detail === 'es' ? 'es' : 'en';
				if (shouldUseCms) {
					loadCmsLanguage(nextLang);
					return;
				}
				applyHomeLanguage(nextLang);
			});

			const heroVideo = document.querySelector('.hero-video');
			if (heroVideo) {
				const isVertical = window.matchMedia('(max-width: 900px)');
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

				const loadHeroVideo = () => {
					// Reduced-motion users keep the static poster.
					if (prefersReducedMotion.matches) return;
					const src = isVertical.matches
						? heroVideo.dataset.srcVertical
						: heroVideo.dataset.srcHorizontal;
					if (!src || heroVideo.getAttribute('src') === src) return;
					heroVideo.muted = true;
					heroVideo.setAttribute('src', src);
					heroVideo.load();
					const played = heroVideo.play();
					// Autoplay can be blocked; the poster simply stays.
					if (played && typeof played.catch === 'function') played.catch(() => {});
				};

				// Only reveal the video once frames are actually rendering.
				heroVideo.addEventListener('playing', () => heroVideo.classList.add('is-ready'));
				heroVideo.addEventListener('error', () => heroVideo.classList.remove('is-ready'));

				const swapOrientation = () => {
					heroVideo.classList.remove('is-ready');
					loadHeroVideo();
				};

				if (typeof isVertical.addEventListener === 'function') {
					isVertical.addEventListener('change', swapOrientation);
					prefersReducedMotion.addEventListener('change', swapOrientation);
				}

				loadHeroVideo();
			}

			const projectsCarousel = document.getElementById('projects-carousel');
			const projectsButtons = document.querySelectorAll('#projects-prev, #projects-next, .projects-indicator-arrow');
			const projectsDotsContainer = document.getElementById('projects-dots');
			const projectsCards = projectsCarousel ? Array.from(projectsCarousel.querySelectorAll('.projects-card')) : [];
			const projectsCount = projectsCards.length;
			let projectsCurrentIndex = 0;
			let projectsStepSize = 0;
			let projectsPageCount = projectsCount;
			let projectsScrollRaf = null;

			const getCardOffset = (index) => {
				const safeIndex = Math.max(0, Math.min(index, projectsCards.length - 1));
				const target = projectsCards[safeIndex];
				return target ? target.offsetLeft : 0;
			};

			// Astro's scoped styles only match elements carrying its data-astro-cid-*
			// attribute, which is baked in at build time. Buttons created here at runtime
			// need that same attribute copied over or the scoped .projects-dot rules
			// (shape, fill, active state) silently fail to apply to them.
			const astroScopeAttrs = projectsDotsContainer
				? Array.from(projectsDotsContainer.attributes).filter((attr) => attr.name.startsWith('data-astro-cid-'))
				: [];

			const renderProjectsDots = (pageCount) => {
				if (!projectsDotsContainer) return;
				const dotAriaEs = projectsDotsContainer.dataset.dotAriaEs || 'Ir al proyecto';
				const dotAriaEn = projectsDotsContainer.dataset.dotAriaEn || 'Go to project';
				const activeLang = getActiveLang();
				projectsDotsContainer.innerHTML = '';
				for (let i = 0; i < pageCount; i += 1) {
					const dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'projects-dot';
					dot.setAttribute('data-dot-index', String(i));
					dot.setAttribute('data-aria-i18n', '');
					dot.dataset.ariaEs = `${dotAriaEs} ${i + 1}`;
					dot.dataset.ariaEn = `${dotAriaEn} ${i + 1}`;
					dot.setAttribute('aria-label', `${activeLang === 'es' ? dotAriaEs : dotAriaEn} ${i + 1}`);
					astroScopeAttrs.forEach((attr) => dot.setAttribute(attr.name, attr.value));
					projectsDotsContainer.appendChild(dot);
				}
			};

			const measureProjectsStep = () => {
				if (!projectsCarousel || projectsCards.length < 2) return;
				projectsStepSize = projectsCards[1].offsetLeft - projectsCards[0].offsetLeft;
				if (projectsStepSize <= 0) {
					projectsStepSize = projectsCards[0].getBoundingClientRect().width;
				}
				// A carousel that shows more than one card per step has fewer distinct
				// scroll stops than cards: the last (visibleCount - 1) cards share their
				// stop with an earlier one, so the dot count must follow visible count.
				const visibleCount = Math.max(1, Math.round(projectsCarousel.clientWidth / projectsStepSize));
				const nextPageCount = Math.max(1, projectsCount - visibleCount + 1);
				if (nextPageCount !== projectsPageCount) {
					projectsPageCount = nextPageCount;
					renderProjectsDots(projectsPageCount);
					projectsCurrentIndex = Math.min(projectsCurrentIndex, projectsPageCount - 1);
					applyHomeLanguage(getActiveLang());
				}
			};

			const updateProjectsIndicator = () => {
				if (!projectsPageCount) return;
				document.querySelectorAll('.projects-dot').forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === projectsCurrentIndex);
				});
				projectsButtons.forEach((button) => {
					const action = button.getAttribute('data-action');
					if (action === 'prev') button.disabled = projectsCurrentIndex === 0;
					if (action === 'next') button.disabled = projectsCurrentIndex === projectsPageCount - 1;
				});
			};

			const scrollProjectsToIndex = (index) => {
				if (!projectsCarousel) return;
				const clamped = Math.max(0, Math.min(index, projectsPageCount - 1));
				const maxScroll = projectsCarousel.scrollWidth - projectsCarousel.clientWidth;
				const left = clamped === projectsPageCount - 1 ? maxScroll : getCardOffset(clamped);
				projectsCarousel.scrollTo({ left, behavior: 'smooth' });
				projectsCurrentIndex = clamped;
				updateProjectsIndicator();
			};

			const handleProjectsScroll = () => {
				if (projectsScrollRaf) return;
				projectsScrollRaf = requestAnimationFrame(() => {
					projectsScrollRaf = null;
					if (!projectsStepSize || !projectsCarousel) return;
					const maxScroll = projectsCarousel.scrollWidth - projectsCarousel.clientWidth;
					const atEnd = maxScroll - projectsCarousel.scrollLeft < 2;
					projectsCurrentIndex = atEnd
						? projectsPageCount - 1
						: Math.min(Math.round(projectsCarousel.scrollLeft / projectsStepSize), projectsPageCount - 1);
					updateProjectsIndicator();
				});
			};

			const setupProjectsCarousel = () => {
				if (!projectsCarousel || !projectsCount) return;

				requestAnimationFrame(() => {
					measureProjectsStep();
					updateProjectsIndicator();
				});

				window.addEventListener('resize', () => {
					requestAnimationFrame(measureProjectsStep);
				});

				projectsCarousel.addEventListener('scroll', handleProjectsScroll, { passive: true });

				projectsButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						scrollProjectsToIndex(projectsCurrentIndex + direction);
					});
				});

				projectsDotsContainer?.addEventListener('click', (event) => {
					const dot = event.target.closest('.projects-dot');
					if (!dot) return;
					const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					scrollProjectsToIndex(targetIndex);
				});
			};

			setupProjectsCarousel();

			const valuesSlider = document.getElementById('values-slider');
			const valuesSlides = valuesSlider ? Array.from(valuesSlider.querySelectorAll('.values-slide')) : [];
			const valuesDots = document.querySelectorAll('.values-dot');
			const valuesButtons = document.querySelectorAll('#values-prev, #values-next, .values-indicator-arrow');
			const valuesCount = valuesSlides.length;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let valuesCurrentIndex = 0;
			let valuesIntervalId = null;

			const goToValuesSlide = (index) => {
				valuesCurrentIndex = (index + valuesCount) % valuesCount;
				valuesSlides.forEach((slide, i) => {
					const isActive = i === valuesCurrentIndex;
					slide.classList.toggle('is-active', isActive);
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				});
				valuesDots.forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === valuesCurrentIndex);
				});
			};

			const stopValuesAutoplay = () => {
				if (valuesIntervalId) {
					clearInterval(valuesIntervalId);
					valuesIntervalId = null;
				}
			};

			const startValuesAutoplay = () => {
				if (prefersReducedMotion || !valuesCount) return;
				stopValuesAutoplay();
				valuesIntervalId = setInterval(() => {
					goToValuesSlide(valuesCurrentIndex + 1);
				}, 4000);
			};

			const setupValuesSlider = () => {
				if (!valuesSlider || !valuesCount) return;

				valuesButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						goToValuesSlide(valuesCurrentIndex + direction);
						startValuesAutoplay();
					});
				});

				valuesDots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
						goToValuesSlide(targetIndex);
						startValuesAutoplay();
					});
				});

				valuesSlider.addEventListener('mouseenter', stopValuesAutoplay);
				valuesSlider.addEventListener('mouseleave', startValuesAutoplay);

				document.addEventListener('visibilitychange', () => {
					if (document.hidden) {
						stopValuesAutoplay();
					} else {
						startValuesAutoplay();
					}
				});

				startValuesAutoplay();
			};

			setupValuesSlider();

			const catalogsTrack = document.getElementById('catalogs-track');
			const catalogsButtons = document.querySelectorAll('#catalogs-prev, #catalogs-next');
			const catalogsDots = document.querySelectorAll('.catalogs-dot');
			const catalogsPageCount = catalogsDots.length;
			let catalogsCurrentPage = 0;
			let catalogsScrollRaf = null;

			const updateCatalogsIndicator = () => {
				catalogsDots.forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === catalogsCurrentPage);
				});
				catalogsButtons.forEach((button) => {
					const action = button.getAttribute('data-action');
					if (action === 'prev') button.disabled = catalogsCurrentPage === 0;
					if (action === 'next') button.disabled = catalogsCurrentPage === catalogsPageCount - 1;
				});
			};

			const scrollCatalogsToPage = (page) => {
				if (!catalogsTrack) return;
				const clamped = Math.max(0, Math.min(page, catalogsPageCount - 1));
				catalogsCurrentPage = clamped;
				catalogsTrack.scrollTo({ left: clamped * catalogsTrack.clientWidth, behavior: 'smooth' });
				updateCatalogsIndicator();
			};

			const handleCatalogsScroll = () => {
				if (catalogsScrollRaf) return;
				catalogsScrollRaf = requestAnimationFrame(() => {
					catalogsScrollRaf = null;
					if (!catalogsTrack) return;
					const maxScroll = catalogsTrack.scrollWidth - catalogsTrack.clientWidth;
					const atEnd = maxScroll - catalogsTrack.scrollLeft < 2;
					catalogsCurrentPage = atEnd
						? catalogsPageCount - 1
						: Math.min(Math.round(catalogsTrack.scrollLeft / catalogsTrack.clientWidth), catalogsPageCount - 1);
					updateCatalogsIndicator();
				});
			};

			const setupCatalogsSlider = () => {
				if (!catalogsTrack || !catalogsPageCount) return;

				requestAnimationFrame(updateCatalogsIndicator);

				catalogsTrack.addEventListener('scroll', handleCatalogsScroll, { passive: true });

				catalogsButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						scrollCatalogsToPage(catalogsCurrentPage + direction);
					});
				});

				catalogsDots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
						scrollCatalogsToPage(targetIndex);
					});
				});
			};

			setupCatalogsSlider();
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0f0f10;
		--text: #111;
		--muted: #666;
		--max: 1200px;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		font-family: "Arimo", "Helvetica Neue", Helvetica, Arial, sans-serif;
		color: var(--text);
		background: #fff;
	}

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
