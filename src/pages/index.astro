---
import home from "../mocks/home.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from 'astro-icon/components';
import "../styles/links.css";

const useApi = import.meta.env.PUBLIC_USE_API === "true";
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/home/";
const apiOrigin = apiUrl.startsWith("http") ? new URL(apiUrl).origin : "";
const normalizeAssetUrl = (value) => {
	if (!value) return "";
	if (/^https?:\/\//i.test(value)) return value;
	if (value.startsWith("/")) {
		return apiOrigin ? `${apiOrigin}${value}` : value;
	}
	return value;
};
let data = home;

if (useApi) {
	try {
		const response = await fetch(apiUrl);
		if (response.ok) {
			const payload = await response.json();
			if (payload && typeof payload === "object") {
				data = payload;
			}
		}
	} catch (error) {
		console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
	}
}

const resolvedData = data ?? home;
const resolvedFields = resolvedData.fields ?? home.fields ?? {};
const resolvedMeta = resolvedData.meta ?? home.meta ?? {};
const fallbackFields = home.fields ?? {};
const featuredProjects = Array.isArray(resolvedFields.featured_projects) ? resolvedFields.featured_projects : [];
const heroHeading = resolvedFields.hero_heading || resolvedData.title || fallbackFields.hero_heading || "Home";
// Only CMS-provided paths need the API origin; local /public assets are served as-is.
const heroAsset = (apiValue, localValue) => (useApi && apiValue ? normalizeAssetUrl(apiValue) : localValue);
const teamMembersRaw = Array.isArray(resolvedFields.team_members) && resolvedFields.team_members.length
	? resolvedFields.team_members
	: (fallbackFields.team_members ?? []);
const teamMembers = teamMembersRaw.map((member) => ({
	...member,
	photo: {
		url: heroAsset(member.photo?.url, member.photo?.url),
		alt: member.photo?.alt || ""
	}
}));
const valuesSlidesRaw = Array.isArray(resolvedFields.values_slides) && resolvedFields.values_slides.length
	? resolvedFields.values_slides
	: (fallbackFields.values_slides ?? []);
const valuesSlides = valuesSlidesRaw.map((slide) => ({
	...slide,
	image: {
		url: heroAsset(slide.image?.url, slide.image?.url),
		alt: slide.image?.alt || ""
	}
}));
const catalogsRaw = Array.isArray(resolvedFields.catalogs) && resolvedFields.catalogs.length
	? resolvedFields.catalogs
	: (fallbackFields.catalogs ?? []);
const catalogs = catalogsRaw.map((item) => ({
	...item,
	image: {
		url: heroAsset(item.image?.url, item.image?.url),
		alt: item.image?.alt || ""
	}
}));
const contactLinks = Array.isArray(resolvedFields.contact_links) && resolvedFields.contact_links.length
	? resolvedFields.contact_links
	: (fallbackFields.contact_links ?? []);
const heroVideoHorizontal = heroAsset(
	resolvedFields.hero_video_horizontal,
	fallbackFields.hero_video_horizontal || "/videos/horizontal_video_placeholder.mp4"
);
const heroVideoVertical = heroAsset(
	resolvedFields.hero_video_vertical,
	fallbackFields.hero_video_vertical || "/videos/vertical_video_placeholder.mp4"
);
const heroImageHorizontal = heroAsset(
	resolvedFields.hero_image_horizontal?.url,
	fallbackFields.hero_image_horizontal?.url || "/images/pages/horizontal_video_static_image.png"
);
const heroImageVertical = heroAsset(
	resolvedFields.hero_image_vertical?.url,
	fallbackFields.hero_image_vertical?.url || "/images/pages/vertical_video_static_image.png"
);
const heroImageAlt = resolvedFields.hero_image_horizontal?.alt || fallbackFields.hero_image_horizontal?.alt || "Policrafters";
const siteLogoCandidate = resolvedFields.site_logo ?? resolvedFields.logo ?? resolvedFields.header_logo ?? fallbackFields.site_logo ?? fallbackFields.logo ?? fallbackFields.header_logo;
const siteLogo = typeof siteLogoCandidate === "string"
	? { url: normalizeAssetUrl(siteLogoCandidate), alt: "Policrafters logo" }
	: siteLogoCandidate?.url
		? { url: normalizeAssetUrl(siteLogoCandidate.url), alt: siteLogoCandidate.alt || "Policrafters logo" }
		: { url: "/logo_black.png", alt: "Policrafters logo" };
const normalizedLocale = typeof resolvedData.locale === "string" ? resolvedData.locale.toLowerCase() : "";
const isEsLocale = normalizedLocale.includes("es") || normalizedLocale.includes("español");
const langParam = Astro.url.searchParams.get("lang")?.toLowerCase();
const selectedLang = langParam === "en" || langParam === "es"
	? langParam
	: isEsLocale
		? "es"
		: "en";
const isEs = selectedLang === "es";

const localizedHeroHeading = isEs
	? heroHeading
	: 'Your Premier Interiors & Architectural Partner';
const localizedHeroEyebrow = isEs
	? 'DONDE LA INNOVACIÓN SE ENCUENTRA CON EL DISEÑO'
	: 'WHERE INNOVATION MEETS DESIGN';
const localizedHeroCta = isEs
	? 'CONTÁCTANOS AHORA'
	: 'CONTACT US NOW';
const heroCtaUrl = '/contacto';
---

<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{resolvedMeta.seo_title || resolvedData.title || home.title}</title>
		<meta name="description" content={resolvedMeta.search_description || ""} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body data-api-url={apiUrl}>
		<Header lang={selectedLang} logo={siteLogo} position="fixed" scrollShadow />

		<section class="hero">
			<picture class="hero-poster">
				<source media="(max-width: 900px)" srcset={heroImageVertical} />
				<img src={heroImageHorizontal} alt={heroImageAlt} loading="eager" fetchpriority="high" />
			</picture>
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				preload="none"
				aria-hidden="true"
				data-src-horizontal={heroVideoHorizontal}
				data-src-vertical={heroVideoVertical}
			></video>
			<div class="hero-overlay" />
			<div class="hero-content">
				<p id="hero-eyebrow" class="eyebrow">{localizedHeroEyebrow}</p>
				<h1 id="hero-heading">{localizedHeroHeading}</h1>
				<a id="hero-cta" class="hero-cta-btn" href={heroCtaUrl}>{localizedHeroCta}</a>
			</div>
		</section>

		<main>
			<section class="projects-section">
				<p id="projects-eyebrow" class="section-eyebrow">{isEs ? "Nuestros proyectos" : "Our projects"}</p>
				<h2 id="projects-heading" class="section-heading">{isEs ? "MIRA LO QUE PODEMOS CREAR" : "SEE WHAT WE CAN CREATE"}</h2>

				<div class="projects-carousel-shell">
					<div class="projects-carousel-viewport">
						<div class="projects-carousel-controls" aria-hidden="true">
							<button id="projects-prev" class="projects-arrow-btn" data-action="prev" disabled aria-label={isEs ? "Ver proyecto anterior" : "View previous project"}>
								<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#fff" /></svg>
							</button>
							<button id="projects-next" class="projects-arrow-btn" data-action="next" aria-label={isEs ? "Ver siguiente proyecto" : "View next project"}>
								<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#fff" /></svg>
							</button>
						</div>

						<div class="projects-carousel" id="projects-carousel" aria-label={isEs ? "Carrusel de proyectos" : "Projects carousel"}>
							{featuredProjects.map((p, index) => (
								<a href="#" class="projects-card" data-project-index={index}>
									<img src={p.thumbnail.url} alt={p.thumbnail.alt} loading="lazy" />
									<div class="projects-card__body">
										<h3 class="projects-card__title">{p.title}</h3>
										<p class="projects-card__description">{p.description}</p>
									</div>
								</a>
							))}
						</div>
					</div>

					<div class="projects-indicator" id="projects-indicator" role="tablist" aria-label={isEs ? "Selector de proyecto" : "Project selector"}>
						<button type="button" class="projects-indicator-arrow" data-action="prev" disabled aria-label={isEs ? "Anterior" : "Previous"}>
							<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
						</button>
						<div class="projects-dots" id="projects-dots">
							{featuredProjects.map((_, index) => (
								<button
									type="button"
									class:list={["projects-dot", index === 0 && "is-active"]}
									data-dot-index={index}
									aria-label={(isEs ? "Ir al proyecto " : "Go to project ") + (index + 1)}
								></button>
							))}
						</div>
						<button type="button" class="projects-indicator-arrow" data-action="next" aria-label={isEs ? "Siguiente" : "Next"}>
							<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
						</button>
					</div>
				</div>

				<a id="projects-cta" href="#" class="projects-cta-btn">{isEs ? "Ver todos los proyectos" : "See all projects"}</a>
			</section>

			<hr class="section-rule" />

			<section class="container about-section">
				<div class="about-grid">
					<img
						class="about-image"
						src="/images/pages/about_us.png"
						alt={isEs ? "Equipo de Policrafters" : "The Policrafters team"}
						loading="lazy"
					/>
					<div class="about-copy">
						<p id="about-eyebrow" class="section-eyebrow">{isEs ? "Nosotros, Marcas" : "About Us, Brands"}</p>
						<h2 id="about-heading" class="section-heading">{isEs ? "BIENVENIDO A POLICRAFTERS" : "WELCOME TO POLICRAFTERS"}</h2>
						<p id="about-body-1">{isEs
							? "En Policrafters, nos enorgullecemos de ofrecer soluciones que no solo son innovadoras, sino también altamente personalizables para satisfacer las necesidades únicas de cada cliente. Nuestro compromiso con la excelencia se refleja en cada proyecto que emprendemos, desde el concepto hasta la finalización. Un nombre distinguido en Diseño de Interiores y Soluciones de Arquitectura."
							: "At Policrafters, we take pride in delivering solutions that are not only innovative but also highly customizable to meet the unique needs of each client. Our commitment to excellence is reflected in every project we undertake, from concept to completion. A distinguished name in Interior Design and Architecture Solutions."}</p>
						<p id="about-body-2">{isEs
							? "Fabricados en Estados Unidos con materiales de primera calidad y tecnología de vanguardia, nuestros productos son un testimonio de la experiencia y dedicación de nuestro equipo. Nuestro personal aporta una gran experiencia que nos permite diseñar, fabricar e instalar soluciones a medida en el sur de Florida y más allá. Ya sea que busques trabajos intrincados en vidrio, aluminio, otros metales o carpintería, Policrafters está listo para hacer realidad tu visión."
							: "Crafted in the United States using premium-quality materials and cutting-edge technology, our products are a testament to the expertise and dedication of our seasoned team. Our workforce brings a wealth of experience to the table, enabling us to design, manufacture, and install bespoke solutions across South Florida and beyond. Whether you're in the market for intricate glasswork, aluminum, other metals, or wood craftsmanship, Policrafters is equipped to bring your vision to life."}</p>
						<p id="about-brands-label" class="about-brands-label">{isEs ? "Nuestras Marcas" : "Our Brands"}</p>
						<ul class="about-brands-list">
							<li><a href="https://glasstech-usa.com" target="_blank" rel="noopener" class="link-body">glasstech-usa.com</a></li>
							<li><a href="https://alutech-usa.com" target="_blank" rel="noopener" class="link-body">alutech-usa.com</a></li>
						</ul>
						<a id="about-cta" href="#" class="about-cta-btn">{isEs ? "Saber más" : "Know more"}</a>
					</div>
				</div>
			</section>

			<hr class="section-rule" />

			<section class="container team-section">
				<p id="team-eyebrow" class="section-eyebrow">{isEs ? "Nuestro Equipo, Experiencia" : "Our Team, Expertise"}</p>
				<h2 id="team-heading" class="section-heading">{isEs ? "LA GENTE DETRÁS DEL OFICIO" : "THE PEOPLE BEHIND THE CRAFT"}</h2>

				<div class="team-grid">
					{teamMembers.map((member) => (
						<div class="team-card">
							<img
								class="team-card__photo"
								src={member.photo.url}
								alt={member.photo.alt || (isEs ? "Integrante del equipo Policrafters" : "Policrafters team member")}
								loading="lazy"
							/>
							<div class="team-card__meta">
								<p
									class="team-card__role"
									data-role-es={member.role}
									data-role-en={member.role_en}
								>
									{isEs ? member.role : member.role_en}
								</p>
								<p class="team-card__name">{member.name}</p>
							</div>
							<p
								class="team-card__bio"
								data-bio-es={member.bio}
								data-bio-en={member.bio_en}
							>
								{isEs ? member.bio : member.bio_en}
							</p>
						</div>
					))}
				</div>
			</section>

			<hr class="section-rule" />

			<section class="values-section">
				<div class="values-header">
					<p id="values-eyebrow" class="section-eyebrow">{isEs ? "Nuestros Valores" : "Our Values"}</p>
					<h2 id="values-heading" class="section-heading">{isEs ? "LOS PRINCIPIOS DETRÁS DE TODO LO QUE CREAMOS" : "THE PRINCIPLES BEHIND EVERYTHING WE CREATE"}</h2>
				</div>

				<div class="values-slider" id="values-slider" aria-roledescription="carousel" aria-label={isEs ? "Carrusel de valores" : "Values carousel"}>
					{valuesSlides.map((slide, index) => (
						<div class:list={["values-slide", index === 0 && "is-active"]} data-slide-index={index} aria-hidden={index === 0 ? "false" : "true"}>
							<img
								class="values-slide__image"
								src={slide.image.url}
								alt={slide.image.alt}
								loading={index === 0 ? "eager" : "lazy"}
							/>
							<div class="values-slide__caption">
								<h3
									class="values-slide__title"
									data-vtitle-es={slide.title}
									data-vtitle-en={slide.title_en}
								>
									{isEs ? slide.title : slide.title_en}
								</h3>
								<p
									class="values-slide__description"
									data-vdesc-es={slide.description}
									data-vdesc-en={slide.description_en}
								>
									{isEs ? slide.description : slide.description_en}
								</p>
							</div>
						</div>
					))}

					<div class="values-slider-controls" aria-hidden="true">
						<button id="values-prev" class="values-arrow-btn" data-action="prev" aria-label={isEs ? "Ver valor anterior" : "View previous value"}>
							<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#fff" /></svg>
						</button>
						<button id="values-next" class="values-arrow-btn" data-action="next" aria-label={isEs ? "Ver siguiente valor" : "View next value"}>
							<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#fff" /></svg>
						</button>
					</div>
				</div>

				<div class="values-indicator" id="values-indicator" role="tablist" aria-label={isEs ? "Selector de valor" : "Value selector"}>
					<button type="button" class="values-indicator-arrow" data-action="prev" aria-label={isEs ? "Anterior" : "Previous"}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
					</button>
					<div class="values-dots" id="values-dots">
						{valuesSlides.map((_, index) => (
							<button
								type="button"
								class:list={["values-dot", index === 0 && "is-active"]}
								data-dot-index={index}
								aria-label={(isEs ? "Ir al valor " : "Go to value ") + (index + 1)}
							></button>
						))}
					</div>
					<button type="button" class="values-indicator-arrow" data-action="next" aria-label={isEs ? "Siguiente" : "Next"}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
					</button>
				</div>
			</section>

			<hr class="section-rule" />

			<section class="container catalogs-section">
				<p id="catalogs-eyebrow" class="section-eyebrow">{isEs ? "Nuestros Catálogos" : "Our Catalogs"}</p>
				<h2 id="catalogs-heading" class="section-heading">{isEs ? "EXPLORA NUESTRAS COLECCIONES Y SOLUCIONES" : "EXPLORE OUR COLLECTIONS AND SOLUTIONS"}</h2>

				<div class="catalogs-track" id="catalogs-track">
					{catalogs.map((item, index) => (
						<a class="catalog-card" href={item.file_url || "#"} data-catalog-index={index}>
							<img class="catalog-card__image" src={item.image.url} alt={item.image.alt} loading="lazy" />
							<span class="catalog-card__label">
								<span
									class="catalog-card__title"
									data-ctitle-es={item.title}
									data-ctitle-en={item.title_en}
								>
									{isEs ? item.title : item.title_en}
								</span>
								<Icon name="mdi:download" class="catalog-card__icon" />
							</span>
						</a>
					))}
				</div>

				<div class="catalogs-indicator" id="catalogs-indicator" role="tablist" aria-label={isEs ? "Selector de catálogo" : "Catalog selector"}>
					<button type="button" id="catalogs-prev" class="catalogs-indicator-arrow" data-action="prev" disabled aria-label={isEs ? "Anterior" : "Previous"}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="16,2 16,22 4,12" fill="#2f3437" /></svg>
					</button>
					<div class="catalogs-dots" id="catalogs-dots">
						{Array.from({ length: Math.ceil(catalogs.length / 4) }, (_, index) => (
							<button
								type="button"
								class:list={["catalogs-dot", index === 0 && "is-active"]}
								data-dot-index={index}
								aria-label={(isEs ? "Ir a la página " : "Go to page ") + (index + 1)}
							></button>
						))}
					</div>
					<button type="button" id="catalogs-next" class="catalogs-indicator-arrow" data-action="next" aria-label={isEs ? "Siguiente" : "Next"}>
						<svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><polygon points="8,2 8,22 20,12" fill="#2f3437" /></svg>
					</button>
				</div>

				<h2 id="contact-heading" class="contact-heading">{isEs ? "¿Te gustaría contactar directamente con Policrafters?" : "Would you like to get direct contact with Policrafters?"}</h2>

				<div class="contact-grid">
					{contactLinks.map((link) => (
						<div class="contact-col">
							<h3
								class="contact-col__title"
								data-lntitle-es={link.title}
								data-lntitle-en={link.title_en}
							>
								{isEs ? link.title : link.title_en}
							</h3>
							<p
								class="contact-col__description"
								data-lndesc-es={link.description}
								data-lndesc-en={link.description_en}
							>
								{isEs ? link.description : link.description_en}
							</p>
							<a class="contact-col__btn" href={link.url || "#"} data-lnbtn="1">{isEs ? "Saber más" : "Learn more"}</a>
						</div>
					))}
				</div>
			</section>
		</main>

		<Footer lang={selectedLang} />

		<script type="module">
			const body = document.body;
			const apiUrl = body?.dataset?.apiUrl;
			const uiByLang = {
				es: {
					content: {
						heroEyebrow: 'DONDE LA INNOVACIÓN SE ENCUENTRA CON EL DISEÑO',
						heroHeading: 'Tu Socio Experto en Interiores y Arquitectura',
						heroCta: 'CONTÁCTANOS AHORA',
						projectsEyebrow: 'Nuestros proyectos',
						projectsHeading: 'MIRA LO QUE PODEMOS CREAR',
						projectsCta: 'Ver todos los proyectos',
						projectsPrevAria: 'Ver proyecto anterior',
						projectsNextAria: 'Ver siguiente proyecto',
						projectsCarouselAria: 'Carrusel de proyectos',
						projectsDotAria: 'Ir al proyecto',
						aboutEyebrow: 'Nosotros, Marcas',
						aboutHeading: 'BIENVENIDO A POLICRAFTERS',
						aboutBody1: 'En Policrafters, nos enorgullecemos de ofrecer soluciones que no solo son innovadoras, sino también altamente personalizables para satisfacer las necesidades únicas de cada cliente. Nuestro compromiso con la excelencia se refleja en cada proyecto que emprendemos, desde el concepto hasta la finalización. Un nombre distinguido en Diseño de Interiores y Soluciones de Arquitectura.',
						aboutBody2: 'Fabricados en Estados Unidos con materiales de primera calidad y tecnología de vanguardia, nuestros productos son un testimonio de la experiencia y dedicación de nuestro equipo. Nuestro personal aporta una gran experiencia que nos permite diseñar, fabricar e instalar soluciones a medida en el sur de Florida y más allá. Ya sea que busques trabajos intrincados en vidrio, aluminio, otros metales o carpintería, Policrafters está listo para hacer realidad tu visión.',
						aboutBrandsLabel: 'Nuestras Marcas',
						aboutCta: 'Saber más',
						teamEyebrow: 'Nuestro Equipo, Experiencia',
						teamHeading: 'LA GENTE DETRÁS DEL OFICIO',
						valuesEyebrow: 'Nuestros Valores',
						valuesHeading: 'LOS PRINCIPIOS DETRÁS DE TODO LO QUE CREAMOS',
						valuesCarouselAria: 'Carrusel de valores',
						valuesPrevAria: 'Ver valor anterior',
						valuesNextAria: 'Ver siguiente valor',
						valuesDotAria: 'Ir al valor',
						catalogsEyebrow: 'Nuestros Catálogos',
						catalogsHeading: 'EXPLORA NUESTRAS COLECCIONES Y SOLUCIONES',
						catalogsPrevAria: 'Anterior',
						catalogsNextAria: 'Siguiente',
						catalogsDotAria: 'Ir a la página',
						contactHeading: '¿Te gustaría contactar directamente con Policrafters?',
						contactBtn: 'Saber más'
					}
				},
				en: {
					content: {
						heroEyebrow: 'WHERE INNOVATION MEETS DESIGN',
						heroHeading: 'Your Premier Interiors & Architectural Partner',
						heroCta: 'CONTACT US NOW',
						projectsEyebrow: 'Our projects',
						projectsHeading: 'SEE WHAT WE CAN CREATE',
						projectsCta: 'See all projects',
						projectsPrevAria: 'View previous project',
						projectsNextAria: 'View next project',
						projectsCarouselAria: 'Projects carousel',
						projectsDotAria: 'Go to project',
						aboutEyebrow: 'About Us, Brands',
						aboutHeading: 'WELCOME TO POLICRAFTERS',
						aboutBody1: "At Policrafters, we take pride in delivering solutions that are not only innovative but also highly customizable to meet the unique needs of each client. Our commitment to excellence is reflected in every project we undertake, from concept to completion. A distinguished name in Interior Design and Architecture Solutions.",
						aboutBody2: "Crafted in the United States using premium-quality materials and cutting-edge technology, our products are a testament to the expertise and dedication of our seasoned team. Our workforce brings a wealth of experience to the table, enabling us to design, manufacture, and install bespoke solutions across South Florida and beyond. Whether you're in the market for intricate glasswork, aluminum, other metals, or wood craftsmanship, Policrafters is equipped to bring your vision to life.",
						aboutBrandsLabel: 'Our Brands',
						aboutCta: 'Know more',
						teamEyebrow: 'Our Team, Expertise',
						teamHeading: 'THE PEOPLE BEHIND THE CRAFT',
						valuesEyebrow: 'Our Values',
						valuesHeading: 'THE PRINCIPLES BEHIND EVERYTHING WE CREATE',
						valuesCarouselAria: 'Values carousel',
						valuesPrevAria: 'View previous value',
						valuesNextAria: 'View next value',
						valuesDotAria: 'Go to value',
						catalogsEyebrow: 'Our Catalogs',
						catalogsHeading: 'EXPLORE OUR COLLECTIONS AND SOLUTIONS',
						catalogsPrevAria: 'Previous',
						catalogsNextAria: 'Next',
						catalogsDotAria: 'Go to page',
						contactHeading: 'Would you like to get direct contact with Policrafters?',
						contactBtn: 'Learn more'
					}
				}
			};

			const getLangFromUrl = () => {
				const params = new URLSearchParams(window.location.search);
				const lang = params.get('lang');
				return lang === 'en' || lang === 'es' ? lang : null;
			};

			const getActiveLang = () => {
				const urlLang = getLangFromUrl();
				if (urlLang) return urlLang;
				const storedLang = localStorage.getItem('siteLang');
				if (storedLang === 'en' || storedLang === 'es') return storedLang;
				return document.documentElement.lang === 'en' ? 'en' : 'es';
			};


			// Subscriber only. Header.astro owns lang state and is the sole dispatcher
			// of `sitelangchange` — never dispatch it from here (feedback loop).
			const applyHomeLanguage = (lang) => {
				const activeLang = lang === 'en' ? 'en' : 'es';
				const copy = uiByLang[activeLang];

				document.querySelector('#hero-eyebrow')?.replaceChildren(copy.content.heroEyebrow);
				document.querySelector('#hero-heading')?.replaceChildren(copy.content.heroHeading);
				document.querySelector('#hero-cta')?.replaceChildren(copy.content.heroCta);
				document.querySelector('#projects-eyebrow')?.replaceChildren(copy.content.projectsEyebrow);
				document.querySelector('#projects-heading')?.replaceChildren(copy.content.projectsHeading);
				document.querySelector('#projects-cta')?.replaceChildren(copy.content.projectsCta);
				document.querySelector('#projects-prev')?.setAttribute('aria-label', copy.content.projectsPrevAria);
				document.querySelector('#projects-next')?.setAttribute('aria-label', copy.content.projectsNextAria);
				document.querySelector('#projects-carousel')?.setAttribute('aria-label', copy.content.projectsCarouselAria);
				document.querySelectorAll('.projects-dot').forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.setAttribute('aria-label', `${copy.content.projectsDotAria} ${dotIndex + 1}`);
				});
				document.querySelector('#about-eyebrow')?.replaceChildren(copy.content.aboutEyebrow);
				document.querySelector('#about-heading')?.replaceChildren(copy.content.aboutHeading);
				document.querySelector('#about-body-1')?.replaceChildren(copy.content.aboutBody1);
				document.querySelector('#about-body-2')?.replaceChildren(copy.content.aboutBody2);
				document.querySelector('#about-brands-label')?.replaceChildren(copy.content.aboutBrandsLabel);
				document.querySelector('#about-cta')?.replaceChildren(copy.content.aboutCta);
				document.querySelector('#team-eyebrow')?.replaceChildren(copy.content.teamEyebrow);
				document.querySelector('#team-heading')?.replaceChildren(copy.content.teamHeading);
				document.querySelectorAll('[data-role-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'roleEn' : 'roleEs'] || '');
				});
				document.querySelectorAll('[data-bio-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'bioEn' : 'bioEs'] || '');
				});
				document.querySelector('#values-eyebrow')?.replaceChildren(copy.content.valuesEyebrow);
				document.querySelector('#values-heading')?.replaceChildren(copy.content.valuesHeading);
				document.querySelectorAll('[data-vtitle-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'vtitleEn' : 'vtitleEs'] || '');
				});
				document.querySelectorAll('[data-vdesc-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'vdescEn' : 'vdescEs'] || '');
				});
				document.querySelector('#values-prev')?.setAttribute('aria-label', copy.content.valuesPrevAria);
				document.querySelector('#values-next')?.setAttribute('aria-label', copy.content.valuesNextAria);
				document.querySelector('#values-slider')?.setAttribute('aria-label', copy.content.valuesCarouselAria);
				document.querySelectorAll('.values-dot').forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.setAttribute('aria-label', `${copy.content.valuesDotAria} ${dotIndex + 1}`);
				});
				document.querySelector('#catalogs-eyebrow')?.replaceChildren(copy.content.catalogsEyebrow);
				document.querySelector('#catalogs-heading')?.replaceChildren(copy.content.catalogsHeading);
				document.querySelector('#contact-heading')?.replaceChildren(copy.content.contactHeading);
				document.querySelectorAll('[data-ctitle-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'ctitleEn' : 'ctitleEs'] || '');
				});
				document.querySelectorAll('[data-lntitle-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'lntitleEn' : 'lntitleEs'] || '');
				});
				document.querySelectorAll('[data-lndesc-es]').forEach((el) => {
					el.replaceChildren(el.dataset[activeLang === 'en' ? 'lndescEn' : 'lndescEs'] || '');
				});
				document.querySelectorAll('[data-lnbtn]').forEach((el) => {
					el.replaceChildren(copy.content.contactBtn);
				});
				document.querySelector('#catalogs-prev')?.setAttribute('aria-label', copy.content.catalogsPrevAria);
				document.querySelector('#catalogs-next')?.setAttribute('aria-label', copy.content.catalogsNextAria);
				document.querySelectorAll('.catalogs-dot').forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.setAttribute('aria-label', `${copy.content.catalogsDotAria} ${dotIndex + 1}`);
				});
			};
			const setText = (selector, value) => {
				const element = document.querySelector(selector);
				if (element && value != null) {
					element.textContent = value;
				}
			};

			const setAttributeIfPresent = (selector, attribute, value) => {
				const element = document.querySelector(selector);
				if (element && value) {
					element.setAttribute(attribute, value);
				}
			};

			const applyApiData = (data) => {
				const fields = data?.fields ?? {};
				const meta = data?.meta ?? {};
				if (data?.title) {
					document.title = meta.seo_title || data.title;
				}
				if (meta.search_description) {
					document.querySelector('meta[name="description"]')?.setAttribute('content', meta.search_description);
				}
				setText('#hero-heading', fields.hero_heading);
				const siteLogoFromApi = fields.site_logo ?? fields.logo ?? fields.header_logo;
				if (siteLogoFromApi) {
					const logoUrl = typeof siteLogoFromApi === 'string' ? normalizeAssetUrl(siteLogoFromApi) : normalizeAssetUrl(siteLogoFromApi?.url);
					const logoAlt = typeof siteLogoFromApi === 'string' ? 'Policrafters logo' : siteLogoFromApi?.alt || 'Policrafters logo';
					const logoElement = document.querySelector('#site-logo');
					if (logoElement) {
						logoElement.setAttribute('src', logoUrl);
						logoElement.setAttribute('alt', logoAlt);
					}
				}
				setAttributeIfPresent('#hero-image', 'src', fields.hero_image_fallback?.url);
				setAttributeIfPresent('#hero-image', 'alt', fields.hero_image_fallback?.alt);
				const heroMedia = document.querySelector('#hero-media');
				if (heroMedia && fields.hero_video_url) {
					heroMedia.setAttribute('src', fields.hero_video_url);
				}
				applyHomeLanguage(getActiveLang());
			};

			if (apiUrl) {
				fetch(apiUrl, { cache: 'no-store' })
					.then((response) => {
						if (!response.ok) throw new Error(`HTTP ${response.status}`);
						return response.json();
					})
					.then(applyApiData)
					.catch((error) => {
						console.warn('No se pudo cargar la API de Wagtail:', error);
					});
			}

			// Self-boot, then subscribe: component scripts run before this page script,
			// so Header's boot dispatch would otherwise be missed (see Footer.astro).
			applyHomeLanguage(getActiveLang());
			document.addEventListener('sitelangchange', (event) => applyHomeLanguage(event.detail));

			const heroVideo = document.querySelector('.hero-video');
			if (heroVideo) {
				const isVertical = window.matchMedia('(max-width: 900px)');
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

				const loadHeroVideo = () => {
					// Reduced-motion users keep the static poster.
					if (prefersReducedMotion.matches) return;
					const src = isVertical.matches
						? heroVideo.dataset.srcVertical
						: heroVideo.dataset.srcHorizontal;
					if (!src || heroVideo.getAttribute('src') === src) return;
					heroVideo.muted = true;
					heroVideo.setAttribute('src', src);
					heroVideo.load();
					const played = heroVideo.play();
					// Autoplay can be blocked; the poster simply stays.
					if (played && typeof played.catch === 'function') played.catch(() => {});
				};

				// Only reveal the video once frames are actually rendering.
				heroVideo.addEventListener('playing', () => heroVideo.classList.add('is-ready'));
				heroVideo.addEventListener('error', () => heroVideo.classList.remove('is-ready'));

				const swapOrientation = () => {
					heroVideo.classList.remove('is-ready');
					loadHeroVideo();
				};

				if (typeof isVertical.addEventListener === 'function') {
					isVertical.addEventListener('change', swapOrientation);
					prefersReducedMotion.addEventListener('change', swapOrientation);
				}

				loadHeroVideo();
			}

			const projectsCarousel = document.getElementById('projects-carousel');
			const projectsButtons = document.querySelectorAll('#projects-prev, #projects-next, .projects-indicator-arrow');
			const projectsDotsContainer = document.getElementById('projects-dots');
			const projectsCards = projectsCarousel ? Array.from(projectsCarousel.querySelectorAll('.projects-card')) : [];
			const projectsCount = projectsCards.length;
			let projectsCurrentIndex = 0;
			let projectsStepSize = 0;
			let projectsPageCount = projectsCount;
			let projectsScrollRaf = null;

			const getCardOffset = (index) => {
				const safeIndex = Math.max(0, Math.min(index, projectsCards.length - 1));
				const target = projectsCards[safeIndex];
				return target ? target.offsetLeft : 0;
			};

			// Astro's scoped styles only match elements carrying its data-astro-cid-*
			// attribute, which is baked in at build time. Buttons created here at runtime
			// need that same attribute copied over or the scoped .projects-dot rules
			// (shape, fill, active state) silently fail to apply to them.
			const astroScopeAttrs = projectsDotsContainer
				? Array.from(projectsDotsContainer.attributes).filter((attr) => attr.name.startsWith('data-astro-cid-'))
				: [];

			const renderProjectsDots = (pageCount) => {
				if (!projectsDotsContainer) return;
				projectsDotsContainer.innerHTML = '';
				for (let i = 0; i < pageCount; i += 1) {
					const dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'projects-dot';
					dot.setAttribute('data-dot-index', String(i));
					astroScopeAttrs.forEach((attr) => dot.setAttribute(attr.name, attr.value));
					projectsDotsContainer.appendChild(dot);
				}
			};

			const measureProjectsStep = () => {
				if (!projectsCarousel || projectsCards.length < 2) return;
				projectsStepSize = projectsCards[1].offsetLeft - projectsCards[0].offsetLeft;
				if (projectsStepSize <= 0) {
					projectsStepSize = projectsCards[0].getBoundingClientRect().width;
				}
				// A carousel that shows more than one card per step has fewer distinct
				// scroll stops than cards: the last (visibleCount - 1) cards share their
				// stop with an earlier one, so the dot count must follow visible count.
				const visibleCount = Math.max(1, Math.round(projectsCarousel.clientWidth / projectsStepSize));
				const nextPageCount = Math.max(1, projectsCount - visibleCount + 1);
				if (nextPageCount !== projectsPageCount) {
					projectsPageCount = nextPageCount;
					renderProjectsDots(projectsPageCount);
					projectsCurrentIndex = Math.min(projectsCurrentIndex, projectsPageCount - 1);
					applyHomeLanguage(getActiveLang());
				}
			};

			const updateProjectsIndicator = () => {
				if (!projectsPageCount) return;
				document.querySelectorAll('.projects-dot').forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === projectsCurrentIndex);
				});
				projectsButtons.forEach((button) => {
					const action = button.getAttribute('data-action');
					if (action === 'prev') button.disabled = projectsCurrentIndex === 0;
					if (action === 'next') button.disabled = projectsCurrentIndex === projectsPageCount - 1;
				});
			};

			const scrollProjectsToIndex = (index) => {
				if (!projectsCarousel) return;
				const clamped = Math.max(0, Math.min(index, projectsPageCount - 1));
				const maxScroll = projectsCarousel.scrollWidth - projectsCarousel.clientWidth;
				const left = clamped === projectsPageCount - 1 ? maxScroll : getCardOffset(clamped);
				projectsCarousel.scrollTo({ left, behavior: 'smooth' });
				projectsCurrentIndex = clamped;
				updateProjectsIndicator();
			};

			const handleProjectsScroll = () => {
				if (projectsScrollRaf) return;
				projectsScrollRaf = requestAnimationFrame(() => {
					projectsScrollRaf = null;
					if (!projectsStepSize || !projectsCarousel) return;
					const maxScroll = projectsCarousel.scrollWidth - projectsCarousel.clientWidth;
					const atEnd = maxScroll - projectsCarousel.scrollLeft < 2;
					projectsCurrentIndex = atEnd
						? projectsPageCount - 1
						: Math.min(Math.round(projectsCarousel.scrollLeft / projectsStepSize), projectsPageCount - 1);
					updateProjectsIndicator();
				});
			};

			const setupProjectsCarousel = () => {
				if (!projectsCarousel || !projectsCount) return;

				requestAnimationFrame(() => {
					measureProjectsStep();
					updateProjectsIndicator();
				});

				window.addEventListener('resize', () => {
					requestAnimationFrame(measureProjectsStep);
				});

				projectsCarousel.addEventListener('scroll', handleProjectsScroll, { passive: true });

				projectsButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						scrollProjectsToIndex(projectsCurrentIndex + direction);
					});
				});

				projectsDotsContainer?.addEventListener('click', (event) => {
					const dot = event.target.closest('.projects-dot');
					if (!dot) return;
					const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					scrollProjectsToIndex(targetIndex);
				});
			};

			setupProjectsCarousel();

			const valuesSlider = document.getElementById('values-slider');
			const valuesSlides = valuesSlider ? Array.from(valuesSlider.querySelectorAll('.values-slide')) : [];
			const valuesDots = document.querySelectorAll('.values-dot');
			const valuesButtons = document.querySelectorAll('#values-prev, #values-next, .values-indicator-arrow');
			const valuesCount = valuesSlides.length;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let valuesCurrentIndex = 0;
			let valuesIntervalId = null;

			const goToValuesSlide = (index) => {
				valuesCurrentIndex = (index + valuesCount) % valuesCount;
				valuesSlides.forEach((slide, i) => {
					const isActive = i === valuesCurrentIndex;
					slide.classList.toggle('is-active', isActive);
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				});
				valuesDots.forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === valuesCurrentIndex);
				});
			};

			const stopValuesAutoplay = () => {
				if (valuesIntervalId) {
					clearInterval(valuesIntervalId);
					valuesIntervalId = null;
				}
			};

			const startValuesAutoplay = () => {
				if (prefersReducedMotion || !valuesCount) return;
				stopValuesAutoplay();
				valuesIntervalId = setInterval(() => {
					goToValuesSlide(valuesCurrentIndex + 1);
				}, 4000);
			};

			const setupValuesSlider = () => {
				if (!valuesSlider || !valuesCount) return;

				valuesButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						goToValuesSlide(valuesCurrentIndex + direction);
						startValuesAutoplay();
					});
				});

				valuesDots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
						goToValuesSlide(targetIndex);
						startValuesAutoplay();
					});
				});

				valuesSlider.addEventListener('mouseenter', stopValuesAutoplay);
				valuesSlider.addEventListener('mouseleave', startValuesAutoplay);

				document.addEventListener('visibilitychange', () => {
					if (document.hidden) {
						stopValuesAutoplay();
					} else {
						startValuesAutoplay();
					}
				});

				startValuesAutoplay();
			};

			setupValuesSlider();

			const catalogsTrack = document.getElementById('catalogs-track');
			const catalogsButtons = document.querySelectorAll('#catalogs-prev, #catalogs-next');
			const catalogsDots = document.querySelectorAll('.catalogs-dot');
			const catalogsPageCount = catalogsDots.length;
			let catalogsCurrentPage = 0;
			let catalogsScrollRaf = null;

			const updateCatalogsIndicator = () => {
				catalogsDots.forEach((dot) => {
					const dotIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
					dot.classList.toggle('is-active', dotIndex === catalogsCurrentPage);
				});
				catalogsButtons.forEach((button) => {
					const action = button.getAttribute('data-action');
					if (action === 'prev') button.disabled = catalogsCurrentPage === 0;
					if (action === 'next') button.disabled = catalogsCurrentPage === catalogsPageCount - 1;
				});
			};

			const scrollCatalogsToPage = (page) => {
				if (!catalogsTrack) return;
				const clamped = Math.max(0, Math.min(page, catalogsPageCount - 1));
				catalogsCurrentPage = clamped;
				catalogsTrack.scrollTo({ left: clamped * catalogsTrack.clientWidth, behavior: 'smooth' });
				updateCatalogsIndicator();
			};

			const handleCatalogsScroll = () => {
				if (catalogsScrollRaf) return;
				catalogsScrollRaf = requestAnimationFrame(() => {
					catalogsScrollRaf = null;
					if (!catalogsTrack) return;
					const maxScroll = catalogsTrack.scrollWidth - catalogsTrack.clientWidth;
					const atEnd = maxScroll - catalogsTrack.scrollLeft < 2;
					catalogsCurrentPage = atEnd
						? catalogsPageCount - 1
						: Math.min(Math.round(catalogsTrack.scrollLeft / catalogsTrack.clientWidth), catalogsPageCount - 1);
					updateCatalogsIndicator();
				});
			};

			const setupCatalogsSlider = () => {
				if (!catalogsTrack || !catalogsPageCount) return;

				requestAnimationFrame(updateCatalogsIndicator);

				catalogsTrack.addEventListener('scroll', handleCatalogsScroll, { passive: true });

				catalogsButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const direction = button.getAttribute('data-action') === 'next' ? 1 : -1;
						scrollCatalogsToPage(catalogsCurrentPage + direction);
					});
				});

				catalogsDots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const targetIndex = Number.parseInt(dot.getAttribute('data-dot-index') || '0', 10);
						scrollCatalogsToPage(targetIndex);
					});
				});
			};

			setupCatalogsSlider();
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0f0f10;
		--text: #111;
		--muted: #666;
		--max: 1200px;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		font-family: "Arimo", "Helvetica Neue", Helvetica, Arial, sans-serif;
		color: var(--text);
		background: #fff;
	}

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
		background: #000;
	}
	/* The poster sits underneath and stays visible until the video is actually
	   playing, so a slow load or blocked autoplay leaves a static image. */
	.hero-poster,
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.hero-poster img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-video {
		object-fit: cover;
		opacity: 0;
		transition: opacity .6s ease;
	}

	.hero-video.is-ready {
		opacity: 1;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.15));
	}
	.hero-content {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #fff;
		padding: 0 1.5rem;
	}
	.hero-content .eyebrow {
		margin: 0 0 1.25rem;
		text-transform: uppercase;
		letter-spacing: .18em;
		font-size: clamp(.7rem, 1vw, .85rem);
		font-weight: 600;
		opacity: .9;
	}
	.hero-content h1 {
		margin: 0 0 2.5rem;
		max-width: 21ch;
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.1;
	}
	.hero-cta-btn {
		display: inline-block;
		padding: .85rem 2.25rem;
		border: 1px solid rgba(255, 255, 255, .85);
		border-radius: 999px;
		background: transparent;
		color: #fff;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: .12em;
		font-size: clamp(.7rem, .9vw, .8rem);
		font-weight: 600;
		transition: background-color .2s ease, color .2s ease;
	}
	.hero-cta-btn:hover,
	.hero-cta-btn:focus-visible {
		background: #fff;
		color: #2f3437;
	}
	.hero-cta-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	.container {
		width: min(var(--max), 92%);
		margin-inline: auto;
		padding: 4rem 0;
	}

	.projects-section {
		width: min(var(--max), 92%);
		margin-inline: auto;
		padding: 4rem 0;
		text-align: center;
	}

	.section-eyebrow {
		margin: 0 0 .4rem;
		font-style: italic;
		font-size: .95rem;
		color: #555;
	}

	.section-heading {
		margin: 0 0 2.5rem;
		font-size: clamp(1.6rem, 2.6vw, 2.2rem);
		font-weight: 700;
		letter-spacing: .04em;
		text-transform: uppercase;
		color: #B6AE99;
	}

	.projects-carousel-shell {
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}

	.projects-carousel-viewport {
		position: relative;
