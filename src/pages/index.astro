---
import home from "../mocks/home.json";

type AnyRecord = Record<string, any>;

const useApi = import.meta.env.PUBLIC_USE_API === "true";
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/home/";
const clientApiUrl = import.meta.env.DEV ? "/wagtail-api/api/home/" : apiUrl;
const apiOrigin = apiUrl.startsWith("http") ? new URL(apiUrl).origin : "";
const langParam = Astro.url.searchParams.get("lang")?.toLowerCase();
const requestedLang = langParam === "en" || langParam === "es" ? langParam : null;
const normalizeAssetUrl = (value: unknown): string => {
	if (!value) return "";
	if (typeof value !== "string") return "";
	if (/^https?:\/\//i.test(value)) return value;
	if (value.startsWith("/")) {
		return apiOrigin ? `${apiOrigin}${value}` : value;
	}
	return value;
};
let data = home;

if (useApi) {
	try {
		let localizedApiUrl = apiUrl;
		if (requestedLang && apiUrl.startsWith("http")) {
			const url = new URL(apiUrl);
			url.searchParams.set("locale", requestedLang);
			localizedApiUrl = url.toString();
		}
		const response = await fetch(localizedApiUrl);
		if (response.ok) {
			const payload = await response.json();
			if (payload && typeof payload === "object") {
				data = payload;
			}
		}
	} catch (error) {
		console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
	}
}

const resolvedData = data ?? home;
const resolvedFields = (resolvedData.fields ?? home.fields ?? {}) as AnyRecord;
const resolvedMeta = resolvedData.meta ?? home.meta ?? {};
const fallbackFields = (home.fields ?? {}) as AnyRecord;
const featuredProjects = Array.isArray(resolvedFields.featured_projects) ? resolvedFields.featured_projects : [];
const featuredBrands = Array.isArray(resolvedFields.featured_brands) ? resolvedFields.featured_brands : [];
const testimonials = Array.isArray(resolvedFields.testimonials) ? resolvedFields.testimonials : [];
const heroHeading = resolvedFields.hero_heading || resolvedData.title || fallbackFields.hero_heading || "Home";
const heroSubheading = resolvedFields.hero_subheading || fallbackFields.hero_subheading || "";
const introText = (resolvedFields.intro_text || fallbackFields.intro_text || "")
	.replace(/<[^>]*>/g, "")
	.replace(/&nbsp;/g, " ")
	.trim();
const heroVideoUrl = resolvedFields.hero_video_url || fallbackFields.hero_video_url || "https://www.w3schools.com/html/mov_bbb.mp4";
const heroImageUrl = resolvedFields.hero_image_fallback?.url || fallbackFields.hero_image_fallback?.url || "/images/hero-fallback.svg";
const heroImageAlt = resolvedFields.hero_image_fallback?.alt || fallbackFields.hero_image_fallback?.alt || "Policrafters";
const siteLogoCandidate = resolvedFields.site_logo ?? resolvedFields.logo ?? resolvedFields.header_logo ?? fallbackFields.site_logo ?? fallbackFields.logo ?? fallbackFields.header_logo;
const siteLogo = typeof siteLogoCandidate === "string"
	? { url: normalizeAssetUrl(siteLogoCandidate), alt: "Policrafters logo" }
	: siteLogoCandidate?.url
		? { url: normalizeAssetUrl(siteLogoCandidate.url), alt: siteLogoCandidate.alt || "Policrafters logo" }
		: { url: "/logo_black.png", alt: "Policrafters logo" };
const ctaHeading = resolvedFields.cta_heading || fallbackFields.cta_heading || "";
const ctaButtonText = resolvedFields.cta_button_text || fallbackFields.cta_button_text || "Contáctanos";
const ctaButtonUrl = resolvedFields.cta_button_url || fallbackFields.cta_button_url || "/contacto";
const normalizedLocale = typeof resolvedData.locale === "string" ? resolvedData.locale.toLowerCase() : "";
const isEsLocale = normalizedLocale.includes("es") || normalizedLocale.includes("español");
const initialApiLocale = isEsLocale ? "es" : "en";
const selectedLang = requestedLang
	? requestedLang
	: isEsLocale
		? "es"
		: "en";
const isEs = selectedLang === "es";
const appendLang = (href: string, lang: string): string => {
	const [path, query = ""] = href.split("?");
	const params = new URLSearchParams(query);
	params.set("lang", lang);
	const queryString = params.toString();
	return queryString ? `${path}?${queryString}` : path;
};
const menu = isEs
	? [
			{ key: "home", label: "Inicio", href: appendLang("/", selectedLang) },
			{ key: "projects", label: "Proyectos", href: appendLang("/proyectos", selectedLang) },
			{ key: "collections", label: "Colecciones", href: appendLang("/colecciones", selectedLang) },
			{ key: "brands", label: "Marcas", href: appendLang("/marcas", selectedLang) },
			{ key: "contact", label: "Contacto", href: appendLang("/contacto", selectedLang) }
		]
	: [
			{ key: "home", label: "Home", href: appendLang("/", selectedLang) },
			{ key: "projects", label: "Projects", href: appendLang("/proyectos", selectedLang) },
			{ key: "collections", label: "Collections", href: appendLang("/colecciones", selectedLang) },
			{ key: "brands", label: "Brands", href: appendLang("/marcas", selectedLang) },
			{ key: "contact", label: "Contact", href: appendLang("/contacto", selectedLang) }
		];
const esHref = appendLang(Astro.url.pathname + Astro.url.search, 'es');
const enHref = appendLang(Astro.url.pathname + Astro.url.search, 'en');

const localizedHeroHeading = heroHeading;
const localizedHeroSubheading = heroSubheading;
const localizedIntroText = introText;
const localizedCtaHeading = ctaHeading;
const localizedCtaButtonText = ctaButtonText;
---

<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{resolvedMeta.seo_title || resolvedData.title || home.title}</title>
		<meta name="description" content={resolvedMeta.search_description || ""} />
	</head>
	<body data-api-url={clientApiUrl} data-api-origin={apiOrigin}>
		<header class="site-header">
			<a class="logo" href="/">
				<img id="site-logo" src={siteLogo.url} alt={siteLogo.alt} />
			</a>
			<nav aria-label="Main navigation">
				<ul>
					{menu.map((item) => (
						<li><a href={item.href} data-menu-key={item.key}>{item.label}</a></li>
					))}
					<li class="lang-switch" aria-label={isEs ? "Selector de idioma" : "Language selector"}>
						<a class:list={["lang-link", isEs && "is-active"]} href={esHref}>ES</a>
						<span>/</span>
						<a class:list={["lang-link", !isEs && "is-active"]} href={enHref}>EN</a>
					</li>
				</ul>
			</nav>
		</header>

		<section class="hero">
			{heroVideoUrl ? (
				<video
					class="hero-media"
					autoplay
					muted
					loop
					playsinline
					poster={heroImageUrl}
				>
					<source src={heroVideoUrl} type="video/mp4" />
				</video>
			) : (
				<img
					class="hero-media"
					src={heroImageUrl}
					alt={heroImageAlt}
					loading="eager"
				/>
			)}
			<div class="hero-overlay" />
			<div class="hero-content">
				<p class="eyebrow">Policrafters</p>
				<h1 id="hero-heading">{localizedHeroHeading}</h1>
				<p id="hero-subheading">{localizedHeroSubheading}</p>
			</div>
		</section>

		<main>
			<section class="container intro">
				<p id="intro-text">{localizedIntroText}</p>
			</section>

			<section class="container">
				<h2 id="featured-projects-heading">{isEs ? "Proyectos destacados" : "Featured projects"}</h2>
				<div class="grid projects">
					{featuredProjects.map((p) => (
						<article class="card">
							<img src={p.thumbnail.url} alt={p.thumbnail.alt} loading="lazy" />
							<div class="card-body">
								<h3>{p.title}</h3>
								<p>{p.location}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="container brands">
				<h2 id="brands-heading">{isEs ? "Marcas" : "Brands"}</h2>
				<div class="brand-row">
					{featuredBrands.map((b) => (
						<img src={b.logo.url} alt={b.logo.alt} loading="lazy" />
					))}
				</div>
			</section>

			<section class="container testimonials">
				<h2 id="testimonials-heading">{isEs ? "Testimonios" : "Testimonials"}</h2>
				{testimonials.map((t) => (
					<blockquote>
						“{t.quote}”
						<cite>{t.author}</cite>
					</blockquote>
				))}
			</section>

			<section class="cta">
				<div class="container cta-inner">
					<h2 id="cta-heading">{localizedCtaHeading}</h2>
					<a id="cta-button" class="btn" href={ctaButtonUrl}>{localizedCtaButtonText}</a>
				</div>
			</section>
		</main>
		<aside class="debug-panel" id="debug-panel" aria-live="polite">
			<div class="debug-header">
				<p class="debug-title">API Debug</p>
				<button class="debug-toggle" id="debug-toggle" type="button" aria-expanded="true">Ocultar</button>
			</div>
			<p><strong>Lang activo:</strong> <span id="debug-active-lang">{selectedLang}</span></p>
			<p><strong>Locale API:</strong> <span id="debug-api-locale">{initialApiLocale}</span></p>
			<p><strong>Hero heading:</strong> <span id="debug-hero-heading">{localizedHeroHeading}</span></p>
			<p><strong>API URL:</strong> <span id="debug-api-url">{apiUrl}</span></p>
		</aside>
		<script is:inline type="module">
			const body = document.body;
			const apiUrl = body?.dataset?.apiUrl;
			const apiOrigin = body?.dataset?.apiOrigin || (apiUrl?.startsWith('http') ? new URL(apiUrl).origin : '');
			let apiLocale = null;
			let apiContent = null;
			const normalizeAssetUrl = (value) => {
				if (!value) return '';
				if (/^https?:\/\//i.test(value)) return value;
				if (value.startsWith('/')) {
					return apiOrigin ? `${apiOrigin}${value}` : value;
				}
				return value;
			};
			const sanitizeRichText = (value) => {
				if (typeof value !== 'string') return value ?? '';
				return value.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim();
			};
			const updateDebugPanel = ({ activeLang, localeFromApi, heroHeading, resolvedApiUrl }) => {
				document.querySelector('#debug-active-lang')?.replaceChildren(activeLang || '-');
				document.querySelector('#debug-api-locale')?.replaceChildren(localeFromApi || '-');
				document.querySelector('#debug-hero-heading')?.replaceChildren(heroHeading || '-');
				document.querySelector('#debug-api-url')?.replaceChildren(resolvedApiUrl || '-');
			};
			const debugPanel = document.querySelector('#debug-panel');
			const debugToggle = document.querySelector('#debug-toggle');
			const DEBUG_PANEL_STORAGE_KEY = 'policrafters-debug-visible';
			const syncDebugPanelVisibility = () => {
				if (!debugPanel || !debugToggle) return;
				const isVisible = localStorage.getItem(DEBUG_PANEL_STORAGE_KEY) !== 'false';
				debugPanel.classList.toggle('is-hidden', !isVisible);
				debugToggle.textContent = isVisible ? 'Ocultar' : 'Mostrar';
				debugToggle.setAttribute('aria-expanded', String(isVisible));
			};
			debugToggle?.addEventListener('click', () => {
				const shouldShow = debugPanel?.classList.contains('is-hidden');
				localStorage.setItem(DEBUG_PANEL_STORAGE_KEY, String(shouldShow));
				syncDebugPanelVisibility();
			});
			syncDebugPanelVisibility();
			const uiByLang = {
				es: {
					menu: {
						home: { label: 'Inicio', href: '/' },
						projects: { label: 'Proyectos', href: '/proyectos' },
						collections: { label: 'Colecciones', href: '/colecciones' },
						brands: { label: 'Marcas', href: '/marcas' },
						contact: { label: 'Contacto', href: '/contacto' }
					},
					sections: {
						projects: 'Proyectos destacados',
						brands: 'Marcas',
						testimonials: 'Testimonios'
					},
					content: {
						heroHeading: 'Diseño que transforma espacios',
						heroSubheading: 'Colecciones exclusivas para proyectos residenciales y comerciales.',
						introText: 'Creamos experiencias a través de mobiliario, acabados y soluciones integrales.',
						ctaHeading: '¿Listo para tu próximo proyecto?',
						ctaButton: 'Contáctanos'
					}
				},
				en: {
					menu: {
						home: { label: 'Home', href: '/' },
						projects: { label: 'Projects', href: '/proyectos' },
						collections: { label: 'Collections', href: '/colecciones' },
						brands: { label: 'Brands', href: '/marcas' },
						contact: { label: 'Contact', href: '/contacto' }
					},
					sections: {
						projects: 'Featured projects',
						brands: 'Brands',
						testimonials: 'Testimonials'
					},
					content: {
						heroHeading: 'Design that transforms spaces',
						heroSubheading: 'Exclusive collections for residential and commercial projects.',
						introText: 'We create experiences through furniture, finishes, and end-to-end interior solutions.',
						ctaHeading: 'Ready for your next project?',
						ctaButton: 'Contact us'
					}
				}
			};

			const getLangFromUrl = () => {
				const params = new URLSearchParams(window.location.search);
				const lang = params.get('lang');
				return lang === 'en' || lang === 'es' ? lang : null;
			};

			const getActiveLang = () => {
				const urlLang = getLangFromUrl();
				if (urlLang) return urlLang;
				const storedLang = localStorage.getItem('siteLang');
				if (storedLang === 'en' || storedLang === 'es') return storedLang;
				return document.documentElement.lang === 'en' ? 'en' : 'es';
			};

			const appendLang = (href, lang) => {
				const [path, query = ''] = href.split('?');
				const params = new URLSearchParams(query);
				params.set('lang', lang);
				const queryString = params.toString();
				return queryString ? `${path}?${queryString}` : path;
			};

			const buildApiUrlForLang = (lang) => {
				if (!apiUrl) return '';
				try {
					const url = new URL(apiUrl, window.location.origin);
					url.searchParams.set('locale', lang === 'es' ? 'es' : 'en');
					return url.toString();
				} catch {
					return apiUrl;
				}
			};

			const applyLanguage = (lang) => {
				const activeLang = lang === 'en' ? 'en' : 'es';
				const copy = uiByLang[activeLang];
				const contentSource = apiContent && apiLocale === activeLang ? apiContent : copy.content;
				document.documentElement.lang = activeLang;
				localStorage.setItem('siteLang', activeLang);

				document.querySelectorAll('[data-menu-key]').forEach((link) => {
					const key = link.getAttribute('data-menu-key');
					if (!key || !copy.menu[key]) return;
					link.textContent = copy.menu[key].label;
					link.setAttribute('href', appendLang(copy.menu[key].href, activeLang));
				});

				document.querySelector('#featured-projects-heading')?.replaceChildren(copy.sections.projects);
				document.querySelector('#brands-heading')?.replaceChildren(copy.sections.brands);
				document.querySelector('#testimonials-heading')?.replaceChildren(copy.sections.testimonials);
				document.querySelector('#hero-heading')?.replaceChildren(contentSource.heroHeading || '');
				document.querySelector('#hero-subheading')?.replaceChildren(contentSource.heroSubheading || '');
				document.querySelector('#intro-text')?.replaceChildren(contentSource.introText || '');
				document.querySelector('#cta-heading')?.replaceChildren(contentSource.ctaHeading || '');
				document.querySelector('#cta-button')?.replaceChildren(contentSource.ctaButton || '');
				updateDebugPanel({
					activeLang,
					localeFromApi: apiLocale,
					heroHeading: contentSource.heroHeading,
					resolvedApiUrl: buildApiUrlForLang(activeLang)
				});
				document.querySelectorAll('.lang-link').forEach((link) => {
					const linkLang = link.textContent?.trim().toLowerCase();
					link.classList.toggle('is-active', linkLang === activeLang);
				});
			};
			const setAttributeIfPresent = (selector, attribute, value) => {
				const element = document.querySelector(selector);
				if (element && value) {
					element.setAttribute(attribute, value);
				}
			};

			const applyApiData = (data) => {
				const fields = data?.fields ?? {};
				const meta = data?.meta ?? {};
				const normalizedLocale = typeof data?.locale === 'string' ? data.locale.toLowerCase() : '';
				apiLocale = normalizedLocale.includes('es') || normalizedLocale.includes('español') ? 'es' : 'en';
				apiContent = {
					heroHeading: fields.hero_heading || data?.title || '',
					heroSubheading: fields.hero_subheading || '',
					introText: sanitizeRichText(fields.intro_text),
					ctaHeading: fields.cta_heading || '',
					ctaButton: fields.cta_button_text || ''
				};
				updateDebugPanel({
					activeLang: getActiveLang(),
					localeFromApi: apiLocale,
					heroHeading: apiContent.heroHeading,
					resolvedApiUrl: buildApiUrlForLang(getActiveLang())
				});
				if (data?.title) {
					document.title = meta.seo_title || data.title;
				}
				if (meta.search_description) {
					document.querySelector('meta[name="description"]')?.setAttribute('content', meta.search_description);
				}
				const siteLogoFromApi = fields.site_logo ?? fields.logo ?? fields.header_logo;
				if (siteLogoFromApi) {
					const logoUrl = typeof siteLogoFromApi === 'string' ? normalizeAssetUrl(siteLogoFromApi) : normalizeAssetUrl(siteLogoFromApi?.url);
					const logoAlt = typeof siteLogoFromApi === 'string' ? 'Policrafters logo' : siteLogoFromApi?.alt || 'Policrafters logo';
					const logoElement = document.querySelector('#site-logo');
					if (logoElement) {
						logoElement.setAttribute('src', logoUrl);
						logoElement.setAttribute('alt', logoAlt);
					}
				}
				setAttributeIfPresent('#hero-image', 'src', fields.hero_image_fallback?.url);
				setAttributeIfPresent('#hero-image', 'alt', fields.hero_image_fallback?.alt);
				const heroMedia = document.querySelector('#hero-media');
				if (heroMedia && fields.hero_video_url) {
					heroMedia.setAttribute('src', fields.hero_video_url);
				}
				applyLanguage(getActiveLang());
			};

			const fetchAndApplyApiData = async (lang) => {
				const localizedApiUrl = buildApiUrlForLang(lang);
				if (!localizedApiUrl) return;
				try {
					const response = await fetch(localizedApiUrl, { cache: 'no-store' });
					if (!response.ok) throw new Error(`HTTP ${response.status}`);
					const payload = await response.json();
					applyApiData(payload);
				} catch (error) {
					console.warn('No se pudo cargar la API de Wagtail:', error);
				}
			};

			fetchAndApplyApiData(getActiveLang());

			const langLinks = document.querySelectorAll('.lang-link');
			langLinks.forEach((link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					const target = link.textContent?.trim().toLowerCase() === 'en' ? 'en' : 'es';
					const url = new URL(window.location.href);
					url.searchParams.set('lang', target);
					window.history.replaceState({}, '', url);
					applyLanguage(target);
					fetchAndApplyApiData(target);
				});
			});

			applyLanguage(getActiveLang());

			const siteHeader = document.querySelector('.site-header');
			const SCROLL_THRESHOLD = 40;
			const updateHeaderOnScroll = () => {
				siteHeader?.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
			};
			updateHeaderOnScroll();
			window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0f0f10;
		--text: #111;
		--muted: #666;
		--max: 1200px;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		color: var(--text);
		background: #fff;
	}

	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		width: 100%;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,0));
		transition: background-color .3s ease, box-shadow .3s ease;
	}

	.site-header.is-scrolled {
		background: #fff;
		box-shadow: 0 1px 0 #ececec;
	}

	.logo img { height: 34px; width: auto; display: block; }

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.2rem;
	}
	nav a {
		color: #fff;
		text-decoration: none;
		font-weight: 500;
		letter-spacing: .02em;
		transition: color .3s ease;
	}

	.site-header.is-scrolled nav a {
		color: #111;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: .32rem;
		color: rgba(255,255,255,.75);
		font-size: .86rem;
		letter-spacing: .08em;
		transition: color .3s ease;
	}

	.site-header.is-scrolled .lang-switch {
		color: rgba(17,17,17,.65);
	}

	.lang-link {
		opacity: .7;
		transition: opacity .2s ease;
	}

	.lang-link:hover {
		opacity: 1;
	}

	.lang-link.is-active {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: .18em;
	}

	.debug-panel {
		position: fixed;
		right: 12px;
		bottom: 12px;
		z-index: 40;
		max-width: min(420px, calc(100vw - 24px));
		padding: .8rem .9rem;
		border-radius: 10px;
		background: rgba(10, 10, 12, .9);
		border: 1px solid rgba(255, 255, 255, .2);
		color: #fff;
		font: 500 .78rem/1.35 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		backdrop-filter: blur(4px);
	}

	.debug-panel.is-hidden {
		display: none;
	}

	.debug-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: .75rem;
		margin-bottom: .35rem;
	}

	.debug-toggle {
		appearance: none;
		border: 1px solid rgba(255, 255, 255, .25);
		background: rgba(255, 255, 255, .08);
		color: #fff;
		font: inherit;
		font-size: .68rem;
		padding: .25rem .5rem;
		border-radius: 999px;
		cursor: pointer;
	}

	.debug-panel p {
		margin: 0 0 .24rem;
	}

	.debug-panel p:last-child {
		margin-bottom: 0;
	}

	.debug-title {
		font-weight: 700;
		letter-spacing: .04em;
		text-transform: uppercase;
		color: #8ee9a3;
	}

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
		background: #000;
	}
	.hero-media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.15));
	}
	.hero-content {
		position: absolute;
		left: 8%;
