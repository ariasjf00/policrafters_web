---
import home from "../mocks/home.json";

const useApi = import.meta.env.PUBLIC_USE_API === "true";
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/home/";
const apiOrigin = apiUrl.startsWith("http") ? new URL(apiUrl).origin : "";
const normalizeAssetUrl = (value) => {
	if (!value) return "";
	if (/^https?:\/\//i.test(value)) return value;
	if (value.startsWith("/")) {
		return apiOrigin ? `${apiOrigin}${value}` : value;
	}
	return value;
};
let data = home;

if (useApi) {
	try {
		const response = await fetch(apiUrl);
		if (response.ok) {
			const payload = await response.json();
			if (payload && typeof payload === "object") {
				data = payload;
			}
		}
	} catch (error) {
		console.warn(`No se pudo cargar la API desde ${apiUrl}. Usando mock local.`, error);
	}
}

const resolvedData = data ?? home;
const resolvedFields = resolvedData.fields ?? home.fields ?? {};
const resolvedMeta = resolvedData.meta ?? home.meta ?? {};
const fallbackFields = home.fields ?? {};
const featuredProjects = Array.isArray(resolvedFields.featured_projects) ? resolvedFields.featured_projects : [];
const featuredBrands = Array.isArray(resolvedFields.featured_brands) ? resolvedFields.featured_brands : [];
const testimonials = Array.isArray(resolvedFields.testimonials) ? resolvedFields.testimonials : [];
const heroHeading = resolvedFields.hero_heading || resolvedData.title || fallbackFields.hero_heading || "Home";
const heroSubheading = resolvedFields.hero_subheading || fallbackFields.hero_subheading || "";
const introText = (resolvedFields.intro_text || fallbackFields.intro_text || "")
	.replace(/<[^>]*>/g, "")
	.replace(/&nbsp;/g, " ")
	.trim();
const heroVideoUrl = resolvedFields.hero_video_url || fallbackFields.hero_video_url || "https://www.w3schools.com/html/mov_bbb.mp4";
const heroImageUrl = resolvedFields.hero_image_fallback?.url || fallbackFields.hero_image_fallback?.url || "/images/hero-fallback.svg";
const heroImageAlt = resolvedFields.hero_image_fallback?.alt || fallbackFields.hero_image_fallback?.alt || "Policrafters";
const siteLogoCandidate = resolvedFields.site_logo ?? resolvedFields.logo ?? resolvedFields.header_logo ?? fallbackFields.site_logo ?? fallbackFields.logo ?? fallbackFields.header_logo;
const siteLogo = typeof siteLogoCandidate === "string"
	? { url: normalizeAssetUrl(siteLogoCandidate), alt: "Policrafters logo" }
	: siteLogoCandidate?.url
		? { url: normalizeAssetUrl(siteLogoCandidate.url), alt: siteLogoCandidate.alt || "Policrafters logo" }
		: { url: "/logo_black.png", alt: "Policrafters logo" };
const ctaHeading = resolvedFields.cta_heading || fallbackFields.cta_heading || "";
const ctaButtonText = resolvedFields.cta_button_text || fallbackFields.cta_button_text || "Contáctanos";
const ctaButtonUrl = resolvedFields.cta_button_url || fallbackFields.cta_button_url || "/contacto";
const normalizedLocale = typeof resolvedData.locale === "string" ? resolvedData.locale.toLowerCase() : "";
const isEsLocale = normalizedLocale.includes("es") || normalizedLocale.includes("español");
const langParam = Astro.url.searchParams.get("lang")?.toLowerCase();
const selectedLang = langParam === "en" || langParam === "es"
	? langParam
	: isEsLocale
		? "es"
		: "en";
const isEs = selectedLang === "es";
const appendLang = (href, lang) => {
	const [path, query = ""] = href.split("?");
	const params = new URLSearchParams(query);
	params.set("lang", lang);
	const queryString = params.toString();
	return queryString ? `${path}?${queryString}` : path;
};
const menu = isEs
	? [
			{ key: "collections", label: "Colecciones", path: "/colecciones", href: appendLang("/colecciones", selectedLang) },
			{ key: "renovations", label: "Renovaciones", path: "/renovaciones", href: appendLang("/renovaciones", selectedLang) },
			{ key: "services", label: "Servicios", path: "/servicios", href: appendLang("/servicios", selectedLang) },
			{ key: "brands", label: "Marcas", path: "/marcas", href: appendLang("/marcas", selectedLang) },
			{ key: "contact", label: "Contáctanos", path: "/contacto", href: appendLang("/contacto", selectedLang) }
		]
	: [
			{ key: "collections", label: "Collections", path: "/colecciones", href: appendLang("/colecciones", selectedLang) },
			{ key: "renovations", label: "Renovations", path: "/renovaciones", href: appendLang("/renovaciones", selectedLang) },
			{ key: "services", label: "Services", path: "/servicios", href: appendLang("/servicios", selectedLang) },
			{ key: "brands", label: "Brands", path: "/marcas", href: appendLang("/marcas", selectedLang) },
			{ key: "contact", label: "Contact Us", path: "/contacto", href: appendLang("/contacto", selectedLang) }
		];
const currentPath = Astro.url.pathname;
const esHref = appendLang(Astro.url.pathname + Astro.url.search, 'es');
const enHref = appendLang(Astro.url.pathname + Astro.url.search, 'en');

const localizedHeroHeading = isEs
	? heroHeading
	: 'Design that transforms spaces';
const localizedHeroSubheading = isEs
	? heroSubheading
	: 'Exclusive collections for residential and commercial projects.';
const localizedIntroText = isEs
	? introText
	: 'We create experiences through furniture, finishes, and end-to-end interior solutions.';
const localizedCtaHeading = isEs
	? ctaHeading
	: 'Ready for your next project?';
const localizedCtaButtonText = isEs
	? ctaButtonText
	: 'Contact us';
---

<html lang={isEs ? "es" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{resolvedMeta.seo_title || resolvedData.title || home.title}</title>
		<meta name="description" content={resolvedMeta.search_description || ""} />
	</head>
	<body data-api-url={apiUrl}>
		<header class="site-header">
			<a class="logo" href="/">
				<img id="site-logo" src={siteLogo.url} alt={siteLogo.alt} />
			</a>
			<nav aria-label="Main navigation">
				<ul>
					{menu.map((item) => (
						<li>
							<a
								href={item.href}
								data-menu-key={item.key}
								class:list={["nav-link", currentPath === item.path && "is-active-page"]}
							>
								{item.label}
							</a>
						</li>
					))}
					<li class="search-item">
						<button type="button" class="search-icon" aria-label={isEs ? "Buscar" : "Search"}>
							<svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
								<circle cx="8.5" cy="8.5" r="6.25" stroke="currentColor" stroke-width="1.6" />
								<line x1="13.2" y1="13.2" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
							</svg>
						</button>
					</li>
					<li class="lang-switch" aria-label={isEs ? "Selector de idioma" : "Language selector"}>
						<a class:list={["lang-link", !isEs && "is-active"]} href={enHref}>EN</a>
						<span>/</span>
						<a class:list={["lang-link", isEs && "is-active"]} href={esHref}>ESP</a>
					</li>
				</ul>
			</nav>
		</header>

		<section class="hero">
			{heroVideoUrl ? (
				<video
					class="hero-media"
					autoplay
					muted
					loop
					playsinline
					poster={heroImageUrl}
				>
					<source src={heroVideoUrl} type="video/mp4" />
				</video>
			) : (
				<img
					class="hero-media"
					src={heroImageUrl}
					alt={heroImageAlt}
					loading="eager"
				/>
			)}
			<div class="hero-overlay" />
			<div class="hero-content">
				<p class="eyebrow">Policrafters</p>
				<h1 id="hero-heading">{localizedHeroHeading}</h1>
				<p id="hero-subheading">{localizedHeroSubheading}</p>
			</div>
		</section>

		<main>
			<section class="container intro">
				<p id="intro-text">{localizedIntroText}</p>
			</section>

			<section class="container">
				<h2 id="featured-projects-heading">{isEs ? "Proyectos destacados" : "Featured projects"}</h2>
				<div class="grid projects">
					{featuredProjects.map((p) => (
						<article class="card">
							<img src={p.thumbnail.url} alt={p.thumbnail.alt} loading="lazy" />
							<div class="card-body">
								<h3>{p.title}</h3>
								<p>{p.location}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="container brands">
				<h2 id="brands-heading">{isEs ? "Marcas" : "Brands"}</h2>
				<div class="brand-row">
					{featuredBrands.map((b) => (
						<img src={b.logo.url} alt={b.logo.alt} loading="lazy" />
					))}
				</div>
			</section>

			<section class="container testimonials">
				<h2 id="testimonials-heading">{isEs ? "Testimonios" : "Testimonials"}</h2>
				{testimonials.map((t) => (
					<blockquote>
						“{t.quote}”
						<cite>{t.author}</cite>
					</blockquote>
				))}
			</section>

			<section class="cta">
				<div class="container cta-inner">
					<h2 id="cta-heading">{localizedCtaHeading}</h2>
					<a id="cta-button" class="btn" href={ctaButtonUrl}>{localizedCtaButtonText}</a>
				</div>
			</section>
		</main>
		<script type="module">
			const body = document.body;
			const apiUrl = body?.dataset?.apiUrl;
			const uiByLang = {
				es: {
					menu: {
						collections: { label: 'Colecciones', href: '/colecciones' },
						renovations: { label: 'Renovaciones', href: '/renovaciones' },
						services: { label: 'Servicios', href: '/servicios' },
						brands: { label: 'Marcas', href: '/marcas' },
						contact: { label: 'Contáctanos', href: '/contacto' }
					},
					sections: {
						projects: 'Proyectos destacados',
						brands: 'Marcas',
						testimonials: 'Testimonios'
					},
					content: {
						heroHeading: 'Diseño que transforma espacios',
						heroSubheading: 'Colecciones exclusivas para proyectos residenciales y comerciales.',
						introText: 'Creamos experiencias a través de mobiliario, acabados y soluciones integrales.',
						ctaHeading: '¿Listo para tu próximo proyecto?',
						ctaButton: 'Contáctanos'
					}
				},
				en: {
					menu: {
						collections: { label: 'Collections', href: '/colecciones' },
						renovations: { label: 'Renovations', href: '/renovaciones' },
						services: { label: 'Services', href: '/servicios' },
						brands: { label: 'Brands', href: '/marcas' },
						contact: { label: 'Contact Us', href: '/contacto' }
					},
					sections: {
						projects: 'Featured projects',
						brands: 'Brands',
						testimonials: 'Testimonials'
					},
					content: {
						heroHeading: 'Design that transforms spaces',
						heroSubheading: 'Exclusive collections for residential and commercial projects.',
						introText: 'We create experiences through furniture, finishes, and end-to-end interior solutions.',
						ctaHeading: 'Ready for your next project?',
						ctaButton: 'Contact us'
					}
				}
			};

			const getLangFromUrl = () => {
				const params = new URLSearchParams(window.location.search);
				const lang = params.get('lang');
				return lang === 'en' || lang === 'es' ? lang : null;
			};

			const getActiveLang = () => {
				const urlLang = getLangFromUrl();
				if (urlLang) return urlLang;
				const storedLang = localStorage.getItem('siteLang');
				if (storedLang === 'en' || storedLang === 'es') return storedLang;
				return document.documentElement.lang === 'en' ? 'en' : 'es';
			};

			const appendLang = (href, lang) => {
				const [path, query = ''] = href.split('?');
				const params = new URLSearchParams(query);
				params.set('lang', lang);
				const queryString = params.toString();
				return queryString ? `${path}?${queryString}` : path;
			};

			const applyLanguage = (lang) => {
				const activeLang = lang === 'en' ? 'en' : 'es';
				const copy = uiByLang[activeLang];
				document.documentElement.lang = activeLang;
				localStorage.setItem('siteLang', activeLang);

				document.querySelectorAll('[data-menu-key]').forEach((link) => {
					const key = link.getAttribute('data-menu-key');
					if (!key || !copy.menu[key]) return;
					link.textContent = copy.menu[key].label;
					link.setAttribute('href', appendLang(copy.menu[key].href, activeLang));
				});

				document.querySelector('#featured-projects-heading')?.replaceChildren(copy.sections.projects);
				document.querySelector('#brands-heading')?.replaceChildren(copy.sections.brands);
				document.querySelector('#testimonials-heading')?.replaceChildren(copy.sections.testimonials);
				document.querySelector('#hero-heading')?.replaceChildren(copy.content.heroHeading);
				document.querySelector('#hero-subheading')?.replaceChildren(copy.content.heroSubheading);
				document.querySelector('#intro-text')?.replaceChildren(copy.content.introText);
				document.querySelector('#cta-heading')?.replaceChildren(copy.content.ctaHeading);
				document.querySelector('#cta-button')?.replaceChildren(copy.content.ctaButton);

				document.querySelectorAll('.lang-link').forEach((link) => {
					const linkLang = link.textContent?.trim().toLowerCase() === 'en' ? 'en' : 'es';
					link.classList.toggle('is-active', linkLang === activeLang);
				});
			};
			const setText = (selector, value) => {
				const element = document.querySelector(selector);
				if (element && value != null) {
					element.textContent = value;
				}
			};

			const setAttributeIfPresent = (selector, attribute, value) => {
				const element = document.querySelector(selector);
				if (element && value) {
					element.setAttribute(attribute, value);
				}
			};

			const applyApiData = (data) => {
				const fields = data?.fields ?? {};
				const meta = data?.meta ?? {};
				if (data?.title) {
					document.title = meta.seo_title || data.title;
				}
				if (meta.search_description) {
					document.querySelector('meta[name="description"]')?.setAttribute('content', meta.search_description);
				}
				setText('#hero-heading', fields.hero_heading);
				setText('#hero-subheading', fields.hero_subheading);
				setText('#intro-text', fields.intro_text);
				const siteLogoFromApi = fields.site_logo ?? fields.logo ?? fields.header_logo;
				if (siteLogoFromApi) {
					const logoUrl = typeof siteLogoFromApi === 'string' ? normalizeAssetUrl(siteLogoFromApi) : normalizeAssetUrl(siteLogoFromApi?.url);
					const logoAlt = typeof siteLogoFromApi === 'string' ? 'Policrafters logo' : siteLogoFromApi?.alt || 'Policrafters logo';
					const logoElement = document.querySelector('#site-logo');
					if (logoElement) {
						logoElement.setAttribute('src', logoUrl);
						logoElement.setAttribute('alt', logoAlt);
					}
				}
				setAttributeIfPresent('#hero-image', 'src', fields.hero_image_fallback?.url);
				setAttributeIfPresent('#hero-image', 'alt', fields.hero_image_fallback?.alt);
				const heroMedia = document.querySelector('#hero-media');
				if (heroMedia && fields.hero_video_url) {
					heroMedia.setAttribute('src', fields.hero_video_url);
				}
				applyLanguage(getActiveLang());
			};

			if (apiUrl) {
				fetch(apiUrl, { cache: 'no-store' })
					.then((response) => {
						if (!response.ok) throw new Error(`HTTP ${response.status}`);
						return response.json();
					})
					.then(applyApiData)
					.catch((error) => {
						console.warn('No se pudo cargar la API de Wagtail:', error);
					});
			}

			const langLinks = document.querySelectorAll('.lang-link');
			langLinks.forEach((link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					const target = link.textContent?.trim().toLowerCase() === 'en' ? 'en' : 'es';
					const url = new URL(window.location.href);
					url.searchParams.set('lang', target);
					window.history.replaceState({}, '', url);
					applyLanguage(target);
				});
			});

			applyLanguage(getActiveLang());

			const siteHeader = document.querySelector('.site-header');
			const SCROLL_THRESHOLD = 40;
			const updateHeaderOnScroll = () => {
				siteHeader?.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
			};
			updateHeaderOnScroll();
			window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0f0f10;
		--text: #111;
		--muted: #666;
		--max: 1200px;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		color: var(--text);
		background: #fff;
	}

	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		width: 100%;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		border-bottom: 1px solid #ececec;
		transition: box-shadow .3s ease;
	}

	.site-header.is-scrolled {
		box-shadow: 0 1px 0 #ececec;
	}

	.logo img { height: 34px; width: auto; display: block; }

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 1.6rem;
	}
	nav a.nav-link {
		color: #111;
		text-decoration: none;
		font-weight: 500;
		font-size: .82rem;
		letter-spacing: .06em;
		text-transform: uppercase;
		padding: .5rem .9rem;
		border-radius: 999px;
		transition: background-color .2s ease;
	}

	nav a.nav-link.is-active-page {
		background: #c9a876;
		color: #111;
	}

	.search-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: none;
		color: #111;
		padding: .25rem;
		cursor: pointer;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: .28rem;
		color: #666;
		font-size: .78rem;
		letter-spacing: .06em;
		text-transform: uppercase;
	}

	.lang-link {
		opacity: .55;
		transition: opacity .2s ease;
	}

	.lang-link:hover {
		opacity: 1;
	}

	.lang-link.is-active {
		opacity: 1;
		font-weight: 600;
	}

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
		background: #000;
	}
	.hero-media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.15));
	}
	.hero-content {
		position: absolute;
		left: 8%;
		bottom: 12%;
		color: #fff;
		max-width: 760px;
	}
	.hero-content .eyebrow {
		margin: 0 0 .5rem;
		text-transform: uppercase;
		letter-spacing: .12em;
		font-size: .82rem;
		opacity: .9;
	}
	.hero-content h1 {
		margin: 0 0 .8rem;
		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 1.05;
	}
	.hero-content p {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.3rem);
		max-width: 65ch;
	}

	.container {
		width: min(var(--max), 92%);
		margin-inline: auto;
		padding: 4rem 0;
	}

	.intro p {
		font-size: 1.2rem;
		color: #333;
		max-width: 70ch;
	}

	.grid.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}
	.card {
		border: 1px solid #ececec;
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
	}
	.card img {
		width: 100%;
		aspect-ratio: 16/10;
		object-fit: cover;
		display: block;
	}
	.card-body { padding: 1rem; }
	.card-body h3 { margin: 0 0 .35rem; }
	.card-body p { margin: 0; color: var(--muted); }

	.brand-row {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		align-items: center;
	}
	.brand-row img {
		height: 30px;
		width: auto;
		opacity: .9;
	}

	.testimonials blockquote {
		margin: 0;
		padding: 1.25rem;
		border-left: 3px solid #111;
		background: #f8f8f8;
	}
	.testimonials cite {
		display: block;
		margin-top: .7rem;
		color: var(--muted);
		font-style: normal;
	}

	.cta {
		background: var(--bg);
		color: #fff;
	}
	.cta-inner {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
	}
	.btn {
		display: inline-block;
		padding: .8rem 1.2rem;
		background: #fff;
		color: #111;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.site-header { padding: .9rem 1rem; }
		nav ul { gap: .8rem; font-size: .92rem; }
		.cta-inner { flex-direction: column; align-items: flex-start; }
	}
</style>
