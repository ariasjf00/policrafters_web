---
// Single source of truth for every page's <head> metadata: title, description,
// canonical, hreflang alternates, Open Graph/Twitter, favicons and the robots
// meta tag. Used by both PageLayout.astro (interior pages) and index.astro
// (which writes its own <head> and deliberately does not load Tailwind — see
// CLAUDE.md). No <style> block here on purpose, for the same reason: this
// component also renders on the homepage.
import { buildTitle, buildDescription, absoluteUrl, isIndexingAllowed, SITE_NAME } from '../lib/seo';
import { type Lang, LANGS, DEFAULT_LANG, otherLang, ogLocale, stripLangPrefix, localizePath } from '../lib/i18n';
import { loadSiteSettings } from '../lib/site-settings';
import { organizationLd, websiteLd } from '../lib/structured-data';

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
	/* Which languages this page actually exists in (from meta.translations).
	   Defaults to both — most content pages are generated in both languages.
	   Pages that only exist in one language (legacy redirect stubs, previews)
	   should pass noindex, which suppresses hreflang entirely (see below). */
	availableLangs?: Lang[];
	image?: { url: string; alt: string };
	noindex?: boolean;
	type?: 'website' | 'article' | 'product';
	/* Page-specific JSON-LD nodes (see src/lib/structured-data.ts). They are
	   rendered together with the sitewide Organization/WebSite nodes in one
	   @graph, on indexable pages only. */
	jsonLd?: object[];
}

const {
	title,
	description,
	lang = DEFAULT_LANG,
	availableLangs,
	image,
	noindex = false,
	type = 'website',
	jsonLd = [],
} = Astro.props;

const resolvedTitle = buildTitle(title);
const resolvedDescription = buildDescription(description);
const canonicalUrl = absoluteUrl(Astro.url.pathname, Astro.site);

// Default 1200x630 share image, generated by scripts/optimize-media.mjs as a
// cover-crop of the homepage hero poster. Still a placeholder until design
// delivers a real one — see Docs/SEO_phase3_prod_changes_pending.md.
const DEFAULT_OG_IMAGE = { url: '/images/og/policrafters-og.jpg', alt: SITE_NAME, width: 1200, height: 630 };
const usesDefaultImage = !image?.url;
const resolvedImage = usesDefaultImage ? DEFAULT_OG_IMAGE : image;
const resolvedImageUrl = absoluteUrl(resolvedImage.url, Astro.site);

const shouldNoindex = noindex || !isIndexingAllowed();

// hreflang/og:locale:alternate only make sense on indexable, real content
// pages — not on 404/preview/projects stubs, which exist in one language.
const resolvedAvailableLangs = availableLangs && availableLangs.length ? availableLangs : LANGS;
const pathWithoutLangPrefix = stripLangPrefix(Astro.url.pathname);
const hreflangLinks = shouldNoindex
	? []
	: resolvedAvailableLangs.map((l) => ({
			hreflang: l,
			href: absoluteUrl(localizePath(pathWithoutLangPrefix, l), Astro.site),
		}));
const xDefaultHref = shouldNoindex ? null : absoluteUrl(localizePath(pathWithoutLangPrefix, DEFAULT_LANG), Astro.site);

const resolvedOgLocale = ogLocale(lang);
const alternateLang = otherLang(lang);
const showAlternateLocale = !shouldNoindex && resolvedAvailableLangs.includes(alternateLang);

// Structured data only on indexable pages, same condition as hreflang. "<" is
// escaped so a CMS string can never close the <script> tag early.
const siteSettings = shouldNoindex ? null : await loadSiteSettings(lang);
const jsonLdGraph = siteSettings
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [organizationLd(siteSettings, Astro.site), websiteLd(lang, Astro.site), ...jsonLd],
		}).replace(/</g, '\\u003c')
	: null;

// Search Console / Bing Webmaster Tools ownership verification (optional).
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalUrl} />

{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
{bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}

{jsonLdGraph && <script is:inline type="application/ld+json" set:html={jsonLdGraph} />}

{hreflangLinks.map((l) => (
	<link rel="alternate" hreflang={l.hreflang} href={l.href} />
))}
{xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={resolvedImageUrl} />
<meta property="og:image:alt" content={resolvedImage.alt || SITE_NAME} />
{usesDefaultImage && <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE.width)} />}
{usesDefaultImage && <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE.height)} />}
<meta property="og:locale" content={resolvedOgLocale} />
{showAlternateLocale && <meta property="og:locale:alternate" content={ogLocale(alternateLang)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={resolvedImageUrl} />

<link rel="icon" href="/favicon.ico" sizes="any" />
<!-- public/favicon.svg carries the real Policrafters mark now — do not edit, delete
     or rename that file here; it's maintained directly in public/. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#2f3437" />
