---
// One numbered financing step (title + subtitle + plain body paragraph, no
// bullet list — unlike WarrantySection.astro). Pulled out of finance.astro
// for the same reason WarrantySection was pulled out of warranty.astro: the
// page needs to render this same block twice, once per independent column
// stack (see .finance-columns in finance.astro's <style>), and a shared
// component beats duplicating the JSX inline.
//
// Purely presentational and single-language: the host page is already
// rendered in one language (route-based i18n — see src/lib/i18n.ts), so
// there is nothing left to swap client-side.
interface Props {
  number: number;
  title: string;
  subtitle: string;
  body: string;
}

const { number, title, subtitle, body } = Astro.props;
---

<div class="finance-step" style={`order: ${number}`}>
  <h2 class="finance-step__title">
    {`${number}. `}<span>{title}</span>
  </h2>
  <p class="finance-step__subtitle">{subtitle}</p>
  <p class="finance-step__body">{body}</p>
</div>

<style>
  /* Same recipe as .warranty-section__title (WarrantySection.astro). */
  .finance-step__title {
    margin: 0 0 .4rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #111;
    overflow-wrap: anywhere;
  }

  .finance-step__subtitle {
    margin: 0 0 .75rem;
    font-style: italic;
    font-variant: small-caps;
    font-size: .85rem;
    color: #555;
  }

  /* Same recipe as .warranty-section__intro (WarrantySection.astro). */
  .finance-step__body {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #333;
  }
</style>
