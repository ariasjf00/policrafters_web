---
// Single source of truth for the site header/top nav.
// IMPORTANT: do not import ../styles/global.css here — it is `@import "tailwindcss"`,
// and index.astro deliberately does not load Tailwind. Importing it would inject
// preflight (margin/padding/border resets) into the homepage's hand-written CSS.

import { loadBrandsPageContent } from '../lib/brands-content';
import { type Lang, LANGS, localizePath, stripLangPrefix, normalizePathname } from '../lib/i18n';
import { getImageSize, resolveImage } from '../lib/images';

interface Props {
	lang: Lang;
	/* Which languages the current page exists in (from meta.translations) — see
	   SeoHead.astro/PageLayout.astro. Defaults to both. Governs where the EN/ESP
	   switcher points when the counterpart page doesn't exist. */
	availableLangs?: Lang[];
	logo?: { url: string; alt: string };
	position?: 'sticky' | 'fixed';
	scrollShadow?: boolean;
	currentPath?: string;
}

const {
	lang,
	availableLangs,
	logo = { url: '/logo_black.png', alt: 'Policrafters logo' },
	position = 'sticky',
	scrollShadow = false,
	currentPath = Astro.url.pathname,
} = Astro.props;

const isEs = lang === 'es';
const brands = await loadBrandsPageContent(lang);

// The one menu table — no separate client-side copy anymore (MENU_BY_LANG is
// gone): hrefs are already correct for `lang` at build time.
const navItems = (isEs
	? [
			{ key: 'collections', label: 'Colecciones', href: '/collections' },
			{ key: 'renovations', label: 'Renovaciones', href: '/renovations' },
			{ key: 'services', label: 'Servicios', href: '/services' },
			{ key: 'brands', label: 'Marcas', href: '' },
			{ key: 'contact', label: 'Contáctanos', href: '/contact-us' },
		]
	: [
			{ key: 'collections', label: 'Collections', href: '/collections' },
			{ key: 'renovations', label: 'Renovations', href: '/renovations' },
			{ key: 'services', label: 'Services', href: '/services' },
			{ key: 'brands', label: 'Brands', href: '' },
			{ key: 'contact', label: 'Contact Us', href: '/contact-us' },
		]
).map((item) => ({ ...item, href: item.href ? localizePath(item.href, lang) : item.href }));

// Brands mega menu, single language now — no more EN/ES pairing by key/index.
// TODO: replace the '#' placeholders with each brand's real external URL.
const brandLinks: {
	key: string;
	url: string;
	image: { url: string; alt: string } | null;
	placeholder: string;
}[] = (() => {
	const logos = Array.isArray(brands.fields?.brand_logos) ? brands.fields.brand_logos : [];

	const toSafeText = (value: unknown, fallback = '') =>
		typeof value === 'string' && value.trim() ? value : fallback;

	return logos.map((logo, index) => {
		const placeholder = toSafeText(logo?.placeholder_text, 'Crafters Design & Renovations logo');
		const imageUrl = toSafeText(logo?.image?.url);
		const alt = toSafeText(logo?.image?.alt, placeholder);

		return {
			key: toSafeText(logo?.key, `brand-${index + 1}`),
			url: '#',
			image: imageUrl ? { url: imageUrl, alt } : null,
			placeholder,
		};
	});
})();
const isExternal = (url: string) => /^https?:\/\//.test(url);

// Real intrinsic size of the logo so it reserves its space (CSS still sets the rendered height).
const logoSize = getImageSize(logo.url);

// Tolerate a trailing slash so /collections/ keeps its active-page highlight,
// and compare against the path with any /es prefix stripped, since navItems'
// hrefs are already localized.
const normalizedPath = stripLangPrefix(normalizePathname(currentPath)).replace(/\/+$/, '') || '/';

// EN/ESP switcher: plain links to the same page in the other language — no
// auto-redirect, no localStorage. If the page doesn't exist in that language
// (meta.translations), fall back to that language's home.
const resolvedAvailableLangs = availableLangs && availableLangs.length ? availableLangs : LANGS;
const currentPagePath = stripLangPrefix(normalizePathname(Astro.url.pathname)) + Astro.url.search;
const hrefForLang = (target: Lang) =>
	resolvedAvailableLangs.includes(target) ? localizePath(currentPagePath, target) : (target === 'es' ? '/es' : '/');
const enHref = hrefForLang('en');
const esHref = hrefForLang('es');
---

<header
	class:list={['site-header', position === 'fixed' && 'is-fixed']}
	data-scroll-shadow={scrollShadow ? '' : undefined}
>
	<a class="logo" href={localizePath('/', lang)}>
		<img id="site-logo" src={logo.url} alt={logo.alt} width={logoSize.width} height={logoSize.height} decoding="async" />
	</a>
	<button
		type="button"
		class="nav-toggle"
		aria-expanded="false"
		aria-controls="primary-nav"
		aria-label={isEs ? 'Abrir menú' : 'Open menu'}
	>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
	</button>
	<div class="nav-backdrop"></div>
	<nav id="primary-nav" aria-label="Main navigation">
		<ul>
			{navItems.map((item) => (
				item.key === 'brands' ? (
					<li class="brands-item">
						<button
							type="button"
							class="nav-link nav-trigger"
							data-menu-key={item.key}
							aria-expanded="false"
							aria-controls="brands-menu"
						>
							<span class="nav-trigger-label">{item.label}</span>
							<svg class="nav-trigger-chevron" viewBox="0 0 10 6" width="10" height="6" fill="none" aria-hidden="true">
								<path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<!-- Lives inside the <li> so one markup serves both layouts: on desktop it is
						     absolutely positioned against .site-header (nav/ul/li stay unpositioned);
						     inside the mobile drawer it flows as an accordion under the trigger. -->
						<div id="brands-menu" class="brands-menu">
							<div class="brands-menu__grid">
								{brandLinks.map((brand) => {
									const isPlaceholder = !brand.image;
									const cellClass = isPlaceholder
										? 'brands-menu__cell brands-menu__cell--placeholder'
										: 'brands-menu__cell';

									return isPlaceholder ? (
										<div
											class={cellClass}
											data-brand-key={brand.key}
											aria-label={brand.placeholder}
										>
											<span class="brands-menu__placeholder">{brand.placeholder}</span>
										</div>
									) : (
										<a
											class={cellClass}
											href={brand.url}
											data-brand-key={brand.key}
											target={isExternal(brand.url) ? '_blank' : undefined}
											rel={isExternal(brand.url) ? 'noopener noreferrer' : undefined}
										>
											<img
												class="brands-menu__image"
												{...resolveImage(brand.image ?? undefined, { sizes: '220px', maxSrcWidth: 480 })}
												loading="lazy"
												decoding="async"
											/>
										</a>
									);
								})}
							</div>
						</div>
					</li>
				) : (
					<li>
						<a
							href={item.href}
							data-menu-key={item.key}
							class:list={["nav-link", normalizedPath === item.href && "is-active-page"]}
						>
							{item.label}
						</a>
					</li>
				)
			))}
			<li class="search-item">
				<button type="button" class="search-icon" aria-label={isEs ? 'Buscar' : 'Search'}>
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="6.25" stroke="currentColor" stroke-width="1.6" />
						<line x1="13.2" y1="13.2" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</button>
			</li>
			<li class="lang-switch" aria-label={isEs ? 'Selector de idioma' : 'Language selector'}>
				<a class:list={["lang-link", !isEs && "is-active"]} href={enHref} data-lang="en">EN</a>
				<span>/</span>
				<a class:list={["lang-link", isEs && "is-active"]} href={esHref} data-lang="es">ESP</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	// Header no longer owns any language state — each page is single-language
	// (route-based i18n, src/lib/i18n.ts) and the EN/ESP switcher above is a
	// plain server-rendered link. This script only handles: the mobile nav
	// drawer, the brands disclosure, the scroll-shadow effect, keeping the
	// language switcher's query string/hash in sync with client-side URL
	// changes (e.g. a collections category filter), and Wagtail preview.
	import { toDevApiUrl } from '../lib/dev-proxy';

	const header = document.querySelector('.site-header');

	const hasPreviewFlag = (value) => {
		const normalized = typeof value === 'string' ? value.trim().toLowerCase() : '';
		return normalized === '1' || normalized === 'true' || normalized === 'yes' || normalized === 'on';
	};

	const setPreviewState = (value) => {
		if (value) {
			localStorage.setItem('sitePreview', '1');
			return true;
		}
		localStorage.removeItem('sitePreview');
		return false;
	};

	const getPreviewState = () => {
		const params = new URLSearchParams(window.location.search);
		const previewInUrl = hasPreviewFlag(params.get('preview'));
		if (previewInUrl) {
			return setPreviewState(true);
		}
		const stored = localStorage.getItem('sitePreview');
		return stored === '1' || stored === 'true';
	};

	// The switcher's href is built at render time from Astro.url.search, which
	// only sees the query string the page was *requested* with. If a filter
	// (e.g. collections' ?category=) changes the URL client-side afterwards via
	// history.replaceState, keep the switcher's query string/hash in sync.
	const syncLangSwitcherQuery = () => {
		const search = window.location.search;
		const hash = window.location.hash;
		header?.querySelectorAll('.lang-link').forEach((link) => {
			const base = (link.getAttribute('href') || '').split('?')[0].split('#')[0];
			link.setAttribute('href', `${base}${search}${hash}`);
		});
	};
	syncLangSwitcherQuery();

	const navToggle = header?.querySelector('.nav-toggle');
	const primaryNav = header?.querySelector('nav[aria-label="Main navigation"]');
	const navBackdrop = header?.querySelector('.nav-backdrop');
	const mobileNavQuery = window.matchMedia('(max-width: 900px)');

	// Brands mega menu: a disclosure, not a link, so the visitor stays on their page.
	const brandsTrigger = header?.querySelector('.nav-trigger');
	const brandsMenu = header?.querySelector('#brands-menu');

	const setBrandsOpen = (open) => {
		if (!brandsTrigger || !brandsMenu) return;
		brandsTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
		brandsMenu.classList.toggle('is-open', open);
	};
	const closeBrands = () => setBrandsOpen(false);

	if (brandsTrigger && brandsMenu) {
		brandsTrigger.addEventListener('click', () => {
			setBrandsOpen(brandsTrigger.getAttribute('aria-expanded') !== 'true');
		});
		brandsMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeBrands));
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (brandsTrigger.contains(target) || brandsMenu.contains(target)) return;
			closeBrands();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || brandsTrigger.getAttribute('aria-expanded') !== 'true') return;
			closeBrands();
			brandsTrigger.focus();
		});
		mobileNavQuery.addEventListener('change', closeBrands);
	}

	const closeMenu = () => {
		closeBrands();
		if (!navToggle || !primaryNav || !navBackdrop) return;
		navToggle.setAttribute('aria-expanded', 'false');
		primaryNav.classList.remove('is-open');
		navBackdrop.classList.remove('is-open');
		document.body.style.overflow = '';
	};

	const openMenu = () => {
		if (!navToggle || !primaryNav || !navBackdrop) return;
		navToggle.setAttribute('aria-expanded', 'true');
		primaryNav.classList.add('is-open');
		navBackdrop.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	if (navToggle && primaryNav && navBackdrop) {
		navToggle.addEventListener('click', () => {
			const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
			if (isOpen) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		navBackdrop.addEventListener('click', closeMenu);

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});

		mobileNavQuery.addEventListener('change', (event) => {
			if (!event.matches) closeMenu();
		});
	}

	header?.querySelectorAll('.lang-link').forEach((link) => link.addEventListener('click', closeMenu));

	// Runs on every page: `is-scrolled` compacts the header. The drop shadow it also
	// drives is gated in CSS behind [data-scroll-shadow], so it stays home-page only.
	if (header) {
		const SCROLL_THRESHOLD = 40;
		const updateHeaderOnScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
		};
		updateHeaderOnScroll();
		window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
	}

	const brandsApiUrl = toDevApiUrl(import.meta.env.PUBLIC_BRANDS_API_URL || '', 'browser');
	const brandsGrid = document.querySelector('.brands-menu__grid');
	const staticBrandMenuMarkup = brandsGrid ? brandsGrid.innerHTML : '';
	const restoreStaticBrandsMenu = () => {
		if (!brandsGrid || !staticBrandMenuMarkup) return;
		brandsGrid.innerHTML = staticBrandMenuMarkup;
	};

	// The page itself is single-language, so preview only ever needs this page's
	// own language, read from <html lang> — not resolved from a URL/localStorage.
	const pageLang = document.documentElement.lang === 'es' ? 'es' : 'en';

	const readPreviewStatus = () => {
		const apiEnabled = import.meta.env.PUBLIC_USE_API === 'true' && Boolean(brandsApiUrl);
		if (!apiEnabled) {
			setPreviewState(false);
			restoreStaticBrandsMenu();
			return false;
		}

		const previewEnabled = getPreviewState();
		if (import.meta.env.DEV) {
			console.debug('[header-preview]', {
				preview: previewEnabled,
				source: previewEnabled ? 'runtime' : 'static',
				endpoint: previewEnabled ? brandsApiUrl : null,
				lang: pageLang
			});
		}
		return previewEnabled;
	};

	const escapeHtml = (value) => String(value ?? '')
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#039;');

	const renderBrandsMenuFromPayload = (payload, lang) => {
		const grid = document.querySelector('.brands-menu__grid');
		if (!grid || !payload || typeof payload !== 'object') return;

		const logos = Array.isArray(payload?.fields?.brand_logos) ? payload.fields.brand_logos : [];
		if (!logos.length) return;

		const html = logos.map((logo, index) => {
			const key = encodeURIComponent(logo?.key || `brand-${index + 1}`);
			const imageUrl = typeof logo?.image?.url === 'string' ? logo.image.url : '';
			const labelText = logo?.placeholder_text || (lang === 'es' ? 'Marca' : 'Brand');
			const safeLabel = escapeHtml(labelText);
			const altText = typeof logo?.image?.alt === 'string' ? logo.image.alt : labelText;

			if (!imageUrl) {
				return `
					<div
						class="brands-menu__cell brands-menu__cell--placeholder"
						data-brand-key="${key}"
						aria-label="${safeLabel}"
					>
						<span class="brands-menu__placeholder">${safeLabel}</span>
					</div>
				`;
			}

			return `
				<a
					class="brands-menu__cell"
					href="#"
					data-brand-key="${key}"
					aria-label="${escapeHtml(altText)}"
				>
					<img
						class="brands-menu__image"
						src="${escapeHtml(imageUrl)}"
						alt="${escapeHtml(altText)}"
						loading="lazy"
						decoding="async"
						style="width:100%;max-width:220px;height:120px;object-fit:contain;"
					/>
				</a>
			`;
		}).join('');

		grid.innerHTML = html;
	};

	const hydratePreviewBrands = async () => {
		if (!readPreviewStatus() || !brandsApiUrl) {
			restoreStaticBrandsMenu();
			return;
		}

		try {
			const url = new URL(brandsApiUrl);
			url.searchParams.set('locale', pageLang);
			url.searchParams.set('lang', pageLang);
			if (import.meta.env.DEV) {
				console.debug('[brands-header-fetch]', { preview: true, source: 'runtime', endpoint: url.toString(), lang: pageLang, cache: 'no-store' });
			}
			const response = await fetch(url.toString(), { cache: 'no-store' });
			if (!response.ok) {
				throw new Error(`Brands ${pageLang} status ${response.status}`);
			}
			const payload = await response.json();
			renderBrandsMenuFromPayload(payload, pageLang);
		} catch (error) {
			if (import.meta.env.DEV) {
				console.warn('[brands-header-fetch] Preview runtime failed; keeping static content.', error);
			}
		}
	};

	window.addEventListener('message', (event) => {
		if (event.data?.type !== 'policrafters-preview') return;
		const previewEnabled = setPreviewState(true);
		if (import.meta.env.DEV) {
			console.debug('[header-preview]', {
				preview: previewEnabled,
				source: 'runtime-message',
				endpoint: brandsApiUrl || null,
				lang: pageLang
			});
		}
		void hydratePreviewBrands();
	});

	restoreStaticBrandsMenu();
	void hydratePreviewBrands();
</script>

<style>
	/* Astro scopes `*` to this component's own elements, so this does not leak out.
	   It is required because index.astro has no Tailwind preflight to fall back on. */
	* { box-sizing: border-box; }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		width: 100%;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		border-bottom: 1px solid #ececec;
		transition: padding .25s ease;
	}

	/* Home page: overlays the 100vh hero, so it must be out of flow. */
	.site-header.is-fixed {
		position: fixed;
		left: 0;
		transition: padding .25s ease, box-shadow .3s ease;
	}

	/* Compacted state, applied past the scroll threshold and removed at the top.
	   Only the vertical padding is touched so the mobile breakpoint keeps its own
	   horizontal padding. */
	.site-header.is-scrolled {
		padding-top: .45rem;
		padding-bottom: .45rem;
	}

	/* The drop shadow stays opt-in (home page only); the compacting above is not. */
	.site-header[data-scroll-shadow].is-scrolled {
		box-shadow: 0 1px 0 #ececec;
	}

	.logo img {
		height: 34px;
		width: auto;
		display: block;
		transition: height .25s ease;
	}

	.site-header.is-scrolled .logo img {
		height: 24px;
	}

	/* The compacting is a size change; honour a reduced-motion preference by
	   snapping between states instead of animating. */
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header.is-fixed,
		.logo img {
			transition: none;
		}
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 1.6rem;
	}

	nav .nav-link {
		color: #2f3437;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.5rem 0.9rem;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	nav .nav-link:hover,
	nav .nav-link:focus-visible {
		background: #b6ae99;
		color: #ffffff;
	}

	nav .nav-link.is-active-page {
		background: #c9a876;
		color: #2f3437;
	}

	/* Brands trigger: a <button> dressed as a nav link. */
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: none;
		background: none;
		font-family: inherit;
		line-height: inherit;
		cursor: pointer;
	}

	.nav-trigger[aria-expanded="true"] {
		background: #b6ae99;
		color: #ffffff;
	}

	.nav-trigger-chevron {
		transition: transform 0.2s ease;
	}

	.nav-trigger[aria-expanded="true"] .nav-trigger-chevron {
		transform: rotate(180deg);
	}

	/* Brands mega menu — full-width band dropping from under the header.
	   Cell rules ported from the brands page's logo row. */
	.brands-menu {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: #fff;
		border-top: 1px solid #ececec;
		border-bottom: 1px solid #2f3437;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
		visibility: hidden;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
	}

	.brands-menu.is-open {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
	}

	.brands-menu__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.brands-menu__cell {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 2rem;
		min-height: 160px;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s ease;
		width: 100%;
		max-width: 100%;
	}

	.brands-menu__cell:visited,
	.brands-menu__cell:hover,
	.brands-menu__cell:focus-visible,
	.brands-menu__cell:active {
		color: inherit;
		text-decoration: none;
	}

	.brands-menu__cell--placeholder {
		pointer-events: none;
		cursor: default;
		background: #f6f3ee;
		border: 1px solid rgba(47, 52, 55, 0.12);
		box-shadow: inset 0 0 0 1px rgba(182, 174, 153, 0.15);
		color: inherit;
		text-decoration: none;
	}

	.brands-menu__cell:hover,
	.brands-menu__cell:focus-visible {
		background: #f7f5f0;
	}

	.brands-menu__cell--placeholder:hover,
	.brands-menu__cell--placeholder:focus-visible {
		background: #f6f3ee;
	}

	/* Solid 1px vertical rule between cells. */
	.brands-menu__cell + .brands-menu__cell {
		border-left: 1px solid #2f3437;
	}

	.brands-menu__image {
		width: 100%;
		max-width: 220px;
		height: 120px;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
		transform: translateZ(0);
	}

	/* The Crafters Design & Renovations logo isn't ready yet — styled
	   placeholder text stands in for it until the real artwork exists. */
	.brands-menu__placeholder {
		max-width: 20ch;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 72px;
		padding: 0.8rem 1rem;
		text-align: center;
		font-size: clamp(0.9rem, 1.4vw, 1.2rem);
		font-weight: 700;
