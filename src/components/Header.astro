---
// Single source of truth for the site header/top nav.
// IMPORTANT: do not import ../styles/global.css here — it is `@import "tailwindcss"`,
// and index.astro deliberately does not load Tailwind. Importing it would inject
// preflight (margin/padding/border resets) into the homepage's hand-written CSS.

interface Props {
	lang?: 'es' | 'en';
	logo?: { url: string; alt: string };
	position?: 'sticky' | 'fixed';
	scrollShadow?: boolean;
	currentPath?: string;
}

const {
	lang = 'es',
	logo = { url: '/logo_black.png', alt: 'Policrafters logo' },
	position = 'sticky',
	scrollShadow = false,
	currentPath = Astro.url.pathname,
} = Astro.props;

const isEs = lang === 'es';

// The one menu table. Its client-side twin lives in this file's <script>; keeping both
// here is what prevents the 4-way drift this component exists to fix.
const navItems = isEs
	? [
			{ key: 'collections', label: 'Colecciones', href: '/collections' },
			{ key: 'renovations', label: 'Renovaciones', href: '/renovations' },
			{ key: 'services', label: 'Servicios', href: '/services' },
			{ key: 'brands', label: 'Marcas', href: '' },
			{ key: 'contact', label: 'Contáctanos', href: '/contact-us' },
		]
	: [
			{ key: 'collections', label: 'Collections', href: '/collections' },
			{ key: 'renovations', label: 'Renovations', href: '/renovations' },
			{ key: 'services', label: 'Services', href: '/services' },
			{ key: 'brands', label: 'Brands', href: '' },
			{ key: 'contact', label: 'Contact Us', href: '/contact-us' },
		];

// English is the default, so it is never stamped into a URL; Spanish always is.
const appendLang = (href: string, value: string) => {
	const [path, query = ''] = href.split('?');
	const params = new URLSearchParams(query);
	if (value === 'es') params.set('lang', 'es');
	else params.delete('lang');
	const queryString = params.toString();
	return queryString ? `${path}?${queryString}` : path;
};

// Brands mega menu. Both languages ship in data-* attributes so the client
// script can swap them in place — no third copy of this table in <script>.
// TODO: replace the '#' placeholders with each brand's real external URL.
const brandLinks: {
	key: string;
	url: string;
	image: { url: string; alt: { en: string; es: string } } | null;
	placeholder: { en: string; es: string };
}[] = [
	{
		key: 'crafters',
		url: '#',
		image: null,
		placeholder: {
			en: 'Crafters Design & Renovations logo',
			es: 'Logo Crafters Design & Renovations',
		},
	},
	{
		key: 'alutech',
		url: '#',
		image: {
			url: '/images/pages/Logo-Alutech-USA.png',
			alt: { en: 'Alutech USA logo', es: 'Logo de Alutech USA' },
		},
		placeholder: { en: '', es: '' },
	},
	{
		key: 'glasstech',
		url: '#',
		image: {
			url: '/images/pages/Logo-Glasstech.png',
			alt: { en: 'Glasstech USA logo', es: 'Logo de Glasstech USA' },
		},
		placeholder: { en: '', es: '' },
	},
];
const isExternal = (url: string) => /^https?:\/\//.test(url);

// Tolerate a trailing slash so /collections/ keeps its active-page highlight.
const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
const esHref = appendLang(Astro.url.pathname + Astro.url.search, 'es');
const enHref = appendLang(Astro.url.pathname + Astro.url.search, 'en');
---

<header
	class:list={['site-header', position === 'fixed' && 'is-fixed']}
	data-scroll-shadow={scrollShadow ? '' : undefined}
>
	<a class="logo" href="/">
		<img id="site-logo" src={logo.url} alt={logo.alt} />
	</a>
	<button
		type="button"
		class="nav-toggle"
		aria-expanded="false"
		aria-controls="primary-nav"
		aria-label={isEs ? 'Abrir menú' : 'Open menu'}
	>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
	</button>
	<div class="nav-backdrop"></div>
	<nav id="primary-nav" aria-label="Main navigation">
		<ul>
			{navItems.map((item) => (
				item.key === 'brands' ? (
					<li class="brands-item">
						<button
							type="button"
							class="nav-link nav-trigger"
							data-menu-key={item.key}
							aria-expanded="false"
							aria-controls="brands-menu"
						>
							<span class="nav-trigger-label">{item.label}</span>
							<svg class="nav-trigger-chevron" viewBox="0 0 10 6" width="10" height="6" fill="none" aria-hidden="true">
								<path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<!-- Lives inside the <li> so one markup serves both layouts: on desktop it is
						     absolutely positioned against .site-header (nav/ul/li stay unpositioned);
						     inside the mobile drawer it flows as an accordion under the trigger. -->
						<div id="brands-menu" class="brands-menu">
							<div class="brands-menu__grid">
								{brandLinks.map((brand) => (
									<a
										class="brands-menu__cell"
										href={brand.url}
										data-brand-key={brand.key}
										target={isExternal(brand.url) ? '_blank' : undefined}
										rel={isExternal(brand.url) ? 'noopener noreferrer' : undefined}
									>
										{brand.image ? (
											<img
												class="brands-menu__image"
												src={brand.image.url}
												alt={isEs ? brand.image.alt.es : brand.image.alt.en}
												data-alt-en={brand.image.alt.en}
												data-alt-es={brand.image.alt.es}
												loading="lazy"
												decoding="async"
											/>
										) : (
											<span
												class="brands-menu__placeholder"
												data-copy-en={brand.placeholder.en}
												data-copy-es={brand.placeholder.es}
											>{isEs ? brand.placeholder.es : brand.placeholder.en}</span>
										)}
									</a>
								))}
							</div>
						</div>
					</li>
				) : (
					<li>
						<a
							href={appendLang(item.href, lang)}
							data-menu-key={item.key}
							class:list={["nav-link", normalizedPath === item.href && "is-active-page"]}
						>
							{item.label}
						</a>
					</li>
				)
			))}
			<li class="search-item">
				<button type="button" class="search-icon" aria-label={isEs ? 'Buscar' : 'Search'}>
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="6.25" stroke="currentColor" stroke-width="1.6" />
						<line x1="13.2" y1="13.2" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</button>
			</li>
			<li class="lang-switch" aria-label={isEs ? 'Selector de idioma' : 'Language selector'}>
				<a class:list={["lang-link", !isEs && "is-active"]} href={enHref} data-lang="en">EN</a>
				<span>/</span>
				<a class:list={["lang-link", isEs && "is-active"]} href={esHref} data-lang="es">ESP</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	// This component owns the site's language state.
	// INVARIANT: only this file dispatches `sitelangchange`. Subscribers (Footer,
	// index, collections) self-boot then listen — they must never re-dispatch, or
	// Header's boot -> subscriber -> re-dispatch becomes a feedback loop.
	const MENU_BY_LANG = {
		es: {
			collections: { label: 'Colecciones', href: '/collections' },
			renovations: { label: 'Renovaciones', href: '/renovations' },
			services: { label: 'Servicios', href: '/services' },
			brands: { label: 'Marcas', href: '' },
			contact: { label: 'Contáctanos', href: '/contact-us' }
		},
		en: {
			collections: { label: 'Collections', href: '/collections' },
			renovations: { label: 'Renovations', href: '/renovations' },
			services: { label: 'Services', href: '/services' },
			brands: { label: 'Brands', href: '' },
			contact: { label: 'Contact Us', href: '/contact-us' }
		}
	};

	const header = document.querySelector('.site-header');

	const getLangFromUrl = () => {
		const params = new URLSearchParams(window.location.search);
		const lang = params.get('lang');
		return lang === 'en' || lang === 'es' ? lang : null;
	};

	// Mirrors the frontmatter helper: English stays out of the URL, Spanish is stamped in.
	const appendLang = (href, lang) => {
		const [path, query = ''] = href.split('?');
		const params = new URLSearchParams(query);
		if (lang === 'es') params.set('lang', 'es');
		else params.delete('lang');
		const queryString = params.toString();
		return queryString ? `${path}?${queryString}` : path;
	};

	// url -> localStorage -> 'en'. Seeds `siteLang` on first visit so subscribers
	// (Footer, ScrollToTop, collections) all read the same stored value.
	const resolveActiveLang = () => {
		const langInUrl = getLangFromUrl();
		if (langInUrl) return langInUrl;
		const stored = localStorage.getItem('siteLang');
		if (stored === 'en' || stored === 'es') return stored;
		localStorage.setItem('siteLang', 'en');
		return 'en';
	};

	const applyHeaderLanguage = (lang) => {
		const activeLang = lang === 'en' ? 'en' : 'es';
		const copy = MENU_BY_LANG[activeLang];
		localStorage.setItem('siteLang', activeLang);
		document.documentElement.lang = activeLang;

		if (header) {
			header.querySelectorAll('[data-menu-key]').forEach((link) => {
				const key = link.getAttribute('data-menu-key');
				if (!key || !copy[key]) return;
				// The Brands trigger is a <button> with a chevron: only its label changes, no href.
				if (link.tagName !== 'A') {
					const label = link.querySelector('.nav-trigger-label');
					if (label) label.textContent = copy[key as keyof typeof copy].label;
					return;
				}
				link.textContent = copy[key].label;
				link.setAttribute('href', appendLang(copy[key].href, activeLang));
			});

			header.querySelectorAll('.brands-menu [data-copy-en]').forEach((node) => {
				node.textContent = node.getAttribute(`data-copy-${activeLang}`) ?? '';
			});
			header.querySelectorAll('.brands-menu [data-alt-en]').forEach((img) => {
				img.setAttribute('alt', img.getAttribute(`data-alt-${activeLang}`) ?? '');
			});

			header.querySelectorAll('.lang-link').forEach((link) => {
				const linkLang = link.dataset.lang === 'en' ? 'en' : 'es';
				link.classList.toggle('is-active', linkLang === activeLang);
				// Keep the href truthful so middle-click / copy-link yield the right language.
				link.setAttribute('href', appendLang(window.location.pathname + window.location.search, linkLang));
			});

			const toggle = header.querySelector('.nav-toggle');
			toggle?.setAttribute('aria-label', activeLang === 'es' ? 'Abrir menú' : 'Open menu');
			const search = header.querySelector('.search-icon');
			search?.setAttribute('aria-label', activeLang === 'es' ? 'Buscar' : 'Search');
			const langSwitch = header.querySelector('.lang-switch');
			langSwitch?.setAttribute('aria-label', activeLang === 'es' ? 'Selector de idioma' : 'Language selector');
		}

		document.dispatchEvent(new CustomEvent('sitelangchange', { detail: activeLang }));
	};

	const navToggle = header?.querySelector('.nav-toggle');
	const primaryNav = header?.querySelector('nav[aria-label="Main navigation"]');
	const navBackdrop = header?.querySelector('.nav-backdrop');
	const mobileNavQuery = window.matchMedia('(max-width: 900px)');

	// Brands mega menu: a disclosure, not a link, so the visitor stays on their page.
	const brandsTrigger = header?.querySelector<HTMLButtonElement>('.nav-trigger');
	const brandsMenu = header?.querySelector<HTMLElement>('#brands-menu');

	const setBrandsOpen = (open: boolean) => {
		if (!brandsTrigger || !brandsMenu) return;
		brandsTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
		brandsMenu.classList.toggle('is-open', open);
	};
	const closeBrands = () => setBrandsOpen(false);

	if (brandsTrigger && brandsMenu) {
		brandsTrigger.addEventListener('click', () => {
			setBrandsOpen(brandsTrigger.getAttribute('aria-expanded') !== 'true');
		});
		brandsMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeBrands));
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (brandsTrigger.contains(target) || brandsMenu.contains(target)) return;
			closeBrands();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || brandsTrigger.getAttribute('aria-expanded') !== 'true') return;
			closeBrands();
			brandsTrigger.focus();
		});
		mobileNavQuery.addEventListener('change', closeBrands);
	}

	const closeMenu = () => {
		closeBrands();
		if (!navToggle || !primaryNav || !navBackdrop) return;
		navToggle.setAttribute('aria-expanded', 'false');
		primaryNav.classList.remove('is-open');
		navBackdrop.classList.remove('is-open');
		document.body.style.overflow = '';
	};

	const openMenu = () => {
		if (!navToggle || !primaryNav || !navBackdrop) return;
		navToggle.setAttribute('aria-expanded', 'true');
		primaryNav.classList.add('is-open');
		navBackdrop.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	if (navToggle && primaryNav && navBackdrop) {
		navToggle.addEventListener('click', () => {
			const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
			if (isOpen) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		navBackdrop.addEventListener('click', closeMenu);

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});

		mobileNavQuery.addEventListener('change', (event) => {
			if (!event.matches) closeMenu();
		});
	}

	header?.querySelectorAll('.lang-link').forEach((link) => {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			const target = link.dataset.lang === 'en' ? 'en' : 'es';
			localStorage.setItem('siteLang', target);
			applyHeaderLanguage(target);
			syncLangInUrl(target);
			closeMenu();
		});
	});

	// Runs on every page: `is-scrolled` compacts the header. The drop shadow it also
	// drives is gated in CSS behind [data-scroll-shadow], so it stays home-page only.
	if (header) {
		const SCROLL_THRESHOLD = 40;
		const updateHeaderOnScroll = () => {
			header.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
		};
		updateHeaderOnScroll();
		window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
	}

	// English is the default, so keep it out of the URL: only Spanish is stamped in.
	// A redundant ?lang=en is stripped so shared links stay canonical.
	const syncLangInUrl = (lang) => {
		const nextUrl = new URL(window.location.href);
		const current = nextUrl.searchParams.get('lang');
		if (lang === 'en') {
			if (current === null) return;
			nextUrl.searchParams.delete('lang');
		} else {
			if (current === 'es') return;
			nextUrl.searchParams.set('lang', 'es');
		}
		window.history.replaceState({}, '', nextUrl);
	};

	const activeLang = resolveActiveLang();
	syncLangInUrl(activeLang);
	applyHeaderLanguage(activeLang);
</script>

<style>
	/* Astro scopes `*` to this component's own elements, so this does not leak out.
	   It is required because index.astro has no Tailwind preflight to fall back on. */
	* { box-sizing: border-box; }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		width: 100%;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		border-bottom: 1px solid #ececec;
		transition: padding .25s ease;
	}

	/* Home page: overlays the 100vh hero, so it must be out of flow. */
	.site-header.is-fixed {
		position: fixed;
		left: 0;
		transition: padding .25s ease, box-shadow .3s ease;
	}

	/* Compacted state, applied past the scroll threshold and removed at the top.
	   Only the vertical padding is touched so the mobile breakpoint keeps its own
	   horizontal padding. */
	.site-header.is-scrolled {
		padding-top: .45rem;
		padding-bottom: .45rem;
	}

	/* The drop shadow stays opt-in (home page only); the compacting above is not. */
	.site-header[data-scroll-shadow].is-scrolled {
		box-shadow: 0 1px 0 #ececec;
	}

	.logo img {
		height: 34px;
		width: auto;
		display: block;
		transition: height .25s ease;
	}

	.site-header.is-scrolled .logo img {
		height: 24px;
	}

	/* The compacting is a size change; honour a reduced-motion preference by
	   snapping between states instead of animating. */
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header.is-fixed,
		.logo img {
			transition: none;
		}
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 1.6rem;
	}

	nav .nav-link {
		color: #2f3437;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.5rem 0.9rem;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	nav .nav-link:hover,
	nav .nav-link:focus-visible {
		background: #b6ae99;
		color: #ffffff;
	}

	nav .nav-link.is-active-page {
		background: #c9a876;
		color: #2f3437;
	}

	/* Brands trigger: a <button> dressed as a nav link. */
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: none;
		background: none;
		font-family: inherit;
		line-height: inherit;
		cursor: pointer;
	}

	.nav-trigger[aria-expanded="true"] {
		background: #b6ae99;
		color: #ffffff;
	}

	.nav-trigger-chevron {
		transition: transform 0.2s ease;
	}

	.nav-trigger[aria-expanded="true"] .nav-trigger-chevron {
		transform: rotate(180deg);
	}

	/* Brands mega menu — full-width band dropping from under the header.
	   Cell rules ported from the brands page's logo row. */
	.brands-menu {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: #fff;
		border-top: 1px solid #ececec;
		border-bottom: 1px solid #2f3437;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
		visibility: hidden;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
	}

	.brands-menu.is-open {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
	}

	.brands-menu__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.brands-menu__cell {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 2rem;
		min-height: 160px;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.brands-menu__cell:hover,
	.brands-menu__cell:focus-visible {
		background: #f7f5f0;
	}

	/* Solid 1px vertical rule between cells. */
	.brands-menu__cell + .brands-menu__cell {
		border-left: 1px solid #2f3437;
	}

	.brands-menu__image {
		width: 100%;
		max-width: 220px;
		height: 120px;
		object-fit: contain;
		display: block;
	}

	/* The Crafters Design & Renovations logo isn't ready yet — styled
	   placeholder text stands in for it until the real artwork exists. */
	.brands-menu__placeholder {
		max-width: 22ch;
		text-align: center;
		font-size: clamp(1.1rem, 2vw, 1.6rem);
		font-weight: 700;
		letter-spacing: .04em;
		text-transform: uppercase;
		line-height: 1.35;
		color: #b6ae99;
	}

	@media (prefers-reduced-motion: reduce) {
		.brands-menu,
		.brands-menu.is-open,
		.nav-trigger-chevron {
			transition: none;
		}
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		z-index: 2;
	}

	.nav-toggle-bar {
		display: block;
		width: 100%;
		height: 2px;
		background: #2f3437;
		border-radius: 2px;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav-backdrop {
		display: none;
	}

	.search-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: none;
		color: #111;
		padding: 0.25rem;
		cursor: pointer;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		color: #808080;
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.lang-link {
		color: #808080;
		text-decoration: none;
		opacity: 0.55;
		transition: opacity 0.2s ease;
	}

	.lang-link:hover {
		opacity: 1;
		text-decoration: underline;
	}

	.lang-link.is-active {
		opacity: 1;
		font-weight: 600;
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.site-header {
			padding: .9rem 1rem;
		}

		.nav-toggle {
			display: flex;
		}

		.nav-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.4);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.35s ease;
			z-index: 0;
		}

		.nav-backdrop.is-open {
			opacity: 1;
			pointer-events: auto;
		}

