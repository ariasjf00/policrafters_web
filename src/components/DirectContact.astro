---
// Shared "direct contact" block: the heading plus the row of link columns that
// closes the homepage. Built to drop into any page as-is.
//
// Must NOT import global.css. index.astro deliberately ships no Tailwind, and
// preflight would land on its hand-written CSS (see CLAUDE.md). The scoped
// <style> below carries everything it needs; `--text` and `--muted` are declared
// by both index.astro and PageLayout.astro, so the vars resolve on either page.
//
// The host page supplies the container: this renders a bare <section>, so place it
// inside whatever `.container`/wrapper that page already uses.

import type { DirectContactPayload } from '../lib/direct-contact';

interface Props {
  lang: 'en' | 'es';
  data: DirectContactPayload;
}

const { data } = Astro.props;

const copy = data.copy ?? {};
const items = (data.items ?? []).map((item) => ({
  href: item.url || '#',
  title: item.title ?? '',
  description: item.description ?? ''
}));
const cta = copy.contact_cta ?? '';
---

<section class="direct-contact">
  <h2 id="contact-heading" class="contact-heading">{copy.contact_heading ?? ''}</h2>

  <div class="contact-grid">
    {items.map((item) => (
      <div class="contact-col">
        <h3 class="contact-col__title">{item.title}</h3>
        <p class="contact-col__description">{item.description}</p>
        <a class="contact-col__btn" href={item.href}>{cta}</a>
      </div>
    ))}
  </div>
</section>

<script>
  // @ts-nocheck
  import { toDevApiUrl } from '../lib/dev-proxy';

  const section = document.querySelector('.direct-contact');

  if (section) {
    const hasPreviewFlag = (value) => {
      const normalized = typeof value === 'string' ? value.trim().toLowerCase() : '';
      return normalized === '1' || normalized === 'true' || normalized === 'yes' || normalized === 'on';
    };

    const getPreviewState = () => {
      const previewInUrl = hasPreviewFlag(new URLSearchParams(window.location.search).get('preview'));
      if (previewInUrl) {
        localStorage.setItem('sitePreview', '1');
        return true;
      }
      const stored = localStorage.getItem('sitePreview');
      return stored === '1' || stored === 'true';
    };

    // The page itself is single-language (route-based i18n — see src/lib/i18n.ts),
    // so a live preview only ever needs to refresh this block in that language.
    const applyRuntimeDirectContact = (payload) => {
      const copy = payload?.copy ?? {};
      const heading = section.querySelector('#contact-heading');
      if (heading && typeof copy.contact_heading === 'string' && copy.contact_heading.trim()) {
        heading.textContent = copy.contact_heading;
      }

      const items = Array.isArray(payload?.items) ? payload.items : [];
      const columns = Array.from(section.querySelectorAll('.contact-col'));
      columns.forEach((column, index) => {
        const item = items[index] ?? {};
        const title = column.querySelector('.contact-col__title');
        const description = column.querySelector('.contact-col__description');
        const button = column.querySelector('.contact-col__btn');

        if (title && typeof item.title === 'string' && item.title.trim()) title.textContent = item.title;
        if (description && typeof item.description === 'string' && item.description.trim()) {
          description.textContent = item.description;
        }
        if (button && typeof copy.contact_cta === 'string' && copy.contact_cta.trim()) {
          button.textContent = copy.contact_cta;
        }
      });
    };

    const runtimeDirectContactApiUrl = toDevApiUrl(import.meta.env.PUBLIC_DIRECT_CONTACT_API_URL || '', 'browser');
    const hydratePreviewDirectContact = async () => {
      if (!getPreviewState() || !runtimeDirectContactApiUrl) return;

      const lang = document.documentElement.lang === 'es' ? 'es' : 'en';

      try {
        const url = new URL(runtimeDirectContactApiUrl);
        url.searchParams.set('locale', lang);
        url.searchParams.set('lang', lang);
        if (import.meta.env.DEV) {
          console.debug('[direct-contact-fetch]', { preview: true, source: 'runtime', endpoint: url.toString(), lang, cache: 'no-store' });
        }
        const response = await fetch(url.toString(), { cache: 'no-store' });
        if (!response.ok) throw new Error(`Direct contact ${lang} status ${response.status}`);
        const payload = await response.json();
        if (payload) applyRuntimeDirectContact(payload);
      } catch (error) {
        if (import.meta.env.DEV) {
          console.warn('[direct-contact-fetch] Preview runtime failed; keeping static content.', error);
        }
      }
    };

    void hydratePreviewDirectContact();
  }
</script>

<style>
  .direct-contact {
    text-align: center;
  }

  .direct-contact * {
    box-sizing: border-box;
  }

  .contact-heading {
    margin: 3.5rem 0 2.5rem;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 700;
    text-transform: none;
    color: #B6AE99;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .contact-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-col__title {
    margin: 0 0 .6rem;
    padding-bottom: .6rem;
    width: 100%;
    border-bottom: 1px solid #2f3437;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text);
  }

  .contact-col__description {
    margin: 1rem 0 1.5rem;
    font-size: .82rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .contact-col__btn {
    display: inline-block;
    margin-top: auto;
    padding: .6rem 1.5rem;
    border: 1px solid #2f3437;
    border-radius: 999px;
    background: #2f3437;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .72rem;
    font-weight: 600;
    transition: background-color .2s ease, color .2s ease;
  }

  .contact-col__btn:hover,
  .contact-col__btn:focus-visible {
    background: #fff;
    color: #2f3437;
  }

  .contact-col__btn:focus-visible {
    outline: 2px solid #2f3437;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
