---
import { Icon } from 'astro-icon/components';
import '../styles/links.css';
import { loadFooterContent } from '../lib/footer-content';
import { type Lang } from '../lib/i18n';
import { getImageSize } from '../lib/images';
import { loadSiteSettings } from '../lib/site-settings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
const footerLinks = await loadFooterContent(lang);
const t = footerLinks.copy;
const siteSettings = await loadSiteSettings(lang);

const isExternalLink = (href: string) => /^https?:\/\//i.test(href);

const contactPhoneDisplay = siteSettings.phone?.trim() ?? '';
const contactPhoneHref = contactPhoneDisplay
  ? `tel:${contactPhoneDisplay.replace(/[^\d+]/g, '')}`
  : '';
const contactEmail = siteSettings.email?.trim() ?? '';
const siteAddress = siteSettings.addresses[0];
const contactAddress = siteAddress
  ? [
      siteAddress.street,
      [siteAddress.city, [siteAddress.region, siteAddress.postal_code].filter(Boolean).join(' ')]
        .filter(Boolean)
        .join(', ')
    ].filter(Boolean).join(', ')
  : '';
const footerLogoSize = getImageSize('/logo_grey.png');
const contactMapHref = contactAddress
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contactAddress)}`
  : '';
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-col footer-col--brand">
      <img class="footer-logo" src="/logo_grey.png" alt="Policrafters logo" width={footerLogoSize.width} height={footerLogoSize.height} loading="lazy" decoding="async" />
      <p id="footer-blurb-1" class="footer-blurb">{t.blurb_1}</p>
      <p id="footer-blurb-2" class="footer-blurb">{t.blurb_2}</p>
    </div>

    <div class="footer-col">
      <ul class="footer-links">
        {footerLinks.navigation_links.map((link) => (
          isExternalLink(link.href) ? (
            <li><a
              href={link.href}
              class="link-underline"
              target="_blank"
              rel="noopener noreferrer"
              data-footer-key={`link-${link.key}`}
            >{link.label}</a></li>
          ) : (
            <li><a href={link.href} class="link-underline" data-footer-key={`link-${link.key}`}>{link.label}</a></li>
          )
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-contact-block">
        <Icon name="mdi:phone-in-talk" class="footer-contact-icon" />
        <div>
          <span id="footer-phone-label" class="footer-contact-label">{t.phone_label}</span>
          {contactPhoneDisplay && <a class="footer-contact-value link-underline" href={contactPhoneHref}>{contactPhoneDisplay}</a>}
        </div>
      </div>
      <span id="footer-residential-label" class="footer-section-label">{t.residential_label}</span>
      <ul class="footer-sublinks">
        {footerLinks.residential_links.map((link) => (
          <li><a href={link.href} class="link-underline" data-footer-key={`residential-link-${link.key}`}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-contact-block">
        <Icon name="mdi:email" class="footer-contact-icon" />
        <div>
          <span id="footer-email-label" class="footer-contact-label">{t.email_label}</span>
          {contactEmail && <a class="footer-contact-value link-underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>}
        </div>
      </div>
      <span id="footer-commercial-label" class="footer-section-label">{t.commercial_label}</span>
      <ul class="footer-sublinks">
        {footerLinks.commercial_links.map((link) => (
          <li><a href={link.href} class="link-underline" data-footer-key={`commercial-link-${link.key}`}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-contact-block">
        <Icon name="mdi:map-marker" class="footer-contact-icon" />
        <div>
          <span id="footer-address-label" class="footer-contact-label">{t.address_label}</span>
          {contactAddress && <a
            class="footer-contact-value link-underline"
            href={contactMapHref}
            target="_blank"
            rel="noopener noreferrer"
          >{contactAddress}</a>}
        </div>
      </div>
      <span id="footer-social-label" class="footer-section-label">{t.social_label}</span>
      <div class="footer-social-row">
        {footerLinks.social_links.map((social) => (
          <a
            href={social.href}
            class="footer-social-icon"
            aria-label={social.label}
            target="_blank"
            rel="noopener"
          >
            {social.icon && <Icon name={social.icon} />}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-copyright">
      <span id="footer-copyright-text">{t.copyright_text}</span> <span data-footer-year>{currentYear}</span>
    </p>
  </div>
</footer>

<script>
  // Language is fixed per build now (route-based i18n — see src/lib/i18n.ts),
  // so this no longer swaps anything; it only keeps the copyright year fresh
  // for a visitor who has the page open across a year boundary.
  const yearEl = document.querySelector('[data-footer-year]');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>

<style>
  .site-footer {
    background: #2f3437;
    color: #b6ae99;
    padding: 4rem 2rem 0;
    font-family: "Arimo", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .site-footer a {
    color: #b6ae99;
    text-decoration: none;
  }

  .site-footer a:focus-visible {
    outline: 2px solid #b6ae99;
    outline-offset: 2px;
  }

  .footer-grid {
    width: min(1200px, 92%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    height: 38px;
    width: auto;
    display: block;
    margin-bottom: 1.25rem;
  }

  .footer-blurb {
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    opacity: 0.9;
  }

  .footer-links,
  .footer-sublinks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.95rem;
  }

  .footer-sublinks {
    margin-top: 0.75rem;
  }

  .footer-sublinks a {
    font-size: 0.85rem;
  }

  .footer-contact-block {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .footer-contact-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }

  .footer-contact-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.3rem;
  }

  .footer-contact-value {
    /* Inline (not block) so the link-underline gradient tracks the text width and,
       on the two-line address, underlines each line rather than the whole box.
       The label above is display:block, so this still starts on its own line. */
    display: inline;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .footer-section-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  .footer-social-row {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .footer-social-icon {
    /* border-box + 36px keeps the outer circle a fixed size, so thickening the
       border on hover grows the ring inward instead of nudging the row. */
    box-sizing: border-box;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #b6ae99;
    border-radius: 50%;
    transition: border-width 0.2s ease;
  }

  .footer-social-icon:hover,
  .footer-social-icon:focus-visible {
    border-width: 3px;
  }

  .footer-social-icon svg {
    width: 16px;
    height: 16px;
  }

  .footer-bottom {
    border-top: 1px solid rgba(182, 174, 153, 0.25);
    padding: 1.25rem 2rem;
    text-align: center;
  }

  .footer-copyright {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-col--brand {
      grid-column: auto;
    }
  }
</style>
