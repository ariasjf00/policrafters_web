# Modo local por defecto: usa los mocks JSON del proyecto
PUBLIC_USE_API=false
PUBLIC_API_URL=
PUBLIC_COLLECTIONS_API_URL=
# Catálogos: fuente compartida por la home y la página de contacto.
PUBLIC_CATALOGS_API_URL=
# Bloque compartido de contacto directo (DirectContactBlock).
PUBLIC_DIRECT_CONTACT_API_URL=
# Contenido de la página de contacto (excepto el formulario).
PUBLIC_CONTACT_PAGE_API_URL=
# Página de detalle de producto.
PUBLIC_PRODUCT_API_URL=

# Endpoint del formulario de contacto. Vacio: el formulario valida pero no envia,
# y le pide al visitante que escriba a info@policrafters.com.
PUBLIC_CONTACT_API_URL=

# Cuando quieras activar el CMS en local:
# PUBLIC_USE_API=true
# PUBLIC_API_URL=http://localhost:8000/api/home/
# PUBLIC_COLLECTIONS_API_URL=http://localhost:8000/api/collections/
# PUBLIC_CATALOGS_API_URL=http://localhost:8000/api/catalogs/
# PUBLIC_DIRECT_CONTACT_API_URL=http://localhost:8000/api/direct-contact/
# PUBLIC_CONTACT_PAGE_API_URL=http://localhost:8000/api/contact-page/
# PUBLIC_CONTACT_API_URL=http://localhost:8000/api/contact/
# PUBLIC_PRODUCT_API_URL=http://localhost:8000/api/product/
